  {%- comment -%} ── Default Region ── {%- endcomment -%}
  <ul class="geo-payments__list is-hidden" data-payment-region="DEFAULT" aria-label="[ACCEPTED PAYMENT METHODS]" aria-hidden="true">
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Visa" aria-label="Visa">
        {%- render 'geo-payment-icons', _render_icon: 'visa' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Mastercard" aria-label="Mastercard">
        {%- render 'geo-payment-icons', _render_icon: 'mastercard' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="PayPal" aria-label="PayPal">
        {%- render 'geo-payment-icons', _render_icon: 'paypal' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Apple Pay" aria-label="Apple Pay">
        {%- render 'geo-payment-icons', _render_icon: 'applepay' -%}
      </span>
    </li>
  </ul>

</div>

{%- comment -%}
