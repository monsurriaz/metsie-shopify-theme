{%- comment -%} ── Styles (rendered once) ── {%- endcomment -%}
{%- unless geo_payment_styles_rendered -%}
  {%- assign geo_payment_styles_rendered = true -%}
  <style>
    /* ── geo-payment-icons ── */
    .geo-payments {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .geo-payments__label {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #1A1A1A;
      opacity: 0.4;
      margin: 0;
    }

    .geo-payments__list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      list-style: none;
      margin: 0;
      padding: 0;
      align-items: center;
    }

    .geo-payments__list.is-hidden {
      display: none;
    }

    .geo-payments__item {
      display: flex;
    }

    .geo-payments__icon {
      display: flex;
      align-items: center;
      opacity: 0.55;
      transition: opacity 200ms ease;
      border-radius: 3px;
      overflow: hidden;
    }

    .geo-payments__icon:hover {
      opacity: 0.85;
    }

    .geo-payments__icon svg {
      display: block;
    }
  </style>
{%- endunless -%}


{%- comment -%} ── JavaScript ── {%- endcomment -%}
{%- unless geo_payment_js_rendered -%}
  {%- assign geo_payment_js_rendered = true -%}
  <script>
    /**
     * geo-payment-icons.js — Metsie Theme
     * Switches visible payment icon list based on detected region.
     */
    (function () {
      'use strict';

      var EU_COUNTRIES = [
        'AT','BE','BG','CY','CZ','DE','DK','EE','ES','FI',
        'FR','GR','HR','HU','IE','IT','LT','LU','LV','MT',
        'NL','PL','PT','RO','SE','SI','SK'
      ];

      function getRegion(countryCode) {
        if (EU_COUNTRIES.indexOf(countryCode) > -1) return 'EU';
        if (countryCode === 'US') return 'US';
        if (countryCode === 'GB') return 'UK';
        return 'DEFAULT';
      }

      function updatePaymentIcons(geoData) {
        document.querySelectorAll('[data-geo-payments]').forEach(function (widget) {
          // If force_region is set, use that instead of geo
          var region = widget.dataset.forceRegion || getRegion(geoData.country_code);

          widget.querySelectorAll('[data-payment-region]').forEach(function (list) {
            var listRegion = list.dataset.paymentRegion;
            if (listRegion === region) {
              list.classList.remove('is-hidden');
              list.removeAttribute('aria-hidden');
            } else {
              list.classList.add('is-hidden');
              list.setAttribute('aria-hidden', 'true');
            }
          });
        });
      }

      document.addEventListener('geo:detected', function (e) {
        if (e.detail && e.detail.country_code) updatePaymentIcons(e.detail);
      });

      // Check session on load
      (function () {
        var cached = sessionStorage.getItem('metsie_geo_data');
        if (!cached) return;
        try {
          var geo = JSON.parse(cached);
          if (geo && geo.country_code) updatePaymentIcons(geo);
        } catch(e) {}
      })();

    })();
  </script>
{%- endunless -%}
