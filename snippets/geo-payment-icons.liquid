{%- comment -%}
  ================================================================================
  geo-payment-icons.liquid — Metsie Theme
  ================================================================================
  Regional payment method icons. Renders SVG icons relevant to visitor's region.

  USAGE:
    Footer / product page / cart:
      {% render 'geo-payment-icons' %}

    Force a specific region (e.g. for testing):
      {% render 'geo-payment-icons', force_region: 'EU' %}

  PARAMETERS:
    force_region (string) — 'EU' | 'US' | 'UK' | 'DEFAULT' (overrides geo detection)

  REGIONS & METHODS:
    EU      → Visa, Mastercard, PayPal, Klarna, iDEAL, Bancontact, SOFORT
    US      → Visa, Mastercard, AmEx, PayPal, Apple Pay, Google Pay
    UK      → Visa, Mastercard, PayPal, Apple Pay, Klarna
    DEFAULT → Visa, Mastercard, PayPal, Apple Pay

  DESIGN:
    - SVG icons inline, monochromatic / muted to match luxury aesthetic
    - Small "[SECURE PAYMENT]" label above
    - Subtle grayscale treatment on load; full color on hover (optional)
    - JS layer swaps to geo-detected region
  ================================================================================
{%- endcomment -%}

{%- liquid
  assign force_region = force_region | default: ''
-%}

<div
  class="geo-payments"
  data-geo-payments
  {% if force_region != '' %}data-force-region="{{ force_region }}"{% endif %}
  aria-label="[ACCEPTED PAYMENT METHODS]"
>

  <p class="geo-payments__label" aria-hidden="true">
    {%- render 'svg-icons', icon: 'shield', size: 12 -%}
    [SECURE PAYMENT]
  </p>

  {%- comment -%}
    Each region group is rendered hidden; JS shows the correct one.
    Default (EU) is shown without JS.
  {%- endcomment -%}

  {%- comment -%} ── EU Region ── {%- endcomment -%}
  <ul class="geo-payments__list" data-payment-region="EU" aria-label="[EU PAYMENT METHODS]">
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Visa" aria-label="Visa">
        {%- render 'geo-payment-icons', _render_icon: 'visa' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Mastercard" aria-label="Mastercard">
        {%- render 'geo-payment-icons', _render_icon: 'mastercard' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="PayPal" aria-label="PayPal">
        {%- render 'geo-payment-icons', _render_icon: 'paypal' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Klarna" aria-label="Klarna">
        {%- render 'geo-payment-icons', _render_icon: 'klarna' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="iDEAL" aria-label="iDEAL">
        {%- render 'geo-payment-icons', _render_icon: 'ideal' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Bancontact" aria-label="Bancontact">
        {%- render 'geo-payment-icons', _render_icon: 'bancontact' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="SOFORT" aria-label="SOFORT">
        {%- render 'geo-payment-icons', _render_icon: 'sofort' -%}
      </span>
    </li>
  </ul>

  {%- comment -%} ── US Region ── {%- endcomment -%}
  <ul class="geo-payments__list is-hidden" data-payment-region="US" aria-label="[US PAYMENT METHODS]" aria-hidden="true">
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Visa" aria-label="Visa">
        {%- render 'geo-payment-icons', _render_icon: 'visa' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="Mastercard" aria-label="Mastercard">
        {%- render 'geo-payment-icons', _render_icon: 'mastercard' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="American Express" aria-label="American Express">
        {%- render 'geo-payment-icons', _render_icon: 'amex' -%}
      </span>
    </li>
    <li class="geo-payments__item">
      <span class="geo-payments__icon" title="PayPal" aria-label="PayPal">
        {%- render 'geo-payment-icons', _render_icon: 'paypal' -%}
      </span>
    </li>
    <li class="geo-payments__item">
