{%- comment -%}
  ================================================================================
  svg-icons.liquid — Metsie Theme
  ================================================================================
  SVG icon collection. All icons are inline, accessible, and size-controlled.

  USAGE:
    {% render 'svg-icons', icon: 'cart' %}
    {% render 'svg-icons', icon: 'chevron-down', size: 16, class: 'my-class' %}
    {% render 'svg-icons', icon: 'search', size: 20, color: '#2D4A6A' %}

  PARAMETERS:
    icon   (string, required) — icon name (see list below)
    size   (integer)          — width & height in px. Default: 20
    class  (string)           — additional CSS class(es)
    color  (string)           — fill/stroke color. Default: 'currentColor'

  AVAILABLE ICONS:
    Navigation:   cart, search, menu, close, chevron-down, chevron-up,
                  chevron-left, chevron-right
    Actions:      plus, minus, heart, share, return
    Commerce:     truck, shield, star
    Social:       instagram, facebook, pinterest, twitter

  NOTES:
    - All icons use viewBox="0 0 24 24" (line icon style, 1.5px stroke)
    - stroke="currentColor" by default so they inherit CSS color
    - Social icons use fill (no stroke)
    - aria-hidden="true" by default; caller should add aria-label if icon
      is the sole accessible label for an interactive element
  ================================================================================
{%- endcomment -%}

{%- liquid
  assign icon_size  = size  | default: 20
  assign icon_class = class | default: ''
  assign icon_color = color | default: 'currentColor'
-%}

{%- case icon -%}

  {%- comment -%} ── CART ── {%- endcomment -%}
  {%- when 'cart' -%}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="{{ icon_size }}"
      height="{{ icon_size }}"
      fill="none"
      stroke="{{ icon_color }}"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      {% if icon_class != '' %}class="{{ icon_class }}"{% endif %}
    >
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 0 1-8 0"/>
    </svg>

