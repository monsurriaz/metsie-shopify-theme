{%- comment -%}
  ================================================================================
  meta-tags.liquid — Metsie Theme
  ================================================================================
  Complete SEO meta tag suite. Place in <head> in theme.liquid.

  USAGE:
    In theme.liquid <head>:
      {% render 'meta-tags' %}

  COVERS:
    - <title> with shop name suffix
    - meta description
    - canonical URL
    - Open Graph (og:*) for all template types
    - Twitter Card
    - JSON-LD structured data:
        Organization, WebSite (SearchAction), Product, BreadcrumbList
    - hreflang alternate links for multi-language
    - Preconnect resource hints (Google Fonts, Shopify CDN)

  NOTES:
    - Uses Shopify's native template objects (product, collection, article, page)
    - og:image falls back to shop logo if no page-specific image
    - JSON-LD Product only rendered on product template
    - hreflang rendered only if multiple languages available
  ================================================================================
{%- endcomment -%}

{%- liquid
  # ── Resolve page title ──────────────────────────────────────────────────────
  if template.name == 'product'
    assign page_title = product.title | append: ' — ' | append: shop.name
  elsif template.name == 'collection'
    if collection.title != blank
      assign page_title = collection.title | append: ' — ' | append: shop.name
    else
      assign page_title = shop.name
    endif
  elsif template.name == 'article'
    assign page_title = article.title | append: ' — ' | append: blog.title | append: ' — ' | append: shop.name
  elsif template.name == 'blog'
    assign page_title = blog.title | append: ' — ' | append: shop.name
  elsif template.name == 'page'
    assign page_title = page.title | append: ' — ' | append: shop.name
  elsif template.name == 'index'
    assign page_title = shop.name | append: ' — ' | append: shop.description | truncate: 60, ''
  elsif template.name == 'cart'
    assign page_title = '[YOUR CART] — ' | append: shop.name
  elsif template.name == 'search'
    assign page_title = '[SEARCH] — ' | append: shop.name
  elsif template.name == '404'
    assign page_title = '[PAGE NOT FOUND] — ' | append: shop.name
  else
    if page_title != blank
      assign page_title = page_title | append: ' — ' | append: shop.name
    else
      assign page_title = shop.name
    endif
  endif

  # ── Resolve meta description ─────────────────────────────────────────────────
  if template.name == 'product'
    assign meta_description = product.description | strip_html | strip | truncate: 160
    if meta_description == blank
      assign meta_description = product.title | append: '. ' | append: shop.description
    endif
  elsif template.name == 'collection'
    assign meta_description = collection.description | strip_html | strip | truncate: 160
    if meta_description == blank
      assign meta_description = collection.title | append: ' — ' | append: shop.description
    endif
  elsif template.name == 'article'
    assign meta_description = article.excerpt_or_content | strip_html | strip | truncate: 160
  elsif template.name == 'page'
    assign meta_description = page.content | strip_html | strip | truncate: 160
  else
    assign meta_description = shop.description | truncate: 160
  endif

  # ── Resolve canonical URL ────────────────────────────────────────────────────
  assign canonical_url = canonical_url | default: request.origin | append: request.path

  # ── Resolve OG image ─────────────────────────────────────────────────────────
  assign og_image = ''
  assign og_image_width  = 1200
  assign og_image_height = 630

  if template.name == 'product' and product.featured_image
    assign og_image = product.featured_image | image_url: width: 1200
    assign og_image_width  = 1200
    assign og_image_height = 1200
  elsif template.name == 'collection' and collection.image
    assign og_image = collection.image | image_url: width: 1200
  elsif template.name == 'article' and article.image
    assign og_image = article.image | image_url: width: 1200
  elsif settings.og_image_default
    assign og_image = settings.og_image_default | image_url: width: 1200
  endif

  # ── OG type ──────────────────────────────────────────────────────────────────
  if template.name == 'product'
    assign og_type = 'product'
  elsif template.name == 'article'
    assign og_type = 'article'
  else
    assign og_type = 'website'
  endif
-%}

{%- comment -%} ── Title ── {%- endcomment -%}
<title>{{ page_title }}</title>

{%- comment -%} ── Meta description ── {%- endcomment -%}
{%- if meta_description != blank -%}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif -%}

{%- comment -%} ── Canonical ── {%- endcomment -%}
<link rel="canonical" href="{{ canonical_url }}">

{%- comment -%} ── Robots ── {%- endcomment -%}
{%- unless template.name == 'search' or template.name == 'cart' or template.name == '404' -%}
  <meta name="robots" content="index, follow">
{%- else -%}
  <meta name="robots" content="noindex, follow">
{%- endunless -%}

{%- comment -%} ── Open Graph ── {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type"      content="{{ og_type }}">
<meta property="og:title"     content="{{ page_title | escape }}">
{%- if meta_description != blank -%}
  <meta property="og:description" content="{{ meta_description | escape }}">
{%- endif -%}
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image != blank -%}
  <meta property="og:image"       content="https:{{ og_image }}">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height"content="{{ og_image_height }}">
  <meta property="og:image:alt"   content="{{ page_title | escape }}">
{%- endif -%}

{%- comment -%} Product-specific OG tags {%- endcomment -%}
{%- if template.name == 'product' -%}
  <meta property="product:price:amount"   content="{{ product.price | money_without_currency }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  {%- if product.available -%}
    <meta property="product:availability" content="in stock">
  {%- else -%}
    <meta property="product:availability" content="out of stock">
  {%- endif -%}
{%- endif -%}

{%- comment -%} Article OG tags {%- endcomment -%}
{%- if template.name == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  <meta property="article:author"         content="{{ article.author }}">
  {%- for tag in article.tags -%}
    <meta property="article:tag" content="{{ tag }}">
  {%- endfor -%}
{%- endif -%}

{%- comment -%} ── Twitter Card ── {%- endcomment -%}
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content="{{ page_title | escape }}">
{%- if meta_description != blank -%}
  <meta name="twitter:description" content="{{ meta_description | escape }}">
{%- endif -%}
{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image }}">
  <meta name="twitter:image:alt" content="{{ page_title | escape }}">
{%- endif -%}
{%- if settings.twitter_handle != blank -%}
  <meta name="twitter:site"      content="@{{ settings.twitter_handle | remove: '@' }}">
  <meta name="twitter:creator"   content="@{{ settings.twitter_handle | remove: '@' }}">
{%- endif -%}

{%- comment -%} ── hreflang — multi-language alternate links ── {%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  {%- for language in localization.available_languages -%}
    <link
      rel="alternate"
      hreflang="{{ language.iso_code }}"
      href="{{ request.origin }}/{{ language.iso_code }}{{ request.path }}"
    >
  {%- endfor -%}
  {%- comment -%} x-default points to primary language {%- endcomment -%}
  <link
    rel="alternate"
    hreflang="x-default"
    href="{{ request.origin }}{{ request.path }}"
  >
{%- endif -%}

{%- comment -%} ── Resource Hints ── {%- endcomment -%}
{%- if settings.use_google_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{%- endif -%}

{%- comment -%} Shopify CDN {%- endcomment -%}
<link rel="preconnect" href="https://cdn.shopify.com">

{%- comment -%} Analytics (add your own) {%- endcomment -%}
{%- comment -%}
  <link rel="preconnect" href="https://www.google-analytics.com">
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
{%- endcomment -%}

{%- comment -%} ── JSON-LD Structured Data ── {%- endcomment -%}

{%- comment -%} 1. Organization (every page) {%- endcomment -%}
{%- capture organization_jsonld -%}
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }},
  "logo": {
    "@type": "ImageObject",
    "url": "{{ settings.logo | image_url: width: 600 | prepend: 'https:' }}"
  }
  {%- if shop.email != blank -%}
  ,"email": {{ shop.email | json }}
  {%- endif -%}
  {%- if settings.social_instagram != blank -%}
  ,"sameAs": [
    {{ settings.social_instagram | json }}
    {%- if settings.social_facebook != blank -%},{{ settings.social_facebook | json }}{%- endif -%}
    {%- if settings.social_pinterest != blank -%},{{ settings.social_pinterest | json }}{%- endif -%}
    {%- if settings.social_twitter != blank -%},{{ settings.social_twitter | json }}{%- endif -%}
  ]
  {%- endif -%}
}
{%- endcapture -%}
<script type="application/ld+json">{{ organization_jsonld }}</script>

{%- comment -%} 2. WebSite with SearchAction (every page) {%- endcomment -%}
{%- capture website_jsonld -%}
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      
      {%- assign search_placeholder = '{search_term_string}' -%}
      {%- assign search_url = request.origin | append: "/search?q=" | append: search_placeholder -%}

      "urlTemplate": {{ search_url | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
{%- endcapture -%}
<script type="application/ld+json">{{ website_jsonld }}</script>

{%- comment -%} 3. Product JSON-LD (product template only) {%- endcomment -%}
{%- if template.name == 'product' -%}
  {%- liquid
    assign product_url = request.origin | append: product.url
    assign product_image_url = ''
    if product.featured_image
      assign product_image_url = product.featured_image | image_url: width: 1200 | prepend: 'https:'
    endif
  -%}
  {%- capture product_jsonld -%}
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ product_url | json }},
  "description": {{ product.description | strip_html | strip | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  }
  {%- if product_image_url != blank -%}
  ,"image": {{ product_image_url | json }}
  {%- endif -%}
  {%- if product.variants.size > 0 -%}
  ,"offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "name": {{ variant.title | json }},
      "sku": {{ variant.sku | json }},
      "price": "{{ variant.price | money_without_currency | remove: ',' }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- endif -%}
  {%- if product.metafields.reviews.rating.value != blank -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ product.metafields.reviews.rating.value }},
    "reviewCount": {{ product.metafields.reviews.rating_count.value | default: 0 }}
  }
  {%- endif -%}
}
  {%- endcapture -%}
  <script type="application/ld+json">{{ product_jsonld }}</script>
{%- endif -%}

{%- comment -%} 4. BreadcrumbList JSON-LD ── rendered by breadcrumbs.liquid {%- endcomment -%}
{%- comment -%}
  BreadcrumbList is output inline inside breadcrumbs.liquid via a <script> tag
  placed adjacent to the <nav> for contextual relevance. No need to repeat here.
{%- endcomment -%}

{%- comment -%} 5. Article JSON-LD {%- endcomment -%}
{%- if template.name == 'article' -%}
  {%- liquid
    assign article_image_url = ''
    if article.image
      assign article_image_url = article.image | image_url: width: 1200 | prepend: 'https:'
    endif
  -%}
  {%- capture article_jsonld -%}
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "dateModified": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
  }
  {%- if article_image_url != blank -%}
  ,"image": {{ article_image_url | json }}
  {%- endif -%}
  {%- if meta_description != blank -%}
  ,"description": {{ meta_description | json }}
  {%- endif -%}
}
  {%- endcapture -%}
  <script type="application/ld+json">{{ article_jsonld }}</script>
{%- endif -%}
