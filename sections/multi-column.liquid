
<style>
  .multi-column {
    padding: var(--section-py) 0;
    background-color: var(--color-white);
    --columns: {{ section.settings.columns }};
  }
  .multi-column.pb-0 {
    padding-bottom: 0;
  }

  /* Header */
  .multi-column__header {
    margin-bottom: var(--gap-lg);
  }

  .multi-column__label {
    color: var(--color-near-black);
  }

  .multi-column__heading {
    color: var(--color-black);
  }

  /* Grid layout */
  .multi-column__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--gap-sm);
  }

  /* Item */
  .multi-column__item {
    display: flex;
    flex-direction: column;
  }

  /* Item with inside content positioning */
  .multi-column__item--inside {
    position: relative;
  }

  /* Image wrapper */
  .multi-column__image-wrapper {
    overflow: hidden;
  }

  .multi-column__image {
    display: block;
  }

  .multi-column__image-placeholder-wrapper {
    background-color: var(--color-cream);
    background-color: #D9D9D9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .multi-column__placeholder {
    width: 90%;
    height: 90%;
    color: #ccc;
    display: block;
  }

  /* Content */
  .multi-column__content {
    flex: 1;
    margin-top: var(--gap-sm);
  }

  .multi-column__item-label {
    color: var(--color-near-black);
    margin-bottom: var(--space-2);
  }

  .multi-column__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--lh-tight);
    color: var(--color-black);
    margin-bottom: var(--space-3);
  }

  .multi-column__description {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-light);
    line-height: var(--lh-relaxed);
    color: var(--color-near-black);
  }

  /* Inside content overlay */
  .multi-column__item--inside .multi-column__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-6);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
    color: var(--color-white);
    margin-top: 0px;
  }

  .multi-column__item--inside .multi-column__item-label {
    color: var(--color-white);
  }

  .multi-column__item--inside .multi-column__title {
    color: var(--color-white);
  }

  .multi-column__item--inside .multi-column__description {
    color: var(--color-white);
  }

  /* ── Tablet (max 2 columns) ── */
  @media (max-width: 1024px) {
    .multi-column {
      --columns: 2;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .multi-column {
      padding: var(--section-padding-sm) 0;
    }

    .multi-column__header {
      margin-bottom: var(--gap);
    }

    .multi-column__title {
      font-size: var(--text-lg);
    }

    /* Default: regular grid (1 column) */
    .multi-column {
      --columns: 1;
    }

    /* Slider mode: ~1.5 columns visible */
    .multi-column[data-mobile-slider="true"] .multi-column__inner {
      padding-left: var(--space-4);
      padding-right: 0;
    }

    .multi-column[data-mobile-slider="true"] .multi-column__grid {
      grid-template-columns: unset;
      grid-auto-flow: column;
      grid-auto-columns: 70vw;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: var(--space-4);
      padding-right: var(--space-4);
    }

    .multi-column[data-mobile-slider="true"] .multi-column__grid::-webkit-scrollbar {
      display: none;
    }

    .multi-column[data-mobile-slider="true"] .multi-column__item {
      scroll-snap-align: start;
    }
  }
</style>

<div 
  class="multi-column{% if section.settings.remove_padding_bottom %} pb-0{% endif %}" 
  data-section-id="{{ section.id }}" 
  data-mobile-slider="{{ section.settings.enable_mobile_slider }}"
  >
  <div class="multi-column__inner container">

    {%- comment -%} Section header (hidden if no label or heading) {%- endcomment -%}
    {% if section.settings.label != blank or section.settings.heading != blank %}
      <div class="multi-column__header">
        {% if section.settings.label != blank %}
          <p class="multi-column__label text-body-primary">{{ section.settings.label | upcase }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="multi-column__heading text-heading-primary{% if section.settings.heading_width == 'fixed' %} section-heading__fixed--width{% endif %}">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Grid layout with blocks {%- endcomment -%}
    <div class="multi-column__grid" {% unless request.design_mode %}data-reveal-group{% endunless %}>
      {% for block in section.blocks %}
        <div class="multi-column__item {% if block.settings.content_position == 'inside' %}multi-column__item--inside{% endif %}" {{ block.shopify_attributes }}>
          {%- comment -%} Image (full width if enabled) {%- endcomment -%}
          {% if block.settings.enable_image %}
            {% if block.settings.image != blank %}
              <div class="multi-column__image-wrapper {{ section.settings.media_ratio }}">
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  alt="{{ block.settings.image_alt | default: 'Multi column image' }}"
                  loading="lazy"
                  class="multi-column__image media-fit"
                  width="auto"
                  height="auto"
                >
              </div>
            {% else %}
              <div class="multi-column__image-wrapper multi-column__image-placeholder-wrapper {{ section.settings.media_ratio }}">
                {%- assign svg_num = forloop.index | modulo: 4 -%}
                {%- if svg_num == 0 -%}
                  {%- assign svg_num = 4 -%}
                {%- endif -%}
                {{ 'collection-' | append: svg_num | placeholder_svg_tag: 'multi-column__placeholder' }}
              </div>
            {% endif %}
          {% endif %}

          {%- comment -%} Text content (label, title, description) {%- endcomment -%}
          {% if block.settings.label != blank or block.settings.title != blank or block.settings.description != blank %}
            <div class="multi-column__content" style="text-align: {{ block.settings.text_alignment | default: 'left' }};">
              {% if block.settings.label != blank %}
                <p class="multi-column__item-label text-body-primary">{{ block.settings.label | upcase }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="multi-column__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="multi-column__description">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Multi Column",
  "tag": "section",
  "class": "multi-column-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "select",
      "id": "heading_width",
      "label": "Heading width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "fixed",
          "label": "Fixed width (560px)"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "aspect-slightly-tall",
          "label": "Portrait (4:4.25)"
        },
        {
          "value": "aspect-ultrawide",
          "label": "Landscape (16:7.67)"
        }
      ],
      "default": "aspect-slightly-tall"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "remove_padding_bottom",
      "label": "Remove bottom padding",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 2
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "label": "Enable horizontal slider on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_image",
          "label": "Enable image",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (optional)"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "value": "outside",
              "label": "Outside image (below)"
            },
            {
              "value": "inside",
              "label": "Inside image (bottom-left)"
            }
          ],
          "default": "outside"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi Column",
      "settings": {
        "label": "FEATURES",
        "heading": "Explore our features",
        "columns": 2
      },
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Feature One",
            "description": "Description for the first feature"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Feature Two",
            "description": "Description for the second feature"
          }
        }
      ]
    }
  ]
}
{% endschema %}
