


{% schema %}
  {
    "name": "Password",
    "class": "section-wrapper section-password",
    "settings": [
      {
        "type": "image_picker",
        "id": "password_page_image",
        "label": "Password Page Image",
        "info": "Recommended size: 1200 x 800px. This image will be cropped to fit different screen sizes."
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Password Page Heading",
        "default": "This store is password protected"
      },
      {
        "type": "textarea",
        "id": "subheading",
        "label": "Password Page Message",
        "default": "Enter the password to access the store."
      },
      {
        "type": "text",
        "id": "password_placeholder",
        "label": "Password Input Placeholder",
        "default": "Enter password"
      },
      {
        "type": "text",
        "id": "submit_button_text",
        "label": "Submit Button Text",
        "default": "Submit"
      }
    ]
  }
{% endschema %}
