{%- comment -%} BACKGROUND — video → image → color fallback {%- endcomment -%}
{%- if section.settings.video != blank -%}
  <div class="password-page__bg">
    {{- section.settings.video | video_tag:
      autoplay: true,
      loop: true,
      muted: true,
      controls: false,
      class: 'password-page__video',
      preload: 'auto'
    -}}
  </div>
{%- elsif section.settings.image != blank -%}
  <div class="password-page__bg">
    {{- section.settings.image
      | image_url: width: 3840
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'password-page__bg-image',
        widths: '750, 1100, 1500, 1780, 2000, 3840',
        sizes: '100vw'
    -}}
  </div>
{%- endif -%}

{%- comment -%} Overlay — darkens video/image for text legibility {%- endcomment -%}
{%- if section.settings.overlay_opacity > 0 -%}
  <div class="password-page__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
{%- endif -%}

<div class="password-page password-page--{{ section.settings.page_mode }}">
  <div class="password-page__brand">
    {%- if section.settings.logo != blank -%}
      <img
        src="{{ section.settings.logo | image_url: width: 240 }}"
        alt="{{ shop.name }}"
        class="password-page__logo"
        width="{{ section.settings.logo_width }}"
        height="auto"
        loading="eager"
      >
    {%- else -%}
      <span class="password-page__logo-text">{{ shop.name }}</span>
    {%- endif -%}
  </div>

  <div class="password-page__content">
    {%- if section.settings.page_mode == 'password' -%}
      {%- if section.settings.password_heading != blank -%}
        <h1 class="password-page__heading">{{ section.settings.password_heading }}</h1>
      {%- endif -%}

      {%- if section.settings.password_text != blank -%}
        <p class="password-page__message">{{ section.settings.password_text }}</p>
      {%- endif -%}

      {% form 'storefront_password', class: 'password-page__form' %}
        {%- if form.errors -%}
          <div class="password-page__errors" role="alert">
            <ul>
              {%- for error in form.errors -%}
                <li>{{ error | capitalize }}: {{ form.errors.messages[error] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="password-page__input-group">
          <input
            type="password"
            id="Password"
            name="password"
            class="password-page__input"
            placeholder="{{ section.settings.password_placeholder }}"
            autocomplete="current-password"
            required
          >
          <button type="submit" class="password-page__submit">
            {{ section.settings.submit_button_text }}
          </button>
        </div>
      {% endform %}
    {%- else -%}
      {%- if section.settings.newsletter_heading != blank -%}
        <h1 class="password-page__heading">{{ section.settings.newsletter_heading }}</h1>
      {%- endif -%}

      {%- if section.settings.newsletter_text != blank -%}
        <p class="password-page__message">{{ section.settings.newsletter_text }}</p>
      {%- endif -%}

      {% form 'customer', class: 'password-page__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">

        {%- if form.errors -%}
          <div class="password-page__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <p class="password-page__success" role="status">
            {{ section.settings.newsletter_success_text }}
          </p>
        {%- else -%}
          <div class="password-page__input-group">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail"
              class="password-page__input"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="password-page__submit">
              {{ section.settings.newsletter_button_text }}
            </button>
          </div>
        {%- endif -%}
      {% endform %}
      
      {%- if section.settings.email_text != blank -%}
        <p class="password-page__message mt-4">{{ section.settings.email_text }}</p>
      {%- endif -%}

    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_footer -%}
  <footer class="password-page__footer">
    <p>{{ section.settings.footer_text }}</p>
  </footer>
{%- endif -%}

{%- comment -%} Dynamic styles driven by section settings (color/opacity) {%- endcomment -%}
{%- assign box_alpha = section.settings.box_opacity | divided_by: 100.0 -%}
<style>
  .password-page__bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .password-page__video,
  .password-page__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .password-page__overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: var(--color-near-black, #000);
  }

  .section-password .password-page__content {
    background: {{ section.settings.box_color | color_modify: 'alpha', box_alpha }};
  }
</style>

{% schema %}
{
  "name": "Password",
  "class": "section-wrapper section-password",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 240,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (takes priority over image)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (fallback when no video)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (darkens video/image)",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "box_color",
      "label": "Text box color",
      "default": "#2E4356"
    },
    {
      "type": "range",
      "id": "box_opacity",
      "label": "Text box opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "header",
      "content": "Page variation"
    },
    {
      "type": "select",
      "id": "page_mode",
      "label": "Show",
      "options": [
        {
          "value": "password",
          "label": "Password access"
        },
        {
          "value": "newsletter",
          "label": "Coming soon / newsletter"
        }
      ],
      "default": "password"
    },
    {
      "type": "header",
      "content": "Password access"
    },
    {
      "type": "text",
      "id": "password_heading",
      "label": "Heading",
      "default": "[PASSWORD PROTECTED]"
    },
    {
      "type": "textarea",
      "id": "password_text",
      "label": "Message",
      "default": "[THIS STORE IS CURRENTLY PASSWORD PROTECTED. PLEASE ENTER THE PASSWORD TO CONTINUE.]"
    },
    {
      "type": "text",
      "id": "password_placeholder",
      "label": "Password input placeholder",
      "default": "[ENTER PASSWORD]"
    },
    {
      "type": "text",
      "id": "submit_button_text",
      "label": "Submit button text",
      "default": "[ENTER]"
    },
    {
      "type": "header",
      "content": "Coming soon / newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "[BE FIRST TO KNOW]"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Text",
      "default": "[LEAVE YOUR EMAIL AND WE WILL NOTIFY YOU WHEN WE LAUNCH.]",
      "info": "Use <br> where you need line break, use two <br> e.g <br></br> if you need one line break and one line gap."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email input placeholder",
      "default": "[YOUR EMAIL ADDRESS]"
    },
    {
      "type": "textarea",
      "id": "email_text",
      "label": "Email supportive Text",
      "default": "We write rarely, and only if matters",
      "info": "Use <br> where you need line break, use two <br> e.g <br></br> if you need one line break and one line gap."
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "Button text",
      "default": "[NOTIFY ME]"
    },
    {
      "type": "text",
      "id": "newsletter_success_text",
      "label": "Success message",
      "default": "[THANK YOU. WE WILL BE IN TOUCH.]"
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show footer",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text"
    }
  ]
}
{% endschema %}
