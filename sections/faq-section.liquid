{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
{%- assign first_faq_block = faq_blocks | first -%}

<div class="faq-section non-banner__hero-section" data-section-id="{{ section.id }}">
  <div class="faq-section__inner container container--narrow">
    <div class="faq-section__content">

      {%- comment -%} Page header {%- endcomment -%}
      <div class="faq-section__header non-banner__section-header" {% unless request.design_mode %}data-reveal-group{% endunless %}>
        <h1 class="faq-section__heading text-heading-primary">
          {{ section.settings.heading }}
        </h1>
      </div>

      {%- comment -%} FAQ accordions {%- endcomment -%}
      {% if faq_blocks.size > 0 %}
        <div class="faq-list" x-data='{ openItem: {{ first_faq_block.id | json }} }' {% unless request.design_mode %}data-reveal-group{% endunless %}>
          {% for block in faq_blocks %}
            <div
              class="faq-item{% if forloop.first %} is-open{% endif %}"
              :class='{ "is-open": openItem === {{ block.id | json }} }'
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="faq-item__trigger"
                id="faq-trigger-{{ block.id }}"
                aria-controls="faq-body-{{ block.id }}"
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                :aria-expanded='openItem === {{ block.id | json }}'
                @click='openItem = openItem === {{ block.id | json }} ? null : {{ block.id | json }}'
              >
                <span class="faq-item__question text-body-primary">
                  {{ block.settings.question }}
                </span>
                <span class="faq-item__icon" aria-hidden="true"></span>
              </button>

              <div
                class="faq-item__body"
                id="faq-body-{{ block.id }}"
                role="region"
                aria-labelledby="faq-trigger-{{ block.id }}"
              >
                <div class="faq-item__answer text-body-light">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} Contact CTA {%- endcomment -%}
      {% if section.settings.show_contact_cta %}
        <div class="faq-contact-cta">
          <p class="faq-contact-cta__text">{{ section.settings.contact_cta_text }}</p>
          <a href="{{ section.settings.contact_link }}" class="view-all-link">
            GET IN TOUCH
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  .non-banner__hero-section {
    padding: var(--space-25) 0 var(--space-40);
  }

  .faq-section__header {
    margin-bottom: var(--space-12);
  }

  .faq-list {
    border-top: var(--border-width) solid rgba(31, 31, 30, 0.31);
  }

  .faq-item {
    border-bottom: var(--border-width) solid rgba(31, 31, 30, 0.31);
  }

  .faq-item__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    width: 100%;
    padding: var(--space-10) 0;
    background: none;
    border: none;
    color: var(--color-near-black);
    cursor: pointer;
    text-align: left;
    transition: padding var(--transition-base);
  }

  .faq-item__question {
    flex: 1;
    display: inline-block;
  }

  .faq-item.is-open .faq-item__trigger {
    padding-bottom: var(--space-2-5);
  }

  .faq-item__icon {
    position: relative;
    flex-shrink: 0;
    width: 0.9375rem;
    height: 0.9375rem;
    color: var(--color-near-black);
    opacity: 0.85;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .faq-item__icon::before {
    width: 0.9375rem;
    height: var(--border-width);
  }

  .faq-item__icon::after {
    width: calc(var(--border-width) / 2);
    height: 0.9375rem;
  }

  .faq-item.is-open .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq-item__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-base);
  }

  .faq-item.is-open .faq-item__body {
    grid-template-rows: 1fr;
  }

  .faq-item__answer {
    overflow: hidden;
    padding-bottom: 0;
    color: var(--color-near-black);
    transition: padding-bottom var(--transition-base);
  }

  .faq-item__answer > *:first-child { margin-top: 0; }
  .faq-item__answer p { margin: 0 0 var(--space-3); }
  .faq-item__answer p:last-child { margin-bottom: 0; }
  .faq-item__answer ul,
  .faq-item__answer ol {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-5);
  }
  .faq-item__answer li { margin-bottom: var(--space-2); }

  .faq-item.is-open .faq-item__answer {
    padding-bottom: var(--space-10);
  }

  .faq-contact-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-14);
    padding: var(--space-8);
    background-color: var(--color-cream);
  }

  .faq-contact-cta__text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-light);
    color: var(--color-near-black);
    margin: 0;
    font-style: italic;
    line-height: var(--lh-normal);
  }

  @media (max-width: 767px) {
    .non-banner__hero-section {
      padding: var(--space-25) 0 var(--space-20);
    }

    .faq-section__header {
      margin-bottom: var(--space-10);
    }
      
    .faq-item__trigger {
      padding: var(--space-4) 0 var(--space-5) 0;
    }

    .faq-item__icon {
      width: 0.5375rem;
      height: 0.5375rem;
      opacity: 0.85;
    }

    .faq-item__icon::before {
      width: 0.5375rem;
      height: var(--border-width);
    }

    .faq-item__icon::after {
      height: 0.5375rem;
    }

    .faq-item__answer > *:first-child { margin-top: 0; }
    .faq-item__answer p { margin: 0 0 var(--space-3); }
    .faq-item__answer p:last-child { margin-bottom: 0; }
    .faq-item__answer ul,
    .faq-item__answer ol {
      padding-left: var(--space-3);
    }
    .faq-item.is-open .faq-item__answer {
      padding-bottom: var(--space-5);
    }

    .faq-contact-cta {
      align-items: flex-start;
      flex-direction: column;
      margin-top: var(--space-10);
      padding: var(--space-6);
    }

    .faq-contact-cta__text {
      font-size: var(--text-lg);
    }
  }
</style>

{% schema %}
{
  "name": "FAQ Section",
  "tag": "section",
  "class": "faq-outer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact CTA",
      "default": false
    },
    {
      "type": "text",
      "id": "contact_cta_text",
      "label": "Contact CTA text",
      "default": "STILL HAVE QUESTIONS? GET IN TOUCH"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact page link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "FAQ QUESTION GOES HERE?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>FAQ ANSWER GOES HERE</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Section",
      "settings": {
        "heading": "FAQ",
        "show_contact_cta": false,
        "contact_cta_text": "STILL HAVE QUESTIONS? GET IN TOUCH"
      },
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "[HOW DO I PLACE AN ORDER?]",
            "answer": "<p>DESCRIBE THE ORDERING PROCESS</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "HOW LONG DOES SHIPPING TAKE?",
            "answer": "<p>PROVIDE SHIPPING TIMEFRAMES</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "WHAT IS YOUR RETURN POLICY?",
            "answer": "<p>DESCRIBE RETURN POLICY</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "HOW DO I CARE FOR MY METSIE MAT?",
            "answer": "<p>PROVIDE CARE INSTRUCTIONS</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
