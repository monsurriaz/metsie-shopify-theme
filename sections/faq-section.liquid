<section class="faq-section" data-section-id="{{ section.id }}">
  <div class="faq-section__inner">

    {%- comment -%} Page header {%- endcomment -%}
    <header class="faq-section__header">
      <p class="section-label">FAQ</p>
      <h1 class="faq-section__heading">
        {{ section.settings.heading | default: '[FREQUENTLY ASKED QUESTIONS]' }}
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="faq-section__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    {%- comment -%} Category filter (if blocks have categories) {%- endcomment -%}
    {% assign categories = '' %}
    {% for block in section.blocks %}
      {% if block.type == 'faq' and block.settings.category != blank %}
        {% unless categories contains block.settings.category %}
          {% assign categories = categories | append: block.settings.category | append: '|' %}
        {% endunless %}
      {% endif %}
    {% endfor %}

    {% if categories != '' %}
      {% assign category_list = categories | split: '|' %}
      {% if category_list.size > 1 %}
        <div
          class="faq-categories"
          x-data="{ activeCategory: 'ALL' }"
        >
          <button
            class="faq-category-btn"
            :class="{ 'is-active': activeCategory === 'ALL' }"
            @click="activeCategory = 'ALL'"
          >ALL</button>
          {% for cat in category_list %}
            {% if cat != '' %}
              <button
                class="faq-category-btn"
                :class="{ 'is-active': activeCategory === '{{ cat }}' }"
                @click="activeCategory = '{{ cat }}'"
              >{{ cat | upcase }}</button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    {%- comment -%} FAQ accordions {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="faq-list" x-data="{ activeCategory: 'ALL' }">
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <div
              class="faq-item"
              x-data="{ open: false }"
              {% if block.settings.category != blank %}
                x-show="activeCategory === 'ALL' || activeCategory === '{{ block.settings.category }}'"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <button
                class="faq-item__trigger"
                @click="open = !open"
                :aria-expanded="open"
                :id="'faq-btn-{{ block.id }}'"
                :aria-controls="'faq-body-{{ block.id }}'"
              >
                <span class="faq-item__question">
                  {{ block.settings.question | default: '[FAQ QUESTION GOES HERE?]' }}
                </span>
                <svg
                  class="faq-item__icon"
                  :class="{ 'is-open': open }"
                  width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"
                >
                  <path d="M4 7.5l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div
                class="faq-item__body"
                :id="'faq-body-{{ block.id }}'"
                x-show="open"
                x-transition:enter="faq-enter"
                x-transition:enter-start="faq-enter-start"
                x-transition:enter-end="faq-enter-end"
                x-transition:leave="faq-leave"
                x-transition:leave-start="faq-leave-start"
                x-transition:leave-end="faq-leave-end"
                role="region"
                :aria-labelledby="'faq-btn-{{ block.id }}'"
              >
                <div class="faq-item__answer">
                  {{ block.settings.answer | default: '[FAQ ANSWER GOES HERE — PROVIDE A CLEAR AND HELPFUL RESPONSE]' }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      {%- comment -%} Placeholder FAQs {%- endcomment -%}
      <div class="faq-list">
        {% for i in (1..4) %}
          <div class="faq-item" x-data="{ open: false }">
            <button class="faq-item__trigger" @click="open = !open" :aria-expanded="open">
              <span class="faq-item__question">[FAQ QUESTION {{ i }} GOES HERE?]</span>
              <svg class="faq-item__icon" :class="{ 'is-open': open }" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 7.5l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="faq-item__body" x-show="open" x-transition>
              <div class="faq-item__answer">
                <p>[FAQ ANSWER {{ i }} GOES HERE — PROVIDE A CLEAR AND HELPFUL RESPONSE TO THIS QUESTION]</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {%- comment -%} Contact CTA {%- endcomment -%}
    {% if section.settings.show_contact_cta %}
      <div class="faq-contact-cta">
        <p class="faq-contact-cta__text">{{ section.settings.contact_cta_text | default: 'STILL HAVE QUESTIONS?' }}</p>
        <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="view-all-link">
          GET IN TOUCH
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .faq-section {
    padding: 80px 0 96px;
  }

  .faq-section__inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .faq-section__header {
    text-align: center;
    margin-bottom: 56px;
  }

  .faq-section__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 300;
    color: #1A1A1A;
    margin: 12px 0 0;
    letter-spacing: -0.01em;
  }

  .faq-section__subheading {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #888;
    margin: 16px 0 0;
    line-height: 1.6;
  }

  /* Category pills */
  .faq-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
    justify-content: center;
  }

  .faq-category-btn {
    background: none;
    border: 1px solid #E8E8E4;
    padding: 8px 18px;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: #888;
    cursor: pointer;
    transition: all 0.2s ease;
    text-transform: uppercase;
  }

  .faq-category-btn.is-active,
  .faq-category-btn:hover {
    background-color: #2D4A6A;
    border-color: #2D4A6A;
    color: #F5F0E8;
  }

  /* FAQ list */
  .faq-list {
    border-top: 1px solid #E8E8E4;
  }

  .faq-item {
    border-bottom: 1px solid #E8E8E4;
  }

  .faq-item__trigger {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    padding: 24px 0;
    text-align: left;
  }

  .faq-item__question {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 400;
    color: #1A1A1A;
    line-height: 1.3;
    flex: 1;
  }

  .faq-item__icon {
    flex-shrink: 0;
    color: #888;
    margin-top: 4px;
    transition: transform 0.25s ease;
  }

  .faq-item__icon.is-open {
    transform: rotate(180deg);
  }

  .faq-item__body {
    padding-bottom: 24px;
  }

  .faq-item__answer {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.8;
    color: #555;
  }

  .faq-item__answer p { margin: 0 0 12px; }
  .faq-item__answer p:last-child { margin-bottom: 0; }
  .faq-item__answer ul, .faq-item__answer ol {
    margin: 0 0 12px;
    padding-left: 20px;
  }
  .faq-item__answer li { margin-bottom: 6px; }

  /* Transitions */
  .faq-enter { transition: opacity 0.25s ease, transform 0.25s ease; }
  .faq-enter-start { opacity: 0; transform: translateY(-6px); }
  .faq-enter-end { opacity: 1; transform: translateY(0); }
  .faq-leave { transition: opacity 0.2s ease; }
  .faq-leave-start { opacity: 1; }
  .faq-leave-end { opacity: 0; }

  /* Contact CTA */
  .faq-contact-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding: 32px;
    background-color: #F5F0E8;
  }

  .faq-contact-cta__text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 24px;
    font-weight: 300;
    color: #1A1A1A;
    margin: 0;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .faq-section__inner { padding: 0 24px; }
  }

  @media (max-width: 640px) {
    .faq-contact-cta { flex-direction: column; align-items: flex-start; }
    .faq-item__question { font-size: 18px; }
  }

  @media (max-width: 480px) {
    .faq-section { padding: 56px 0; }
    .faq-section__inner { padding: 0 16px; }
  }
</style>

{% schema %}
{
  "name": "FAQ Section",
  "tag": "section",
  "class": "faq-outer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "placeholder": "Find answers to the most common questions"
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "Show contact CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_cta_text",
      "label": "Contact CTA text",
      "default": "STILL HAVE QUESTIONS?"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact page link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category (optional, for filtering)",
          "placeholder": "SHIPPING"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "[FAQ QUESTION GOES HERE?]"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>[FAQ ANSWER GOES HERE]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Section",
      "settings": {
        "heading": "FREQUENTLY ASKED QUESTIONS",
        "show_contact_cta": true,
        "contact_cta_text": "STILL HAVE QUESTIONS?"
      },
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "category": "ORDERING",
            "question": "[HOW DO I PLACE AN ORDER?]",
            "answer": "<p>[DESCRIBE THE ORDERING PROCESS]</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "category": "SHIPPING",
            "question": "[HOW LONG DOES SHIPPING TAKE?]",
            "answer": "<p>[PROVIDE SHIPPING TIMEFRAMES]</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "category": "RETURNS",
            "question": "[WHAT IS YOUR RETURN POLICY?]",
            "answer": "<p>[DESCRIBE RETURN POLICY]</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "category": "PRODUCTS",
            "question": "[HOW DO I CARE FOR MY METSIE MAT?]",
            "answer": "<p>[PROVIDE CARE INSTRUCTIONS]</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
