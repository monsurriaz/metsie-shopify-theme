{% assign featured_collection = collections[section.settings.collection] %}

<section class="featured-collection" data-section-id="{{ section.id }}">
  <div class="featured-collection__inner">

    {%- comment -%} Section header {%- endcomment -%}
    <div class="section-header">
      {% if section.settings.section_label != blank %}
        <p class="text-body-primary">{{ section.settings.section_label }}</p>
      {% endif %}
      <h2 class="section-heading text-heading-primary">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% elsif featured_collection != blank %}
          {{ featured_collection.title }}
        {% else %}
          [COLLECTION TITLE HERE]
        {% endif %}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="section-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {%- comment -%} Product grid {%- endcomment -%}
    {% if featured_collection != blank and featured_collection.products.size > 0 %}
      <ul class="featured-collection__grid" role="list" data-reveal-group>
        {% assign products_to_show = section.settings.products_to_show | default: 3 %}
        {% for product in featured_collection.products limit: products_to_show %}
          <li class="product-card-wrapper">
            {% render 'product-card', product: product, aspect_ratio: 'portrait', lazy_index: forloop.index %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {%- comment -%} Placeholder cards when no collection is set {%- endcomment -%}
      <ul class="featured-collection__grid" role="list" data-reveal-group>
        {% for i in (1..3) %}
          <li class="product-card-wrapper">
            <article class="product-card product-card--placeholder">
              <a href="#" class="product-card__image-link" tabindex="-1">
                <div class="product-card__image-container">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__placeholder-svg' }}
                </div>
              </a>
              <div class="product-card__info">
                <div class="product-card__meta">
                  <span class="product-card__type">GEOMETRIC — BRAND COLOR</span>
                </div>
                <h3 class="product-card__title text-body-primary">
                  <a href="#">[PRODUCT NAME HERE]</a>
                </h3>
                <p class="product-card__price">145€</p>
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {%- comment -%} View all link {%- endcomment -%}
    {% if section.settings.show_view_all %}
      <div class="featured-collection__view-all">
        <a
          href="{{ featured_collection.url | default: '/collections/all' }}"
          class="view-all-link"
        >
          {{ section.settings.view_all_text | default: 'VIEW ALL' | upcase }}
          <span class="view-all-link__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Section layout — section-header, section-heading, section-label, view-all-link are global (theme.css) */
  .featured-collection {
    padding: var(--section-py) 0;
    background-color: var(--color-white);
  }

  .featured-collection__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--space-10);
  }

  /* Product grid */
  .featured-collection__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-sm);
  }

  .product-card__placeholder-svg {
    background-color: var(--color-cream);
    margin-bottom: 20px;
  }

  /* View all */
  .featured-collection__view-all {
    margin-top: var(--space-14);
  }

  /* ── Tablet ── */
  @media (max-width: 1024px) {
    .featured-collection { padding: var(--section-padding) 0; }
    .featured-collection__inner { padding: 0 var(--space-6); }
  }

  /* ── Mobile — horizontal scroll, peek at next card ── */
  @media (max-width: 640px) {
    .featured-collection { padding: var(--section-padding-sm) 0; }
    .featured-collection__inner {
      padding-left: var(--space-4);
      padding-right: 0;
    }
    .featured-collection__grid {
      grid-template-columns: unset;
      grid-auto-flow: column;
      grid-auto-columns: 70vw;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-right: var(--space-4);
    }
    .featured-collection__grid::-webkit-scrollbar { display: none; }
    .product-card-wrapper { scroll-snap-align: start; }
    .featured-collection__view-all { padding-right: var(--space-4); }
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (small caps)",
      "default": "THE COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use collection title)",
      "default": "A curated selection of essential designs in timeless tones"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional, italic — leave blank to hide)"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to feature"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of products to show",
      "default": 3
    },
    {
      "type": "header",
      "content": "View All"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "VIEW ALL"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "settings": {
        "section_label": "THE COLLECTION",
        "heading": "A curated selection of essential designs in timeless tones",
        "products_to_show": 3,
        "show_view_all": true,
        "view_all_text": "VIEW ALL"
      }
    }
  ]
}
{% endschema %}
