{% assign featured_collection = collections[section.settings.collection] %}

<section class="featured-collection" data-section-id="{{ section.id }}">
  <div class="featured-collection__inner">

    {%- comment -%} Section header {%- endcomment -%}
    <header class="section-header">
      {% if section.settings.section_label != blank %}
        <p class="section-label">{{ section.settings.section_label | upcase }}</p>
      {% endif %}
      <h2 class="section-heading">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% elsif featured_collection != blank %}
          {{ featured_collection.title }}
        {% else %}
          [COLLECTION TITLE HERE]
        {% endif %}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="section-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    {%- comment -%} Product grid {%- endcomment -%}
    {% if featured_collection != blank and featured_collection.products.size > 0 %}
      <ul class="featured-collection__grid" role="list">
        {% assign products_to_show = section.settings.products_to_show | default: 3 %}
        {% for product in featured_collection.products limit: products_to_show %}
          <li class="product-card-wrapper">
            {% render 'product-card', product: product %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {%- comment -%} Placeholder cards when no collection is set {%- endcomment -%}
      <ul class="featured-collection__grid" role="list">
        {% for i in (1..3) %}
          <li class="product-card-wrapper">
            <article class="product-card product-card--placeholder">
              <a href="#" class="product-card__image-link" tabindex="-1">
                <div class="product-card__image-container">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__placeholder-svg' }}
                </div>
              </a>
              <div class="product-card__info">
                <div class="product-card__meta">
                  <span class="product-card__type">GEOMETRIC — BRAND COLOR</span>
                </div>
                <h3 class="product-card__title">
                  <a href="#">[PRODUCT NAME HERE]</a>
                </h3>
                <p class="product-card__price">145€</p>
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {%- comment -%} View all link {%- endcomment -%}
    {% if section.settings.show_view_all %}
      <div class="featured-collection__view-all">
        <a
          href="{{ featured_collection.url | default: '/collections/all' }}"
          class="view-all-link"
        >
          {{ section.settings.view_all_text | default: 'VIEW ALL' | upcase }}
          <span class="view-all-link__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .featured-collection {
    padding: 96px 0;
    background-color: #FFFFFF;
  }

  .featured-collection__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Section header */
  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #2D4A6A;
    margin-bottom: 16px;
    font-variant: small-caps;
  }

  .section-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    color: #1A1A1A;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .section-subheading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 300;
    font-style: italic;
    color: #555;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  /* Product grid */
  .featured-collection__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  /* Product card */
  .product-card {
    position: relative;
  }

  .product-card__image-link {
    display: block;
    text-decoration: none;
    overflow: hidden;
  }

  .product-card__image-container {
    position: relative;
    aspect-ratio: 3 / 4;
    background-color: #F5F0E8;
    overflow: hidden;
  }

  .product-card__image,
  .product-card__secondary-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    position: absolute;
    inset: 0;
  }

  .product-card__secondary-image {
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.5s ease;
  }

  .product-card__image-link:hover .product-card__image {
    transform: scale(1.04);
  }

  .product-card__image-link:hover .product-card__secondary-image {
    opacity: 1;
  }

  .product-card__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: #ddd;
  }

  .product-card__info {
    padding: 20px 0 0;
  }

  .product-card__meta {
    margin-bottom: 6px;
  }

  .product-card__type {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
  }

  .product-card__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    font-weight: 400;
    margin: 0 0 8px;
    line-height: 1.25;
  }

  .product-card__title a {
    color: #1A1A1A;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .product-card__title a:hover {
    color: #2D4A6A;
  }

  .product-card__price {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #1A1A1A;
    letter-spacing: 0.02em;
  }

  /* View all link */
  .featured-collection__view-all {
    text-align: center;
    margin-top: 56px;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: #2D4A6A;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: gap 0.2s ease;
  }

  .view-all-link:hover {
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .featured-collection {
      padding: 72px 0;
    }
    .featured-collection__inner {
      padding: 0 24px;
    }
  }

  @media (max-width: 768px) {
    .featured-collection__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .featured-collection {
      padding: 56px 0;
    }
    .featured-collection__inner {
      padding: 0 16px;
    }
    .section-header {
      margin-bottom: 40px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (small caps)",
      "default": "THE COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use collection title)",
      "placeholder": "[COLLECTION TITLE HERE]"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)",
      "default": "A curated selection of essential designs in timeless tones"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to feature"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of products to show",
      "default": 3
    },
    {
      "type": "header",
      "content": "View All"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "VIEW ALL"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "settings": {
        "section_label": "THE COLLECTION",
        "subheading": "A curated selection of essential designs in timeless tones",
        "products_to_show": 3,
        "show_view_all": true,
        "view_all_text": "VIEW ALL"
      }
    }
  ]
}
{% endschema %}
