<section
  class="hero-banner"
  data-section-id="{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }};"
>

  {%- comment -%} BACKGROUND — video → image → bg_color fallback {%- endcomment -%}
  {%- if section.settings.video != blank -%}
    <div class="hero-banner__bg">
      {{- section.settings.video | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        class: 'hero-banner__video',
        preload: 'auto'
      -}}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="hero-banner__bg">
      {{- section.settings.image
        | image_url: width: 3840
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero-banner__bg-image',
          widths: '750, 1100, 1500, 1780, 2000, 3840',
          sizes: '100vw'
      -}}
    </div>
  {%- endif -%}

  {%- comment -%} Overlay — darkens image/video for text legibility {%- endcomment -%}
  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="hero-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  {%- comment -%} Monogram icon {%- endcomment -%}
  <div class="hero-banner__monogram" aria-hidden="true" style="top: {{ section.settings.monogram_top }}%;">
    {%- if section.settings.monogram_image != blank -%}
      <img
        src="{{ section.settings.monogram_image | image_url: width: 200 }}"
        alt=""
        class="hero-monogram-img"
        loading="eager"
      >
    {%- else -%}
      <img
        src="{{ 'monogram-white.svg' | asset_url }}"
        alt=""
        class="hero-monogram-img"
        loading="eager"
      >
    {%- endif -%}
  </div>

  {%- comment -%} Heading content {%- endcomment -%}
  <div class="hero-banner__content">
    <h1 class="hero-banner__heading">
      {{ section.settings.heading | default: 'Metsie creates mats designed to stay in the space' }}
    </h1>
  </div>

  {%- comment -%} Scroll indicator {%- endcomment -%}
  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero-banner__scroll-indicator" aria-hidden="true">
      <span class="scroll-indicator__line"></span>
    </div>
  {%- endif -%}

</section>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    {% if section.settings.full_viewport %}
      min-height: 100vh;
      min-height: 100dvh;
    {% else %}
      min-height: 600px;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: #F5F0E8;
  }

  /* Background media container */
  .hero-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-banner__bg-image,
  .hero-banner__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Overlay */
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: #000;
  }

  /* Monogram — centered, top position from inline style */
  .hero-banner__monogram {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .hero-monogram-img {
    width: {{ section.settings.monogram_size }}px;
    height: auto;
    display: block;
  }

  /* Heading content */
  .hero-banner__content {
    position: absolute;
    bottom: 22%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1000px;
    z-index: 2;
    color: #F5F0E8;
    padding: 0 var(--container-px);
    text-align: center;
  }

  .hero-banner__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
    color: inherit;
  }

  /* Scroll indicator */
  .hero-banner__scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .scroll-indicator__line {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(245,240,232,0.6), rgba(245,240,232,0));
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50%       { opacity: 1;   transform: scaleY(1.15); }
  }

  @media (max-width: 1024px) {
    .hero-monogram-img {
      width: {{ section.settings.monogram_size | times: 0.75 | round }}px;
    }
    .hero-banner__content {
      bottom: 22%;
      padding: 0 32px;
    }
  }

  @media (max-width: 640px) {
    .hero-monogram-img {
      width: {{ section.settings.monogram_size | times: 0.6 | round }}px;
    }
    .hero-banner__content {
      bottom: unset;
      padding: 0 20px;
    }
  }
</style>

<script>
  {% if settings.header_style == 'transparent' %}
  (function () {
    function init() { document.body.classList.add('hero-page'); }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  {% endif %}
</script>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Metsie creates mats designed to stay in the space"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (takes priority over image)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback background color",
      "default": "#2E4356"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity (darkens image/video for text legibility)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Monogram"
    },
    {
      "type": "image_picker",
      "id": "monogram_image",
      "label": "Monogram icon (uses built-in if blank)"
    },
    {
      "type": "range",
      "id": "monogram_size",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Monogram size (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "monogram_top",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "%",
      "label": "Monogram vertical position",
      "default": 20
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_viewport",
      "label": "Full viewport height",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "settings": {
        "heading": "Metsie creates mats designed to stay in the space",
        "bg_color": "#2E4356",
        "overlay_opacity": 0,
        "monogram_size": 80,
        "monogram_top": 20,
        "full_viewport": true,
        "show_scroll_indicator": true
      }
    }
  ]
}
{% endschema %}
