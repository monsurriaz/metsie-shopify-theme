<section
  class="hero-banner"
  data-section-id="{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }};"
>

  {%- comment -%} Metsie "M" monogram — upper-left per Figma {%- endcomment -%}
  <div class="hero-banner__monogram" aria-hidden="true">
    <img
      src="{{ 'monogram-white.svg' | asset_url }}"
      alt=""
      class="hero-monogram-img"
      width="420"
      height="auto"
      loading="eager"
    >
  </div>

  <div class="hero-banner__content">
    <h1 class="hero-banner__heading">
      {{ section.settings.heading | default: 'Metsie creates mats designed to stay in the space' }}
    </h1>
  </div>

  {%- comment -%} Scroll indicator {%- endcomment -%}
  {% if section.settings.show_scroll_indicator %}
    <div class="hero-banner__scroll-indicator" aria-hidden="true">
      <span class="scroll-indicator__line"></span>
    </div>
  {% endif %}

</section>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    {% if section.settings.full_viewport %}
      min-height: 100vh;
      min-height: 100dvh;
    {% else %}
      min-height: 600px;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: -72px; /* Pull under fixed header */
    color: #F5F0E8;
  }

  .hero-banner__monogram {
    position: absolute;
    left: 80px;
    top: 120px;
    z-index: 1;
  }

  .hero-monogram-img {
    width: 80px;
    height: auto;
    opacity: 1;
  }

  .hero-banner__content {
    position: absolute;
    bottom: 100px;
    left: 0;
    right: 0;
    z-index: 2;
    color: #F5F0E8;
    padding: 0 40px;
    text-align: center;
  }

  .hero-banner__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
    color: inherit;
  }

  .hero-banner__scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .scroll-indicator__line {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(245,240,232,0.6), rgba(245,240,232,0));
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.15); }
  }

  @media (max-width: 1024px) {
    .hero-banner {
      margin-top: -64px;
    }
    .hero-banner__monogram {
      left: 40px;
      top: 100px;
    }
    .hero-monogram-img {
      width: 60px;
    }
    .hero-banner__content {
      bottom: 80px;
      padding: 0 32px;
    }
  }

  @media (max-width: 640px) {
    .hero-banner__monogram {
      top: 80px;
      left: 24px;
    }
    .hero-monogram-img {
      width: 50px;
    }
    .hero-banner__content {
      bottom: 60px;
      padding: 0 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Metsie creates mats designed to stay in the space"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_viewport",
      "label": "Full viewport height",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2E4356"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "settings": {
        "heading": "Metsie creates mats designed to stay in the space",
        "bg_color": "#2E4356",
        "full_viewport": true,
        "show_scroll_indicator": true
      }
    }
  ]
}
{% endschema %}
