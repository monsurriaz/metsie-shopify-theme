<footer class="site-footer{% if section.settings.footer_style == 'premium' %} site-footer--premium{% endif %}" data-section-id="{{ section.id }}">
  <div class="site-footer__inner">

    {%- comment -%} 4-column grid {%- endcomment -%}
    <div class="container">
      <div class="site-footer__grid" data-reveal-group>
  
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_link' -%}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              <h3 class="site-footer__col-heading text-body-primary">{{ block.settings.heading }}</h3>
              {%- if block.settings.menu != blank -%}
                <ul class="site-footer__links">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li><a href="{{ link.url }}" class="site-footer__link text-body-light{% if link.active %} is-active{% endif %}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- elsif block.type == 'newsletter' -%}
            <div class="site-footer__col site-footer__col--newsletter" {{ block.shopify_attributes }}>
              <h3 class="site-footer__col-heading text-body-primary">{{ block.settings.newsletter_heading }}</h3>
              <p class="site-footer__newsletter-subtitle text-body-light">
                {{ block.settings.newsletter_subtitle | default: 'Subscribe to get a 10% discount on your first order!' }}
              </p>
              {% form 'customer', id: 'footer-newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="site-footer__newsletter-form">
                  <input
                    type="email"
                    name="contact[email]"
                    class="site-footer__newsletter-input"
                    placeholder="{{ block.settings.newsletter_placeholder | default: 'Enter your email' }}"
                    required
                    aria-label="Email address for newsletter"
                  >
                  <button type="submit" class="site-footer__newsletter-btn">
                    {{ block.settings.newsletter_button | default: 'SUBMIT' | upcase }}
                  </button>
                </div>
              {% endform %}
            </div>
          {%- endif -%}
        {%- endfor -%}
  
      </div>
    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    {%- assign footer_logo = section.settings.footer_logo -%}
    {%- assign has_logo = false -%}
    {% if footer_logo != blank %}
      {%- assign has_logo = true -%}
    {% endif %}
    {%- assign has_social = false -%}
    {% if section.settings.instagram_url != blank or section.settings.pinterest_url != blank %}
      {%- assign has_social = true -%}
    {% endif %}

    {%- if has_logo and has_social -%}
      {%- assign bottom_layout = 'full' -%}
    {%- elsif has_logo -%}
      {%- assign bottom_layout = 'logo-only' -%}
    {%- elsif has_social -%}
      {%- assign bottom_layout = 'social-only' -%}
    {%- else -%}
      {%- assign bottom_layout = 'copyright-only' -%}
    {%- endif -%}

    <hr class="primary-hr">
    <div class="container">
      <div class="site-footer__bottom site-footer__bottom--{{ bottom_layout }}">
  
        {%- if has_logo -%}
          <div class="site-footer__bottom-logo">
            <img src="{{ section.settings.footer_logo | image_url: width: section.settings.footer_logo_width }}"
                 alt="{{ shop.name }}"
                 width="{{ section.settings.footer_logo_width }}"
                 height="auto"
                 loading="lazy">
          </div>
        {%- endif -%}
  
        {%- if has_social -%}
          <div class="site-footer__social">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" class="social-link" aria-label="Follow on Instagram" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.pinterest_url != blank %}
              <a href="{{ section.settings.pinterest_url }}" class="social-link" aria-label="Follow on Pinterest" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.03-2.83.18-.78 1.22-5.17 1.22-5.17s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.58 2.26-.87 3.51-.25 1.05.52 1.9 1.54 1.9 1.85 0 3.09-2.38 3.09-5.2 0-2.14-1.44-3.74-4.03-3.74-2.94 0-4.76 2.2-4.76 4.65 0 .84.24 1.44.62 1.9.17.2.19.28.13.51-.04.17-.14.57-.18.73-.06.23-.24.31-.43.23-1.2-.49-1.76-1.81-1.76-3.3 0-2.44 2.06-5.37 6.16-5.37 3.31 0 5.49 2.4 5.49 4.98 0 3.41-1.89 5.96-4.66 5.96-.93 0-1.81-.5-2.11-1.07l-.58 2.2c-.21.8-.77 1.8-1.15 2.41.87.27 1.79.42 2.75.42 5.52 0 10-4.48 10-10S17.52 2 12 2z" fill="currentColor"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {%- endif -%}
  
        <p class="site-footer__copyright text-body-light">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        </p>
  
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-deep-navy);
    color: var(--color-white);
    padding: 80px 0 60px;
  }

  /* Premium variant */
  .site-footer--premium {
    padding: 100px 0 80px;
  }

  .site-footer--premium .site-footer__grid {
    gap: 64px;
  }

  .site-footer--premium .site-footer__col-heading {
    margin-bottom: 24px;
  }

  .site-footer--premium .site-footer__newsletter-subtitle {
    opacity: 1;
    font-size: 14px;
  }

  .site-footer--premium .site-footer__newsletter-input {
    font-size: 14px;
    padding: 8px 0;
  }

  .site-footer--premium .site-footer__newsletter-btn {
    font-size: 13px;
    font-weight: 500;
    padding: 8px 0 8px 16px;
  }

  .site-footer--premium .site-footer__bottom {
    padding: 60px 0 10px;
    gap: 24px;
  }

  /* Premium hover enhancements */
  .site-footer--premium .site-footer__link::after {
    height: 1px;
    background-color: currentColor;
    transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .site-footer--premium .site-footer__link:hover {
    opacity: 1;
  }

  .site-footer--premium .site-footer__link:hover::after {
    width: 100%;
  }

  .site-footer--premium .site-footer__newsletter-btn {
    transition: all 0.3s ease;
  }

  .site-footer--premium .site-footer__newsletter-btn:hover {
    opacity: 1;
    transform: scale(1.05);
  }

  .site-footer--premium .social-link {
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .site-footer--premium .social-link:hover {
    transform: scale(1.2);
    opacity: 0.9;
  }

  .site-footer--premium .site-footer__newsletter-form:focus-within {
    border-bottom-color: rgba(245, 240, 232, 0.9);
    border-bottom-width: 1px;
  }

  .site-footer--premium .primary-hr {
    opacity: 0.4;
  }

  /* Grid */
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.5fr;
    gap: 48px;
    padding-bottom: 60px;
    /* border-bottom: 1px solid rgba(245,240,232,0.12); */
  }

  /* Column headings */
  .site-footer__col-heading {
    margin: 0 0 16px;
  }

  /* Nav links */
  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    /* gap: 10px; */
  }

  .site-footer__link {
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s ease;
    position: relative;
  }

  .site-footer__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.2s ease;
  }

  .site-footer__link:hover {
    color: inherit;
    opacity: 1;
  }

  .site-footer__link.is-active {
    font-weight: 500;
    color: inherit;
    opacity: 1;
  }

  .site-footer__link:hover::after {
    width: 100%;
  }

  /* Newsletter column */
  .site-footer__newsletter-subtitle {
    opacity: 0.80;
    margin: 0 0 20px;
  }

  .site-footer__newsletter-form {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0;
    border-bottom: 0.5px solid var(--color-white);
  }

  .site-footer__newsletter-input {
    background: transparent;
    border: none;
    color: var(--color-white);
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.02em;
    line-height: var(--lh-relaxed);
    padding: 3px 0;
    outline: none;
    flex: 1;
    box-sizing: border-box;
  }

  .site-footer__newsletter-input::placeholder {
    color: inherit;
    opacity: 0.4;
  }

  .site-footer__newsletter-input:focus {
    border-color: transparent;
    outline: none;
  }

  .site-footer__newsletter-btn {
    background-color: transparent;
    color: var(--color-white);
    border: none;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 300;
    text-transform: uppercase;
    line-height: var(--lh-relaxed);
    padding: 5px 0 5px 16px;
    cursor: pointer;
    transition: opacity 0.2s ease;
    width: auto;
    white-space: nowrap;
    opacity: 0.8;
  }

  .site-footer__newsletter-btn:hover {
    background-color: transparent;
    opacity: 1;
  }

  /* Bottom bar */
  .primary-hr {
    margin-block: 30px;
    opacity: 0.25;
  }
  .site-footer__bottom {
    display: grid;
    align-items: flex-end;
    gap: 16px;
    padding: 40px 0 10px;
  }

  /* All three: logo | social | copyright */
  .site-footer__bottom--full {
    grid-template-columns: 1fr auto 1fr;
  }
  .site-footer__bottom--full .site-footer__bottom-logo { justify-self: start; }
  .site-footer__bottom--full .site-footer__social { justify-self: center; }
  .site-footer__bottom--full .site-footer__copyright { justify-self: end; }

  /* Logo + copyright (no social) */
  .site-footer__bottom--logo-only {
    grid-template-columns: auto 1fr;
  }
  .site-footer__bottom--logo-only .site-footer__copyright { justify-self: end; }

  /* Social + copyright (no logo) */
  .site-footer__bottom--social-only {
    grid-template-columns: auto 1fr;
  }
  .site-footer__bottom--social-only .site-footer__copyright { justify-self: end; }

  /* Copyright only */
  .site-footer__bottom--copyright-only {
    grid-template-columns: 1fr;
  }
  .site-footer__bottom--copyright-only .site-footer__copyright { justify-self: center; text-align: center; }

  .site-footer__bottom-logo {
    display: flex;
    align-items: center;
  }
  .site-footer__bottom-logo img {
    height: auto;
  }

  .site-footer__copyright {
    font-size: 12px;
    margin: 0;
  }

  /* Social */
  .site-footer__social {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .social-link {
    color: inherit;
    opacity: 1;
    transition: transform 0.2s ease;
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    color: inherit;
    transform: scale(1.1);
  }

  @media (max-width: 1024px) {
    /* .site-footer__inner { padding: 0 24px; } */
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .site-footer__col--newsletter {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .site-footer { padding: 60px 0 0; }
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding-bottom: 48px;
    }
    .site-footer--premium .site-footer__grid {
      gap: 40px 48px;
    }
    .site-footer__col--newsletter {
      grid-column: 1 / -1;
    }
    .site-footer--premium .site-footer__col-heading {
      margin-bottom: 20px;
    }
    .site-footer--premium .site-footer__newsletter-subtitle {
      opacity: 0.75;
      font-size: 12px;
    }
    .site-footer__newsletter-form {
      border-color: rgba(255, 255, 255, 0.7);
    }
    .site-footer--premium .site-footer__newsletter-form:focus-within {
      border-color: rgba(245, 240, 232, 0.9);
    }
    .site-footer--premium .site-footer__newsletter-input {
      font-size: 12px;
    }
    .site-footer--premium .site-footer__newsletter-btn {
      font-size: 11px;
    }
    .site-footer--premium .primary-hr {
      margin-block: 0px;
    }
    .site-footer__bottom--full,
    .site-footer__bottom--logo-only,
    .site-footer__bottom--social-only {
      grid-template-columns: 1fr;
    }
    .site-footer--premium .site-footer__bottom {
      padding: 16px 0 16px;
    }
    .site-footer__bottom-logo,
    .site-footer__social,
    .site-footer__copyright {
      justify-self: start;
    }

    .site-footer__bottom--full .site-footer__bottom-logo ,
    .site-footer__bottom--full .site-footer__social {
      display: none;
    }

    .site-footer__bottom--full .site-footer__copyright {
      text-align: center;
      width: 100%;
    }
  }

  @media (max-width: 400px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "site-footer-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "footer_style",
      "label": "Footer Style",
      "default": "standard",
      "options": [
        {
          "label": "Standard",
          "value": "standard"
        },
        {
          "label": "Premium",
          "value": "premium"
        }
      ]
    },
    {
      "type": "header",
      "content": "Footer Logo"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "footer_logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    }
  ],
  "blocks": [
    {
      "type": "menu_link",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Customer Care"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "main-menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "newsletter_heading",
          "label": "Newsletter Heading",
          "default": "SIGN UP TO OUR NEWSLETTER"
        },
        {
          "type": "text",
          "id": "newsletter_subtitle",
          "label": "Newsletter subtitle",
          "default": "Subscribe to get a 10% discount on your first order!"
        },
        {
          "type": "text",
          "id": "newsletter_placeholder",
          "label": "Email input placeholder",
          "default": "Enter your email "
        },
        {
          "type": "text",
          "id": "newsletter_button",
          "label": "Submit button text",
          "default": "SUBMIT"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu_link",
          "settings": {
            "heading": "CUSTOMER CARE",
            "menu": "customer-care"
          }
        },
        {
          "type": "menu_link",
          "settings": {
            "heading": "CARD & CHECKOUT",
            "menu": "card-checkout"
          }
        },
        {
          "type": "menu_link",
          "settings": {
            "heading": "LEGAL",
            "menu": "legal"
          }
        },
        {
          "type": "newsletter"
        }
      ],
      "settings": {
        "instagram_url": "",
        "pinterest_url": ""
      }
    }
  ]
}
{% endschema %}
