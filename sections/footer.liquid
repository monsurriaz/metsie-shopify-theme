<footer class="site-footer" data-section-id="{{ section.id }}">
  <div class="site-footer__inner">

    {%- comment -%} 4-column grid {%- endcomment -%}
    <div class="site-footer__grid" data-reveal-group>

      {%- comment -%} Column 1: CUSTOMER CARE {%- endcomment -%}
      <div class="site-footer__col">
        <h3 class="site-footer__col-heading">CUSTOMER CARE</h3>
        <ul class="site-footer__links">
          <li><a href="/pages/faq" class="site-footer__link">FAQ</a></li>
          <li><a href="/pages/contact" class="site-footer__link">Contact</a></li>
          <li><a href="/pages/shipping-returns" class="site-footer__link">Shipping &amp; Returns</a></li>
        </ul>
      </div>

      {%- comment -%} Column 2: CARD & CHECKOUT {%- endcomment -%}
      <div class="site-footer__col">
        <h3 class="site-footer__col-heading">CARD &amp; CHECKOUT</h3>
        <ul class="site-footer__links">
          <li><a href="/cart" class="site-footer__link">Cart</a></li>
          <li><a href="/checkout" class="site-footer__link">Checkout</a></li>
          <li><a href="/account" class="site-footer__link">Account / Orders</a></li>
        </ul>
      </div>

      {%- comment -%} Column 3: LEGAL {%- endcomment -%}
      <div class="site-footer__col">
        <h3 class="site-footer__col-heading">LEGAL</h3>
        <ul class="site-footer__links">
          <li><a href="/pages/terms-and-conditions" class="site-footer__link">Terms &amp; Conditions</a></li>
          <li><a href="/pages/privacy-policy" class="site-footer__link">Privacy Policy</a></li>
          <li><a href="/pages/design-protection" class="site-footer__link">Design Protection Notice</a></li>
        </ul>
      </div>

      {%- comment -%} Column 4: NEWSLETTER {%- endcomment -%}
      <div class="site-footer__col site-footer__col--newsletter">
        <h3 class="site-footer__col-heading">SIGN UP TO OUR NEWSLETTER</h3>
        <p class="site-footer__newsletter-subtitle">
          {{ section.settings.newsletter_subtitle | default: 'Subscribe to get a 10% discount on your first order!' }}
        </p>
        {% form 'customer', id: 'footer-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-form">
            <input
              type="email"
              name="contact[email]"
              class="site-footer__newsletter-input"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email address' }}"
              required
              aria-label="Email address for newsletter"
            >
            <button type="submit" class="site-footer__newsletter-btn">
              {{ section.settings.newsletter_button | default: 'SUBMIT' | upcase }}
            </button>
          </div>
        {% endform %}
      </div>

    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="site-footer__bottom">

      <div class="site-footer__bottom-left">
        <p class="site-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} Metsie
        </p>
      </div>

      {%- comment -%} Social icons: Instagram + Pinterest only {%- endcomment -%}
      <div class="site-footer__social">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="social-link" aria-label="Follow on Instagram" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.pinterest_url != blank %}
          <a href="{{ section.settings.pinterest_url }}" class="social-link" aria-label="Follow on Pinterest" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.03-2.83.18-.78 1.22-5.17 1.22-5.17s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.58 2.26-.87 3.51-.25 1.05.52 1.9 1.54 1.9 1.85 0 3.09-2.38 3.09-5.2 0-2.14-1.44-3.74-4.03-3.74-2.94 0-4.76 2.2-4.76 4.65 0 .84.24 1.44.62 1.9.17.2.19.28.13.51-.04.17-.14.57-.18.73-.06.23-.24.31-.43.23-1.2-.49-1.76-1.81-1.76-3.3 0-2.44 2.06-5.37 6.16-5.37 3.31 0 5.49 2.4 5.49 4.98 0 3.41-1.89 5.96-4.66 5.96-.93 0-1.81-.5-2.11-1.07l-.58 2.2c-.21.8-.77 1.8-1.15 2.41.87.27 1.79.42 2.75.42 5.52 0 10-4.48 10-10S17.52 2 12 2z" fill="currentColor"/>
            </svg>
          </a>
        {% endif %}
      </div>

    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: #2D4A6A;
    color: #F5F0E8;
    padding: 80px 0 0;
  }

  .site-footer__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--container-px);
  }

  /* Grid */
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.5fr;
    gap: 48px;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(245,240,232,0.12);
  }

  /* Column headings */
  .site-footer__col-heading {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.5;
    margin: 0 0 20px;
  }

  /* Nav links */
  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__link {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s ease;
    line-height: 1.4;
  }

  .site-footer__link:hover {
    opacity: 1;
  }

  /* Newsletter column */
  .site-footer__newsletter-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    line-height: 1.6;
    opacity: 0.65;
    margin: 0 0 20px;
  }

  .site-footer__newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__newsletter-input {
    background: transparent;
    border: 1px solid rgba(245,240,232,0.3);
    color: #F5F0E8;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    letter-spacing: 0.05em;
    padding: 12px 14px;
    outline: none;
    transition: border-color 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .site-footer__newsletter-input::placeholder {
    color: rgba(245,240,232,0.4);
  }

  .site-footer__newsletter-input:focus {
    border-color: rgba(245,240,232,0.7);
  }

  .site-footer__newsletter-btn {
    background-color: #F5F0E8;
    color: #2D4A6A;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 13px 20px;
    cursor: pointer;
    transition: background-color 0.25s ease;
    width: 100%;
  }

  .site-footer__newsletter-btn:hover {
    background-color: #EDE8E0;
  }

  /* Bottom bar */
  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
  }

  .site-footer__copyright {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    opacity: 0.4;
    margin: 0;
  }

  /* Social */
  .site-footer__social {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .social-link {
    color: inherit;
    opacity: 0.6;
    transition: opacity 0.2s ease;
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .site-footer__inner { padding: 0 24px; }
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .site-footer__col--newsletter {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .site-footer { padding: 56px 0 0; }
    .site-footer__inner { padding: 0 16px; }
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding-bottom: 48px;
    }
    .site-footer__col--newsletter {
      grid-column: 1 / -1;
    }
    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .site-footer__newsletter-form {
      flex-direction: row;
    }
    .site-footer__newsletter-btn {
      width: auto;
      white-space: nowrap;
      padding: 13px 16px;
    }
  }

  @media (max-width: 400px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
    .site-footer__newsletter-form {
      flex-direction: column;
    }
    .site-footer__newsletter-btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "site-footer-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_subtitle",
      "label": "Newsletter subtitle",
      "default": "Subscribe to get a 10% discount on your first order!"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Submit button text",
      "default": "SUBMIT"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "settings": {
        "newsletter_subtitle": "Subscribe to get a 10% discount on your first order!",
        "newsletter_placeholder": "Your email address",
        "newsletter_button": "SUBMIT"
      }
    }
  ]
}
{% endschema %}
