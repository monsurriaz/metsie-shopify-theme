{%- assign shipping_blocks = section.blocks | where: 'type', 'shipping_accordion' -%}
{%- assign returns_blocks = section.blocks | where: 'type', 'returns_accordion' -%}

<div class="shipping-info non-banner__hero-section" data-section-id="{{ section.id }}">
  <div class="shipping-info__inner container container--narrow">

    <div class="shipping-info__content">
      <div class="shipping-info__header" {% unless request.design_mode %}data-reveal-group{% endunless %}>
        <h1 class="shipping-info__heading text-heading-primary">
          {{ section.settings.heading }}
        </h1>

        {% if section.settings.intro_text != blank %}
          <div class="shipping-info__intro text-body-light">
            {{ section.settings.intro_text }}
          </div>
        {% endif %}
      </div>

      {% if shipping_blocks.size > 0 %}
        <div class="shipping-accordion-list" x-data='{ openItem: null }' {% unless request.design_mode %}data-reveal-group{% endunless %}>
          {% for block in shipping_blocks %}
            <div
              class="shipping-accordion-item"
              :class='{ "is-open": openItem === {{ block.id | json }} }'
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="shipping-accordion-item__trigger"
                id="shipping-trigger-{{ block.id }}"
                aria-controls="shipping-body-{{ block.id }}"
                aria-expanded="false"
                :aria-expanded='openItem === {{ block.id | json }}'
                @click='openItem = openItem === {{ block.id | json }} ? null : {{ block.id | json }}'
              >
                <span class="shipping-accordion-item__question text-body-primary">
                  {{ block.settings.question }}
                </span>
                <span class="shipping-accordion-item__icon" aria-hidden="true"></span>
              </button>

              <div
                class="shipping-accordion-item__body"
                id="shipping-body-{{ block.id }}"
                role="region"
                aria-labelledby="shipping-trigger-{{ block.id }}"
              >
                <div class="shipping-accordion-item__answer text-body-light">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="returns-info__content">
      {% if section.settings.returns_heading != blank %}
        <div class="returns-info__header" {% unless request.design_mode %}data-reveal-group{% endunless %}>
          <h2 class="returns-info__heading text-heading-primary">
            {{ section.settings.returns_heading }}
          </h2>
        </div>
      {% endif %}

      {% if returns_blocks.size > 0 %}
        <div class="returns-accordion-list" x-data='{ openItem: null }' {% unless request.design_mode %}data-reveal-group{% endunless %}>
          {% for block in returns_blocks %}
            <div
              class="shipping-accordion-item"
              :class='{ "is-open": openItem === {{ block.id | json }} }'
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="shipping-accordion-item__trigger"
                id="returns-trigger-{{ block.id }}"
                aria-controls="returns-body-{{ block.id }}"
                aria-expanded="false"
                :aria-expanded='openItem === {{ block.id | json }}'
                @click='openItem = openItem === {{ block.id | json }} ? null : {{ block.id | json }}'
              >
                <span class="shipping-accordion-item__question text-body-primary">
                  {{ block.settings.question }}
                </span>
                <span class="shipping-accordion-item__icon" aria-hidden="true"></span>
              </button>

              <div
                class="shipping-accordion-item__body"
                id="returns-body-{{ block.id }}"
                role="region"
                aria-labelledby="returns-trigger-{{ block.id }}"
              >
                <div class="shipping-accordion-item__answer text-body-light">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</div>

<style>
  .non-banner__hero-section {
    padding-top: var(--space-25);
    padding-bottom: var(--space-40);
  }

  .shipping-info__header {
    margin-bottom: var(--space-12);
  }

  .shipping-info__heading {
    margin: 0 0 var(--space-15);
  }

  .shipping-info__intro {
    color: var(--color-near-black);
    opacity: 0.85;
  }

  .shipping-info__intro > *:first-child { margin-top: 0; }
  .shipping-info__intro > *:last-child { margin-bottom: 0; }
  .shipping-info__intro p { margin: 0 0 var(--space-4); }
  .shipping-info__intro ul {
    list-style: disc;
    margin: var(--space-1) 0 var(--space-8);
    padding-left: var(--space-6);
  }
  .shipping-info__intro li { margin-bottom: var(--space-1); }

  .shipping-accordion-list,
  .returns-accordion-list {
    border-top: var(--border-width) solid rgba(31, 31, 30, 0.31);
  }

  .shipping-accordion-item {
    border-bottom: var(--border-width) solid rgba(31, 31, 30, 0.31);
  }

  .shipping-accordion-item__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    width: 100%;
    padding: var(--space-10) 0;
    background: none;
    border: none;
    color: var(--color-near-black);
    cursor: pointer;
    text-align: left;
    transition: padding var(--transition-base);
  }

  .shipping-accordion-item.is-open .shipping-accordion-item__trigger {
    padding-bottom: var(--space-2-5);
  }

  .shipping-accordion-item__question {
    flex: 1;
    display: inline-block;
  }

  .shipping-accordion-item__icon {
    position: relative;
    flex-shrink: 0;
    width: 0.9375rem;
    height: 0.9375rem;
    color: var(--color-near-black);
    opacity: 0.85;
  }

  .shipping-accordion-item__icon::before,
  .shipping-accordion-item__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .shipping-accordion-item__icon::before {
    width: 0.9375rem;
    height: calc(var(--border-width) / 2);
  }

  .shipping-accordion-item__icon::after {
    width: calc(var(--border-width) / 2);
    height: 0.9375rem;
  }

  .shipping-accordion-item.is-open .shipping-accordion-item__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .shipping-accordion-item__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-base);
  }

  .shipping-accordion-item.is-open .shipping-accordion-item__body {
    grid-template-rows: 1fr;
  }

  .shipping-accordion-item__answer {
    overflow: hidden;
    padding-bottom: 0;
    color: var(--color-near-black);
    opacity: 0.72;
    transition: padding-bottom var(--transition-base);
  }

  .shipping-accordion-item__answer > *:first-child { margin-top: 0; }
  .shipping-accordion-item__answer p { margin: 0 0 var(--space-3); }
  .shipping-accordion-item__answer p:last-child { margin-bottom: 0; }
  .shipping-accordion-item__answer ul,
  .shipping-accordion-item__answer ol {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-5);
  }

  .shipping-accordion-item.is-open .shipping-accordion-item__answer {
    padding-bottom: var(--space-10);
  }

  .returns-info__content {
    margin-top: var(--space-40);
  }
  .returns-info__header {
    margin-bottom: var(--space-12);
  }

  .returns-info__heading {
    margin: 0;
  }

  @media (max-width: 767px) {
    .non-banner__hero-section {
      padding: var(--space-25) 0 var(--space-20);
    }

    .shipping-info__header {
      margin-bottom: var(--space-10);
    }

    .shipping-accordion-item__trigger {
      padding: var(--space-4) 0 var(--space-5) 0;
    }

    .shipping-accordion-item__icon {
      width: 0.5375rem;
      height: 0.5375rem;
      opacity: 0.85;
    }

    .shipping-accordion-item__icon::before {
      width: 0.5375rem;
      height: var(--border-width);
    }

    .shipping-accordion-item__icon::after {
      height: 0.5375rem;
    }

    .shipping-accordion-item__answer > *:first-child { margin-top: 0; }
    .shipping-accordion-item__answer p { margin: 0 0 var(--space-3); }
    .shipping-accordion-item__answer p:last-child { margin-bottom: 0; }
    .shipping-accordion-item__answer ul,
    .shipping-accordion-item__answer ol {
      padding-left: var(--space-3);
    }
    .shipping-accordion-item.is-open .shipping-accordion-item__answer {
      padding-bottom: var(--space-5);
    }

    .returns-info__content {
      margin-top: var(--space-20);
    }

    .returns-info__header {
      margin-bottom: var(--space-9);
    }
  }
</style>

{% schema %}
{
  "name": "Shipping Info",
  "tag": "section",
  "class": "shipping-info-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping and delivery"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>Please use the below guidelines to get an understanding of our shipping and delivery terms.</p><p>We currently ship to the following countries:</p><ul><li>- Denmark (1-2 business days)</li><li>- EU, UK, Norway and Switzerland (2-3 business days)</li><li>- US and Canada (3-5 business days)</li><li>- Japan and South Korea (3-5 business days)</li><li>- Rest of world (4-6 business days)</li></ul><p>All shipment times are an estimate and cannot be guaranteed.</p><p>Please contact us with any enquiries at:</p>"
    },
    {
      "type": "text",
      "id": "returns_heading",
      "label": "Returns heading",
      "default": "Returns and exchanges"
    }
  ],
  "blocks": [
    {
      "type": "shipping_accordion",
      "name": "Shipping Accordion",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
