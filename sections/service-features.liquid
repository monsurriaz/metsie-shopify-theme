<div class="service-features" data-section-id="{{ section.id }}">
  <div class="{% if section.settings.section_width == 'natural' %}container--lg {% elsif section.settings.section_width == 'compact' %}container {% else %}service-features__inner{% endif %}">
    <div class="{% unless section.settings.section_width == 'full_width' %}service-features__inner{% else %}container{% endunless %}">

      {% if section.settings.section_width == "natural" %}
        <div class="container">
      {% endif %}

      <div class="service-features__header">
        <p class="service-features__label text-body-primary">{{ section.settings.label | default: 'MAKING EXPERIENCE' | upcase }}</p>
      </div>
  
      <div class="service-features__grid" data-reveal-group>
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="service-features__item" {{ block.shopify_attributes }}>
              <h3 class="service-features__item-heading text-heading-primary">{{ block.settings.heading | default: '[Feature]' }}</h3>
              {% if block.settings.description != blank %}
                <p class="service-features__item-description text-body-light">{{ block.settings.description }}</p>
                {% if block.settings.url != blank or block.settings.label != blank %}
                  <a href="{{ block.settings.url }}" class="service-features__item-btn text-body-light">{{ block.settings.label }}</a>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        {% else %}
          {%- comment -%} Default placeholder features when no blocks {%- endcomment -%}
          <div class="service-features__item">
            <h3 class="service-features__item-heading text-heading-primary">Free delivery</h3>
            <p class="service-features__item-description text-body-light">Complimentary shipping on all orders across Europe</p>
          </div>
          <div class="service-features__item">
            <h3 class="service-features__item-heading text-heading-primary">Trade & studio orders</h3>
            <p class="service-features__item-description text-body-light">Dedicated support and pricing for interior professionals</p>
          </div>
          <div class="service-features__item">
            <h3 class="service-features__item-heading text-heading-primary">Custom colors</h3>
            <p class="service-features__item-description text-body-light">Bespoke colorway service for made-to-order pieces</p>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.section_width == "natural" %}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  .service-features {
    background-color: var(--color-white);
    padding-top: 40px;
  }

  .service-features__inner {
    padding: var(--section-py) 0;
    color: var(--color-white);
    background-color: var(--color-deep-navy);
  }

  .service-features__header {
    margin-bottom: 60px;
  }

  .service-features__label {
    color: var(--color-white);
    text-align: center;
  }

  .service-features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .service-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding-inline: 20px;
  }

  .service-features__item-heading {
    margin: 0 0 var(--gap-sm);
    color: var(--color-white);
  }

  .service-features__item-description {
    
  }

  .service-features__item-btn {
    color: var(--color-white);
    text-decoration: underline;
  }

  .service-features__item-btn:hover {
    color: var(--color-white);
    opacity: 0.8;
  }

  @media (max-width: 1024px) {
    .service-features__grid {
      gap: 32px;
    }
  }

  @media (max-width: 768px) {
    .service-features__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Service Features",
  "tag": "section",
  "class": "service-features-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "MAKING EXPERIENCE"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {
          "value": "full_width",
          "label": "Full Width"
        },
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ],
      "default": "natural"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Feature heading",
          "default": "Free delivery"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Feature description",
          "default": "Complimentary shipping on all orders across Europe"
        },
        {
          "type": "text",
          "id": "label",
          "default": "View shipping details",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Button url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service Features",
      "settings": {
        "label": "MAKING EXPERIENCE"
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "heading": "Free delivery",
            "description": "Free standard delivery on orders over €200.",
            "label": "View shipping details"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Trade & studio orders",
            "description": "For hotels, studios, and interior projects.",
            "label": "Inquire here"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Custom colors",
            "description": "Interested in a specific shade? Write to us.",
            "label": "Get in touch"
          }
        }
      ]
    }
  ]
}
{% endschema %}
