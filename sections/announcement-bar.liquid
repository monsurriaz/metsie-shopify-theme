{%- comment -%}
  Announcement Bar — hidden by default (Figma design has no announcement bar).
  Set show_bar to true in the theme editor to enable it if needed.
{%- endcomment -%}

{% if section.settings.show_bar %}
<div
  class="announcement-bar"
  data-section-id="{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
  x-data="{ visible: !localStorage.getItem('metsie-announcement-closed-{{ section.id }}') }"
  x-show="visible"
  x-transition:leave="transition-bar"
  x-transition:leave-start="opacity-1"
  x-transition:leave-end="opacity-0"
>
  <div class="announcement-bar__inner">
    <div class="announcement-bar__content">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
      {% endif %}
        <span class="announcement-bar__text">{{ section.settings.text }}</span>
      {% if section.settings.link != blank %}
        </a>
      {% endif %}
    </div>

    {% if section.settings.show_close %}
      <button
        class="announcement-bar__close"
        aria-label="Close announcement"
        @click="visible = false; localStorage.setItem('metsie-announcement-closed-{{ section.id }}', '1')"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    {% endif %}
  </div>
</div>
{% endif %}

<style>
  .announcement-bar {
    position: relative;
    z-index: 100;
    width: 100%;
    padding: 10px 20px;
    text-align: center;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
  }

  .announcement-bar__content {
    flex: 1;
    text-align: center;
  }

  .announcement-bar__text {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .announcement-bar__close {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .announcement-bar__close:hover {
    opacity: 1;
  }

  .transition-bar {
    transition: opacity 0.3s ease;
  }

  .opacity-1 { opacity: 1; }
  .opacity-0 { opacity: 0; }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "div",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "FREE SHIPPING ON ORDERS OVER €150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2D4A6A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5F0E8"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "settings": {
        "text": "FREE SHIPPING ON ORDERS OVER €150",
        "bg_color": "#2D4A6A",
        "text_color": "#F5F0E8",
        "show_bar": false,
        "show_close": true
      }
    }
  ]
}
{% endschema %}
