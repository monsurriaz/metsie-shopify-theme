<header
  class="site-header is-initializing"
  data-section-id="{{ section.id }}"
  data-reveal="slide-down"
  x-data="siteHeader()"
  :class="{ 'is-transparent': isTransparent, 'is-sticky': isSticky, 'is-scrolled': isScrolled, 'is-hidden': isHidden }"
>
  <div class="site-header__inner container">

    {%- comment -%} HAMBURGER — hidden desktop, left column on mobile {%- endcomment -%}
    <button
      class="site-header__hamburger"
      aria-label="Open menu"
      @click="$dispatch('open-mobile-menu')"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    {%- comment -%} LOGO — left on desktop, centered on mobile {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} — Home">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: settings.logo_width }}"
          alt="{{ shop.name }}"
          width="{{ settings.logo_width }}"
          height="auto"
          loading="eager"
          class="site-header__logo-img site-header__logo-img--light"
        >
        {%- if settings.logo_dark != blank -%}
          <img
            src="{{ settings.logo_dark | image_url: width: settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            height="auto"
            loading="eager"
            class="site-header__logo-img site-header__logo-img--dark"
          >
        {%- endif -%}
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name | upcase }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} NAV — centered on desktop, hidden on mobile {%- endcomment -%}
    <nav class="site-header__nav" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" class="site-header__nav-link{% if link.active %} is-active{% endif %}">
            {{ link.title | upcase }}
          </a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}" class="site-header__nav-link">SHOP</a>
        <a href="/pages/about" class="site-header__nav-link">ABOUT</a>
        <a href="/pages/inspiration" class="site-header__nav-link">INSPIRATION</a>
        <a href="/blogs/news" class="site-header__nav-link">BLOG</a>
      {% endif %}
    </nav>

    {%- comment -%} ACTIONS — currency + cart, right column {%- endcomment -%}
    <div class="site-header__actions">

      {%- comment -%} Currency selector {%- endcomment -%}
      {% if settings.show_currency_selector and shop.enabled_currencies.size > 1 %}
        <div class="site-header__currency">
          {% form 'currency' %}
            <select name="currency" class="header-currency-select" onchange="this.form.submit()" aria-label="Select currency">
              {% for currency in shop.enabled_currencies %}
                <option value="{{ currency.iso_code }}" {% if currency == cart.currency %}selected{% endif %}>
                  {{ currency.iso_code }}
                </option>
              {% endfor %}
            </select>
          {% endform %}
        </div>
      {% endif %}

      {%- comment -%} Cart link {%- endcomment -%}
      <a
        href="{{ routes.cart_url }}"
        class="site-header__cart"
        aria-label="Cart ({{ cart.item_count }} items)"
        @click.prevent="$dispatch('open-cart-drawer')"
      >
        <span class="site-header__cart-text">CART (<span id="cart-count">{{ cart.item_count }}</span>)</span>
      </a>

    </div>

  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    transition: background-color 0.35s ease, box-shadow 0.35s ease, color 0.35s ease, transform 0.35s ease;
    background-color: #FFFFFF;
    color: #1A1A1A;
  }

  .site-header.is-initializing {
    transition: none !important;
  }

  .site-header.is-transparent {
    background-color: transparent;
    color: #F5F0E8;
    box-shadow: none;
  }

  .site-header.is-scrolled {
    background-color: var(--color-white);
    color: #1A1A1A;
    box-shadow: 0 1px 0 rgba(0,0,0,0.06);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  /* 3-column grid */
  .site-header__inner {
    display: grid;
    grid-template-columns: var(--logo-width, 120px) 1fr auto;
    grid-template-columns: 0.5fr 1fr 0.5fr;
    grid-template-areas: "logo nav actions";
    align-items: center;
    height: 65px;
  }

  /* Logo */
  .site-header__logo {
    grid-area: logo;
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo-img {
    width: var(--logo-width, 120px);
    height: auto;
  }

  .site-header__logo-img--light { display: none; }

  .site-header.is-transparent .site-header__logo-img--dark { display: none; }
  .site-header.is-transparent .site-header__logo-img--light { display: block; }
  .site-header.is-scrolled .site-header__logo-img--dark { display: block; }
  .site-header.is-scrolled .site-header__logo-img--light { display: none; }

  .site-header__logo-text {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: inherit;
  }

  /* Nav */
  .site-header__nav {
    grid-area: nav;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 36px;
  }

  .site-header__nav-link {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    line-height: var(--lh-relaxed);
    color: inherit;
    opacity: 0.85;
    transition: opacity 0.2s ease;
    position: relative;
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.2s ease;
  }

  .site-header__nav-link:hover,
  .site-header__nav-link.is-active {
    color: inherit;
    opacity: 1;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link.is-active::after {
    width: 100%;
  }

  /* Actions */
  .site-header__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
  }

  /* Currency */
  .site-header__currency {
    display: flex;
    align-items: center;
  }

  .header-currency-select {
    background: transparent;
    border: none;
    color: inherit;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 10px;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    padding: 0;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .header-currency-select:hover { opacity: 1; }

  /* Cart */
  .site-header__cart {
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .site-header__cart:hover {
    color: inherit;
    opacity: 1;
  }

  .site-header__cart-text {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: var(--lh-relaxed);
    color: inherit;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .site-header__cart:hover .site-header__cart-text { opacity: 1; }

  /* Hamburger — hidden on desktop */
  .site-header__hamburger {
    display: none;
    grid-area: hamburger;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: inherit;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* Body offset for fixed header — JS keeps --header-height in sync across breakpoints */
  body { padding-top: var(--header-height); }
  body.hero-page { padding-top: 0; }

  @media (max-width: 1024px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "hamburger logo actions";
      height: 45px;
    }

    .site-header__logo { justify-self: center; }
    .site-header__nav { display: none; }
    .site-header__hamburger { display: flex; }
    .site-header__currency { display: none; }

    .site-header__logo-img {
      width: 65px;
    }
  }

  @media (max-width: 640px) {
    .site-header__inner { padding: 0 16px; }
  }
</style>

<script>
  function siteHeader() {
    return {
      isSticky: {{ settings.header_sticky | json }},
      _transparentEnabled: {% if settings.header_style == 'transparent' %}true{% else %}false{% endif %},
      hideOnScroll: {{ section.settings.hide_on_scroll | json }},
      isTransparent: false,
      isScrolled: false,
      isHidden: false,
      lastScrollY: 0,
      _hasHero: false,
      init() {
        this._hasHero = !!document.querySelector('.hero-banner');
        this.isTransparent = this._transparentEnabled && this._hasHero;
        this.$el.classList.remove('is-initializing');

        const headerEl = this.$el;
        const setHeaderHeight = () => {
          document.documentElement.style.setProperty('--header-height', headerEl.offsetHeight + 'px');
        };
        setHeaderHeight();
        window.addEventListener('resize', setHeaderHeight, { passive: true });

        if (this.isSticky || this._transparentEnabled || this.hideOnScroll) {
          window.addEventListener('scroll', () => {
            const currentY = window.scrollY;
            this.isScrolled = currentY > 20;

            if (this._transparentEnabled && this._hasHero) {
              this.isTransparent = currentY < 50;
            }

            if (this.hideOnScroll && currentY > 80) {
              this.isHidden = currentY > this.lastScrollY;
            } else {
              this.isHidden = false;
            }

            this.lastScrollY = currentY;
          }, { passive: true });
        }
      }
    }
  }
</script>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "site-header-wrapper",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Hide header when scrolling down",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Header",
      "settings": {
        "menu": "main-menu"
      }
    }
  ]
}
{% endschema %}
