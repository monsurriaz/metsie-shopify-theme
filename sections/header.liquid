<header
  class="site-header"
  data-section-id="{{ section.id }}"
  data-sticky="{{ section.settings.sticky }}"
  data-transparent="{{ section.settings.transparent_on_hero }}"
  x-data="siteHeader()"
  :class="{ 'is-sticky': isSticky, 'is-transparent': isTransparent, 'is-scrolled': isScrolled }"
>
  <div class="site-header__inner">

    {%- comment -%} LEFT: Navigation links (desktop) {%- endcomment -%}
    <nav class="site-header__nav" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" class="site-header__nav-link{% if link.active %} is-active{% endif %}">
            {{ link.title | upcase }}
          </a>
        {% endfor %}
      {% else %}
        <a href="/collections/all" class="site-header__nav-link">SHOP</a>
        <a href="/pages/about" class="site-header__nav-link">ABOUT</a>
        <a href="/pages/inspiration" class="site-header__nav-link">INSPIRATION</a>
        <a href="/blogs/news" class="site-header__nav-link">BLOG</a>
      {% endif %}
    </nav>

    {%- comment -%} MOBILE ONLY: METSIE wordmark logo — hidden on desktop {%- endcomment -%}
    <a href="/" class="site-header__mobile-logo" aria-label="{{ shop.name }} — Home">
      <img
        src="{{ 'logo-black.svg' | asset_url }}"
        alt="{{ shop.name }}"
        height="15"
        width="auto"
        loading="eager"
        class="site-header__mobile-logo-img site-header__mobile-logo-img--dark"
      >
      <img
        src="{{ 'logo-white.svg' | asset_url }}"
        alt="{{ shop.name }}"
        height="15"
        width="auto"
        loading="eager"
        class="site-header__mobile-logo-img site-header__mobile-logo-img--light"
      >
    </a>

    {%- comment -%} RIGHT: Currency selector + CART (0) {%- endcomment -%}
    <div class="site-header__right">

      {%- comment -%} Currency selector (small) {%- endcomment -%}
      {% if section.settings.show_currency_selector and shop.enabled_currencies.size > 1 %}
        <div class="site-header__currency">
          {% form 'currency' %}
            <select name="currency" class="header-currency-select" onchange="this.form.submit()" aria-label="Select currency">
              {% for currency in shop.enabled_currencies %}
                <option value="{{ currency.iso_code }}" {% if currency == cart.currency %}selected{% endif %}>
                  {{ currency.iso_code }}
                </option>
              {% endfor %}
            </select>
          {% endform %}
        </div>
      {% endif %}

      {%- comment -%} CART (0) link {%- endcomment -%}
      <a
        href="/cart"
        class="site-header__cart-link"
        aria-label="Cart ({{ cart.item_count }} items)"
        @click.prevent="$dispatch('open-cart-drawer')"
      >
        <span class="site-header__cart-text">CART ({{ cart.item_count }})</span>
      </a>

      {%- comment -%} Mobile hamburger {%- endcomment -%}
      <button
        class="site-header__hamburger"
        aria-label="Open menu"
        @click="$dispatch('open-mobile-menu')"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>

  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    transition: background-color 0.35s ease, box-shadow 0.35s ease, color 0.35s ease;
    background-color: #FFFFFF;
    color: #1A1A1A;
  }

  .site-header.is-transparent {
    background-color: transparent;
    color: #F5F0E8;
  }

  .site-header.is-scrolled {
    background-color: #FFFFFF;
    color: #1A1A1A;
    box-shadow: 0 1px 0 rgba(0,0,0,0.06);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    height: 72px;
  }

  /* MOBILE-ONLY: METSIE logo — hidden on desktop */
  .site-header__mobile-logo {
    display: none;
    align-items: center;
  }
  .site-header__mobile-logo-img {
    height: 15px;
    width: auto;
  }
  .site-header__mobile-logo-img--light {
    display: none;
  }
  .site-header.is-transparent .site-header__mobile-logo-img--dark {
    display: none;
  }
  .site-header.is-transparent .site-header__mobile-logo-img--light {
    display: block;
  }
  .site-header.is-scrolled .site-header__mobile-logo-img--dark {
    display: block;
  }
  .site-header.is-scrolled .site-header__mobile-logo-img--light {
    display: none;
  }

  /* LEFT: Nav */
  .site-header__nav {
    display: flex;
    gap: 36px;
    align-items: center;
  }

  .site-header__nav-link {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    opacity: 0.85;
    transition: opacity 0.2s ease;
    position: relative;
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.2s ease;
  }

  .site-header__nav-link:hover,
  .site-header__nav-link.is-active {
    opacity: 1;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link.is-active::after {
    width: 100%;
  }

  /* RIGHT: Currency + Cart */
  .site-header__right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
  }

  /* Currency selector */
  .site-header__currency {
    display: flex;
    align-items: center;
  }

  .header-currency-select {
    background: transparent;
    border: none;
    color: inherit;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    cursor: pointer;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    padding: 0;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .header-currency-select:hover {
    opacity: 1;
  }

  /* CART link */
  .site-header__cart-link {
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .site-header__cart-text {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    transition: opacity 0.2s ease;
    opacity: 0.85;
  }

  .site-header__cart-link:hover .site-header__cart-text {
    opacity: 1;
  }

  /* Mobile hamburger — hidden on desktop */
  .site-header__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: inherit;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* Body offset for fixed header */
  body {
    padding-top: 72px;
  }

  /* Transparent header — no padding needed (hero fills viewport) */
  body.hero-page {
    padding-top: 0;
  }

  @media (max-width: 1024px) {
    .site-header__inner {
      padding: 0 24px;
      height: 64px;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__mobile-logo {
      display: flex;
    }

    .site-header__hamburger {
      display: flex;
    }

    /* On mobile, show CART (0) and hamburger side by side */
    .site-header__right {
      gap: 16px;
    }

    body { padding-top: 64px; }
    body.hero-page { padding-top: 0; }
  }

  @media (max-width: 640px) {
    .site-header__inner {
      padding: 0 16px;
    }
    .site-header__currency {
      display: none;
    }
  }
</style>

<script>
  function siteHeader() {
    return {
      isSticky: {{ section.settings.sticky | json }},
      isTransparent: {{ section.settings.transparent_on_hero | json }},
      isScrolled: false,
      init() {
        if (this.isSticky || this.isTransparent) {
          window.addEventListener('scroll', () => {
            this.isScrolled = window.scrollY > 20;
            if (this.isTransparent) {
              this.isTransparent = window.scrollY < 60;
            }
          }, { passive: true });

          // Check if hero is present (for transparent header)
          const hero = document.querySelector('.hero-banner');
          if (!hero) {
            this.isTransparent = false;
          }
        }
      }
    }
  }
</script>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "site-header-wrapper",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (optional — text logo used if blank)"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (shown if no image uploaded)",
      "default": "METSIE"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo image width",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent_on_hero",
      "label": "Transparent when over hero banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show currency selector in header",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header",
      "settings": {
        "menu": "main-menu",
        "logo_text": "METSIE",
        "sticky": true,
        "transparent_on_hero": true,
        "show_currency_selector": true
      }
    }
  ]
}
{% endschema %}
