<div class="about-page" data-section-id="{{ section.id }}">

  {%- comment -%} Hero {%- endcomment -%}
  <div
    class="about-hero"
    style="
      {% if section.settings.hero_image != blank %}
        background-image: url('{{ section.settings.hero_image | img_url: '2000x' }}');
        background-size: cover;
        background-position: center;
      {% else %}
        background-color: {{ section.settings.hero_bg_color }};
      {% endif %}
    "
  >
    {% if section.settings.hero_image != blank %}
      <div class="about-hero__overlay"></div>
    {% endif %}
    <div class="about-hero__content">
      <p class="section-label about-hero__label">OUR STORY</p>
      <h1 class="about-hero__heading">
        {{ section.settings.hero_heading | default: '[OUR STORY]' }}
      </h1>
      {% if section.settings.hero_subheading != blank %}
        <p class="about-hero__subheading">{{ section.settings.hero_subheading }}</p>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Mission statement {%- endcomment -%}
  <div class="about-mission">
    <div class="about-mission__inner">
      <p class="about-mission__text">
        {{ section.settings.mission_text | default: '[PLACEHOLDER MISSION STATEMENT — A SINGLE, POWERFUL SENTENCE THAT ENCAPSULATES WHAT METSIE STANDS FOR]' }}
      </p>
    </div>
  </div>

  {%- comment -%} Story section: alternating image/text blocks {%- endcomment -%}
  {% for block in section.blocks %}
    {% if block.type == 'story_block' %}
      <div
        class="about-story-block about-story-block--{{ forloop.index }}"
        style="background-color: {% if forloop.even %}#FFFFFF{% else %}#F5F0E8{% endif %};"
        {{ block.shopify_attributes }}
      >
        <div class="about-story-block__inner about-story-block__inner--{% if forloop.even %}flip{% endif %}">
          <div class="about-story-block__image-col">
            {% if block.settings.image != blank %}
              <div class="about-story-block__image-wrap">
                <img
                  src="{{ block.settings.image | img_url: '800x' }}"
                  alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                  width="800"
                  height="960"
                  loading="lazy"
                  class="about-story-block__image"
                >
              </div>
            {% else %}
              <div class="about-story-block__image-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'about-placeholder-svg' }}
              </div>
            {% endif %}
          </div>
          <div class="about-story-block__text-col">
            {% if block.settings.label != blank %}
              <p class="section-label">{{ block.settings.label | upcase }}</p>
            {% endif %}
            <h2 class="about-story-block__heading">{{ block.settings.heading | default: '[SECTION HEADING]' }}</h2>
            <div class="about-story-block__body">
              {{ block.settings.text | default: '<p>[PLACEHOLDER STORY TEXT — DESCRIBE THIS ASPECT OF YOUR BRAND, PROCESS, OR VALUES IN DETAIL]</p>' }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {%- comment -%} Values grid {%- endcomment -%}
  {% assign value_blocks = section.blocks | where: 'type', 'value' %}
  {% if value_blocks.size > 0 %}
    <div class="about-values">
      <div class="about-values__inner">
        {% if section.settings.values_heading != blank %}
          <header class="section-header">
            <h2 class="section-heading">{{ section.settings.values_heading }}</h2>
          </header>
        {% endif %}
        <div class="about-values__grid">
          {% for block in value_blocks %}
            <div class="about-value" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="about-value__icon">{{ block.settings.icon }}</div>
              {% else %}
                <div class="about-value__line" aria-hidden="true"></div>
              {% endif %}
              <h3 class="about-value__heading">{{ block.settings.heading | default: '[VALUE]' }}</h3>
              <p class="about-value__text">{{ block.settings.text | default: '[DESCRIBE THIS VALUE — WHAT IT MEANS TO METSIE AND HOW IT GUIDES YOUR WORK]' }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {%- comment -%} Team section {%- endcomment -%}
  {% assign team_blocks = section.blocks | where: 'type', 'team_member' %}
  {% if section.settings.show_team and team_blocks.size > 0 %}
    <div class="about-team">
      <div class="about-team__inner">
        {% if section.settings.team_heading != blank %}
          <header class="section-header">
            <h2 class="section-heading">{{ section.settings.team_heading }}</h2>
          </header>
        {% endif %}
        <div class="about-team__grid">
          {% for block in team_blocks %}
            <div class="team-member" {{ block.shopify_attributes }}>
              {% if block.settings.photo != blank %}
                <div class="team-member__photo">
                  <img
                    src="{{ block.settings.photo | img_url: '400x' }}"
                    alt="{{ block.settings.name | default: 'Team member' | escape }}"
                    width="400"
                    height="480"
                    loading="lazy"
                  >
                </div>
              {% else %}
                <div class="team-member__photo team-member__photo--placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'team-placeholder-svg' }}
                </div>
              {% endif %}
              <div class="team-member__info">
                <h3 class="team-member__name">{{ block.settings.name | default: '[NAME]' }}</h3>
                <p class="team-member__role">{{ block.settings.role | default: '[ROLE]' | upcase }}</p>
                {% if block.settings.bio != blank %}
                  <p class="team-member__bio">{{ block.settings.bio }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {%- comment -%} CTA banner {%- endcomment -%}
  {% if section.settings.cta_heading != blank %}
    <div class="about-cta">
      <div class="about-cta__inner">
        <h2 class="about-cta__heading">{{ section.settings.cta_heading }}</h2>
        {% if section.settings.cta_button_text != blank %}
          <a href="{{ section.settings.cta_button_link | default: '/collections/all' }}" class="btn-atc" style="display:inline-block;max-width:280px;text-align:center;padding:18px 48px;">
            {{ section.settings.cta_button_text | upcase }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}

</div>

<style>
  /* About hero */
  .about-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .about-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(30,58,95,0.55);
    z-index: 1;
  }

  .about-hero__content {
    position: relative;
    z-index: 2;
    color: #F5F0E8;
    padding: 80px 40px;
    max-width: 720px;
  }

  .about-hero__label {
    color: rgba(245,240,232,0.6);
    margin-bottom: 16px;
  }

  .about-hero__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    margin: 0 0 20px;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .about-hero__subheading {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.7;
    margin: 0;
  }

  /* Mission */
  .about-mission {
    padding: 80px 0;
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8E8E4;
  }

  .about-mission__inner {
    max-width: 840px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  .about-mission__text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 300;
    color: #1A1A1A;
    line-height: 1.5;
    font-style: italic;
    margin: 0;
  }

  /* Story blocks */
  .about-story-block {
    padding: 80px 0;
  }

  .about-story-block__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }

  .about-story-block__inner--flip .about-story-block__image-col {
    order: 2;
  }

  .about-story-block__inner--flip .about-story-block__text-col {
    order: 1;
  }

  .about-story-block__image-wrap,
  .about-story-block__image-placeholder {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #E8E8E4;
  }

  .about-story-block__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .about-story-block__image-wrap:hover .about-story-block__image {
    transform: scale(1.03);
  }

  .about-placeholder-svg {
    width: 100%;
    height: 100%;
    color: #ccc;
  }

  .about-story-block__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    color: #1A1A1A;
    margin: 0 0 24px;
    line-height: 1.1;
  }

  .about-story-block__body {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: #4A4A4A;
  }

  .about-story-block__body p { margin: 0 0 16px; }
  .about-story-block__body p:last-child { margin-bottom: 0; }

  /* Values */
  .about-values {
    padding: 96px 0;
    background-color: #F5F0E8;
  }

  .about-values__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    margin-top: 64px;
  }

  .about-value {
    text-align: left;
  }

  .about-value__line {
    width: 32px;
    height: 2px;
    background-color: #2D4A6A;
    margin-bottom: 24px;
  }

  .about-value__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 28px;
    font-weight: 400;
    color: #1A1A1A;
    margin: 0 0 14px;
  }

  .about-value__text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.75;
    color: #555;
    margin: 0;
  }

  /* Team */
  .about-team {
    padding: 96px 0;
    background-color: #FFFFFF;
  }

  .about-team__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .about-team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 64px;
  }

  .team-member__photo {
    aspect-ratio: 5 / 6;
    overflow: hidden;
    background-color: #F5F0E8;
    margin-bottom: 20px;
  }

  .team-member__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .team-member__photo:hover img {
    transform: scale(1.04);
  }

  .team-placeholder-svg {
    width: 100%;
    height: 100%;
    color: #ccc;
  }

  .team-member__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 400;
    margin: 0 0 4px;
    color: #1A1A1A;
  }

  .team-member__role {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: #2D4A6A;
    margin: 0 0 12px;
  }

  .team-member__bio {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.7;
    color: #666;
    margin: 0;
  }

  /* CTA */
  .about-cta {
    padding: 96px 0;
    background-color: #2D4A6A;
    text-align: center;
  }

  .about-cta__inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }

  .about-cta__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    color: #F5F0E8;
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .about-cta .btn-atc {
    background-color: #F5F0E8;
    color: #2D4A6A;
  }

  .about-cta .btn-atc:hover {
    background-color: transparent;
    color: #F5F0E8;
    border: 1px solid #F5F0E8;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .about-story-block__inner,
    .about-values__inner,
    .about-team__inner {
      padding: 0 24px;
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .about-story-block__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .about-story-block__inner--flip .about-story-block__image-col,
    .about-story-block__inner--flip .about-story-block__text-col {
      order: unset;
    }
    .about-values__grid { grid-template-columns: 1fr; gap: 32px; }
    .about-team__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .about-team__grid { grid-template-columns: 1fr; }
    .about-values__inner,
    .about-team__inner,
    .about-mission__inner,
    .about-cta__inner {
      padding: 0 16px;
    }
    .about-story-block { padding: 56px 0; }
    .about-story-block__inner { padding: 0 16px; }
  }
</style>

{% schema %}
{
  "name": "About Page",
  "tag": "div",
  "class": "about-page-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "hero_subheading",
      "label": "Hero subheading",
      "default": "CRAFTED WITH INTENTION. DESIGNED FOR LIVING."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "Hero background color (no image)",
      "default": "#2D4A6A"
    },
    {
      "type": "header",
      "content": "Mission Statement"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission statement",
      "default": "[PLACEHOLDER MISSION STATEMENT — A SINGLE, POWERFUL SENTENCE THAT ENCAPSULATES WHAT METSIE STANDS FOR]"
    },
    {
      "type": "header",
      "content": "Values Section"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Values heading",
      "default": "WHAT WE BELIEVE"
    },
    {
      "type": "header",
      "content": "Team Section"
    },
    {
      "type": "checkbox",
      "id": "show_team",
      "label": "Show team section",
      "default": false
    },
    {
      "type": "text",
      "id": "team_heading",
      "label": "Team heading",
      "default": "THE PEOPLE BEHIND METSIE"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "READY TO FIND YOUR PERFECT MAT?"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "CTA button link"
    }
  ],
  "blocks": [
    {
      "type": "story_block",
      "name": "Story Block",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (small caps)",
          "placeholder": "OUR CRAFT"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "[SECTION HEADING]"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>[PLACEHOLDER STORY TEXT]</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    },
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Value name",
          "default": "[VALUE]"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "[DESCRIBE THIS VALUE]"
        }
      ]
    },
    {
      "type": "team_member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "[NAME]"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "[ROLE]"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page",
      "settings": {
        "hero_heading": "OUR STORY",
        "hero_bg_color": "#2D4A6A",
        "show_team": false,
        "cta_heading": "READY TO FIND YOUR PERFECT MAT?",
        "cta_button_text": "SHOP NOW"
      },
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "QUALITY",
            "text": "[DESCRIBE YOUR COMMITMENT TO QUALITY]"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "SUSTAINABILITY",
            "text": "[DESCRIBE YOUR SUSTAINABLE PRACTICES]"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "DESIGN",
            "text": "[DESCRIBE YOUR DESIGN PHILOSOPHY]"
          }
        }
      ]
    }
  ]
}
{% endschema %}
