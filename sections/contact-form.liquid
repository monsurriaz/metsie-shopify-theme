<div class="contact-section non-banner__hero-section" data-section-id="{{ section.id }}">
  <div class="contact-section__inner container container--narrow">
    <div class="contact-section__content">
      <div class="contact-section__header" {% unless request.design_mode %}data-reveal-group{% endunless %}>
        <h1 class="contact-section__heading text-heading-primary">
          {{ section.settings.heading }}
        </h1>

        {% if section.settings.intro_text != blank %}
          <div class="contact-section__intro text-body-light">
            {{ section.settings.intro_text }}
          </div>
        {% endif %}
      </div>

      <div
        class="contact-section__form-wrap"
        x-data="{ isSubmitting: false }"
        @submit="isSubmitting = true"
        {% unless request.design_mode %}data-reveal-group{% endunless %}
      >
        {% form 'contact', class: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div
              class="contact-form__message contact-form__message--success"
              role="status"
              tabindex="-1"
              x-data
              x-init="$nextTick(() => $el.scrollIntoView({ block: 'center' }))"
            >
              {{ section.settings.success_message }}
            </div>
          {% else %}
            {% if form.errors %}
              <div class="contact-form__message contact-form__message--error text-body-light" role="alert" tabindex="-1">
                {{ section.settings.error_message }}
              </div>
            {% endif %}

            <div class="contact-form__row contact-form__row--split">
              <div class="contact-form__field">
                <label class="sr-only" for="contact-name-{{ section.id }}">
                  {{ section.settings.name_placeholder }}
                </label>
                <input
                  type="text"
                  id="contact-name-{{ section.id }}"
                  class="contact-form__input text-body-light"
                  name="contact[name]"
                  value="{% if form.author %}{{ form.author }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  autocomplete="name"
                  required
                  placeholder="{{ section.settings.name_placeholder }}"
                >
              </div>

              <div class="contact-form__field">
                <label class="sr-only" for="contact-email-{{ section.id }}">
                  {{ section.settings.email_placeholder }}
                </label>
                <input
                  type="email"
                  id="contact-email-{{ section.id }}"
                  class="contact-form__input text-body-light{% if form.errors contains 'email' %} has-error{% endif %}"
                  name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  placeholder="{{ section.settings.email_placeholder }}"
                >
              </div>
            </div>

            <div class="contact-form__field">
              <label class="sr-only" for="contact-message-{{ section.id }}">
                {{ section.settings.message_placeholder }}
              </label>
              <textarea
                id="contact-message-{{ section.id }}"
                class="contact-form__input contact-form__input--textarea text-body-light"
                name="contact[body]"
                required
                placeholder="{{ section.settings.message_placeholder }}"
              >{{ form.body }}</textarea>
            </div>

            <button
              type="submit"
              class="contact-form__submit text-body-primary"
              :class="{ 'btn--loading': isSubmitting }"
              :disabled="isSubmitting"
              aria-live="polite"
            >
              <span>{{ section.settings.submit_text }}</span>
            </button>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</div>

<style>
  .non-banner__hero-section {
    padding: var(--space-25) 0 var(--space-40);
  }

  .contact-section__header {
    margin-bottom: var(--space-15);
  }

  .contact-section__heading {
    margin: 0 0 var(--space-10);
  }

  .contact-section__intro {
    max-width: 37.5rem;
    color: var(--color-near-black);
    opacity: 0.85;
  }

  .contact-section__intro > *:first-child { margin-top: 0; }
  .contact-section__intro > *:last-child { margin-bottom: 0; }
  .contact-section__intro p { margin: 0 0 var(--space-2); }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-form__row--split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .contact-form__input {
    width: 100%;
    min-height: calc(var(--space-12) + var(--border-width) * 2);
    padding: 0 calc(var(--space-4) - 2px);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-white);
    color: var(--color-near-black);
    outline: none;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .contact-form__input::placeholder {
    color: var(--color-near-black);
    opacity: 0.4;
  }

  .contact-form__input:focus {
    border-color: var(--color-deep-navy);
  }

  .contact-form__input.has-error {
    border-color: var(--color-error);
  }

  .contact-form__input--textarea {
    display: block;
    min-height: calc(var(--space-40) + var(--space-24));
    padding-top: calc(var(--space-4) - 2px);
    resize: vertical;
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: calc(var(--space-12) + var(--border-width) * 2);
    padding: 0 calc(var(--space-4) - 2px);
    border: var(--border-width) solid var(--color-deep-navy);
    background-color: var(--color-deep-navy);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .contact-form__submit:hover {
    background-color: var(--color-btn-primary-hover);
    border-color: var(--color-btn-primary-hover);
  }

  .contact-form__submit.btn--loading {
    color: transparent;
  }

  .contact-form__submit.btn--loading span {
    opacity: 0;
  }

  .contact-form__message {
    color: var(--color-near-black);
  }

  .contact-form__message--success {
    display: flex;
    align-items: center;
    min-height: var(--space-40);
    padding: var(--space-10) 0;
    border-top: var(--border-width) solid var(--color-success);
    border-bottom: var(--border-width) solid var(--color-success);
    color: var(--color-success);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-light);
    line-height: var(--lh-tight);
  }

  .contact-form__message--error {
    padding: var(--space-4) 0;
    border-top: var(--border-width) solid var(--color-error);
    border-bottom: var(--border-width) solid var(--color-error);
    color: var(--color-error);
  }

  @media (max-width: 767px) {
    .non-banner__hero-section {
      padding: var(--space-25) 0 var(--space-20);
    }

    .contact-section__header {
      margin-bottom: var(--space-5);
    }

    .contact-section__heading {
      margin-bottom: var(--space-2-5);
    }

    .contact-form {
      gap: var(--space-2-5);
    }

    .contact-form__row--split {
      grid-template-columns: 1fr;
      gap: var(--space-2-5);
    }

    .contact-form__input {
      min-height: var(--space-10);
      padding-inline: calc(var(--space-4) - 2px);
    }

    .contact-form__input--textarea {
      min-height: calc((var(--space-40) * 2) + var(--space-10));
      padding-top: calc(var(--space-4) - 2px);
    }

    .contact-form__submit {
      min-height: calc(var(--space-10) + var(--space-1) + var(--border-width));
      margin-top: var(--space-1);
    }

    .contact-form__message--success {
      min-height: var(--space-30);
      padding: var(--space-8) 0;
      font-size: var(--text-xl);
    }
  }
</style>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "contact-form-outer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help you?"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>We are here for you - whether you have questions, need advice or support. You can use the contact form below, or email us directly at</p>"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Name*"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Email*"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Message*"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit text",
      "default": "SUBMIT INQUIRY"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for your message."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Please check the required fields and try again."
    }
  ],
  "presets": [
    {
      "name": "Contact Form",
      "settings": {
        "heading": "How can we help you?",
        "intro_text": "<p>We are here for you - whether you have questions, need advice or support. You can use the contact form below, or email us directly at</p>",
        "name_placeholder": "Name*",
        "email_placeholder": "Email*",
        "message_placeholder": "Message*",
        "submit_text": "SUBMIT INQUIRY",
        "success_message": "Thank you for your message.",
        "error_message": "Please check the required fields and try again."
      }
    }
  ]
}
{% endschema %}
