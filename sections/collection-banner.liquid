<div
  class="collection-banner"
  data-section-id="{{ section.id }}"
  data-transparent-header-anchor
  style="
    {% if collection.image and section.settings.show_collection_image %}
      background-image: url('{{ collection.image | img_url: '2000x' }}');
      background-size: cover;
      background-position: {{ section.settings.bg_position }};
    {% else %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
  "
>
  {% if collection.image and section.settings.show_collection_image %}
    <div class="collection-banner__overlay page-banner__overlay"></div>
  {% endif %}

  <div class="collection-banner__content page-banner__content">
    <p class="banner-label collection-banner__label page-banner__label text-body-primary">
      {{ section.settings.label | default: 'THE COLLECTION' | upcase }}
    </p>

    <h1 class="collection-banner__title page-banner__title">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading }}
      {% elsif collection.title != blank %}
        {{ collection.title }}
      {% else %}
        Mats designed to belong
      {% endif %}
    </h1>

    {% if section.settings.show_description and collection.description != blank %}
      <div class="collection-banner__description page-banner__description">
        {{ collection.description | strip_html | truncate: 200 }}
      </div>
    {% endif %}

    {% if section.settings.show_product_count %}
      <p class="collection-banner__count page-banner__count">
        {{ collection.products_count }}
        {% if collection.products_count == 1 %}
          PRODUCT
        {% else %}
          PRODUCTS
        {% endif %}
      </p>
    {% endif %}
  </div>
</div>

<style>
  .collection-banner {
    position: relative;
    background-color: var(--color-deep-navy);
    color: {{ section.settings.text_color }};
    {% if section.settings.banner_height == 'small' %}
      padding: 64px 40px;
    {% elsif section.settings.banner_height == 'medium' %}
      padding: 100px 40px;
    {% else %}
      min-height: calc(100vh - var(--header-height));
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 40px;
    {% endif %}
    text-align: center;
    overflow: hidden;
  }

  .collection-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(45,74,106,0.5);
    z-index: 1;
  }

  .collection-banner__content {
    z-index: 2;
    max-width: 720px;
    color: {{ section.settings.text_color }};
    {% if section.settings.banner_height != 'large' %}
      margin: 0 auto;
    {% endif %}
  }

  /* Label: absolutely positioned to top ONLY when banner_height is large */
  .collection-banner__label {
    margin: 0 0 20px;
    {% if section.settings.banner_height == 'large' %}
      position: absolute;
      top: 100px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
    {% else %}
      margin-bottom: 20px;
    {% endif %}
  }

  .collection-banner__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 300;
    margin: 0 0 20px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .collection-banner__description {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.75;
    margin-bottom: 20px;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .collection-banner__count {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    opacity: 0.5;
    margin: 0;
  }

  @media (max-width: 768px) {
    .collection-banner {
      {% if section.settings.banner_height != 'large' %}
        padding: 72px 24px;
      {% else %}
        padding: 0 24px;
      {% endif %}
    }
    .collection-banner__label {
      {% if section.settings.banner_height == 'large' %}
        top: 100px;
      {% else %}
        margin-bottom: 20px;
      {% endif %}
    }
  }

  @media (max-width: 480px) {
    .collection-banner {
      {% if section.settings.banner_height != 'large' %}
        padding: 56px 16px;
      {% else %}
        padding: 0 16px;
      {% endif %}
    }
  }
</style>

<script>
  (function () {
    function shouldShowTransparent() {
      const mode = {{ settings.header_transparent_on | json }};
      if (mode === 'disabled') return false;

      const pageTemplate = document.body.dataset.pageTemplate;

      if (mode === 'all') return true;
      if (mode === pageTemplate) return true;

      return false;
    }

    function init() {
      if (shouldShowTransparent()) {
        document.body.classList.add('hero-page');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "div",
  "class": "collection-banner-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image as background",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label above heading",
      "default": "THE COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use collection title)",
      "default": "Mats designed to belong"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color (no image)",
      "default": "#2D4A6A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Collection Banner",
      "settings": {
        "show_collection_image": true,
        "show_description": true,
        "show_product_count": true,
        "banner_height": "medium",
        "bg_color": "#2D4A6A",
        "label": "THE COLLECTION",
        "heading": "Mats designed to belong"
      }
    }
  ]
}
{% endschema %}
