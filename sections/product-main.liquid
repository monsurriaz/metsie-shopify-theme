</style>

<script>
  (() => {
    if (customElements.get('product-main')) return;

    class ProductMain extends HTMLElement {
      constructor() {
        super();

        this.productData = null;
        this.variants = [];
        this.media = [];
        this.currentVariant = null;
        this.selectedOptions = [];
        this.scrollRaf = null;
        this.addedTextTimer = null;
      }

      connectedCallback() {
        this.readProductData();
        this.cacheDOM();

        if (!this.productData || !this.variants.length) return;

        this.currentVariant = this.getVariantById(this.productData.selectedVariantId) || this.variants[0];
        this.selectedOptions = [...this.currentVariant.options];

        this.bindEvents();
        this.updateVariantUI();
        this.updateAvailabilityStates();
        this.updateProgressFromIndex(0);
      }

      readProductData() {
        const script = this.querySelector('[data-product-json]');
        if (!script) return;

        try {
          this.productData = JSON.parse(script.textContent);
          this.variants = Array.isArray(this.productData.variants) ? this.productData.variants : [];
          this.media = Array.isArray(this.productData.media) ? this.productData.media : [];
        } catch (error) {
          console.error('[ProductMain] Invalid product JSON:', error);
        }
      }

      cacheDOM() {
        this.productForms = [...this.querySelectorAll('[data-product-form]')];
        this.variantInputs = [...this.querySelectorAll('[data-variant-id-input]')];
        this.formQuantityInputs = [...this.querySelectorAll('[data-form-quantity-input]')];

        this.optionButtons = [...this.querySelectorAll('[data-option-button]')];
        this.swatchToggles = [...this.querySelectorAll('[data-swatch-toggle]')];

        this.currentPrice = this.querySelector('[data-current-price]');
        this.comparePrice = this.querySelector('[data-compare-price]');
        this.saleBadge = this.querySelector('[data-sale-badge]');

        this.skuRow = this.querySelector('[data-sku-row]');
        this.skuValue = this.querySelector('[data-sku]');

        this.addToCartButtons = [...this.querySelectorAll('[data-add-to-cart]')];
        this.addToCartTexts = [...this.querySelectorAll('[data-add-to-cart-text]')];

        this.quantityInput = this.querySelector('[data-quantity-input]');
        this.quantityMinus = this.querySelector('[data-quantity-minus]');
        this.quantityPlus = this.querySelector('[data-quantity-plus]');

        this.formMessage = this.querySelector('[data-form-message]');

        this.galleryTrack = this.querySelector('[data-gallery-track]');
        this.mediaItems = [...this.querySelectorAll('[data-media-item]')];
        this.progressFill = this.querySelector('[data-progress-fill]');

        this.accordions = [...this.querySelectorAll('[data-accordion]')];
        this.shareButton = this.querySelector('[data-share-button]');
      }

      bindEvents() {
        this.optionButtons.forEach((button) => {
          button.addEventListener('click', this.onOptionClick.bind(this));
        });

        this.swatchToggles.forEach((button) => {
          button.addEventListener('click', this.onSwatchToggle.bind(this));
        });

        this.productForms.forEach((form) => {
          form.addEventListener('submit', this.onSubmit.bind(this));
        });

        if (this.quantityMinus) {
          this.quantityMinus.addEventListener('click', () => this.changeQuantity(-1));
        }

        if (this.quantityPlus) {
          this.quantityPlus.addEventListener('click', () => this.changeQuantity(1));
        }

        if (this.quantityInput) {
          this.quantityInput.addEventListener('change', () => {
            this.normalizeQuantity();
            this.syncFormQuantityInputs();
          });

          this.quantityInput.addEventListener('input', () => {
            this.syncFormQuantityInputs();
          });
        }

        if (this.galleryTrack) {
          this.galleryTrack.addEventListener('scroll', this.onGalleryScroll.bind(this), { passive: true });
        }

        this.accordions.forEach((accordion) => {
          const trigger = accordion.querySelector('[data-accordion-trigger]');
          if (!trigger) return;

          trigger.addEventListener('click', () => this.toggleAccordion(accordion));
        });

        if (this.shareButton) {
          this.shareButton.addEventListener('click', this.shareProduct.bind(this));
        }
      }

      onOptionClick(event) {
        const button = event.currentTarget;
        const optionIndex = Number(button.dataset.optionIndex);
        const optionValue = button.dataset.optionValue;

        this.selectedOptions[optionIndex] = optionValue;

        const matchedVariant = this.findVariantByOptions(this.selectedOptions);

        if (!matchedVariant) {
          this.currentVariant = null;
          this.updateOptionButtonSelection();
          this.updateAvailabilityStates();
          this.syncVariantInputs(null);
          this.setAddToCartState('unavailable');
          this.clearMessage();
          return;
        }

        this.currentVariant = matchedVariant;

        this.updateVariantUI();
        this.updateAvailabilityStates();
        this.updateURL();
        this.syncMediaToVariant();
        this.clearMessage();

        this.dispatchEvent(
          new CustomEvent('variant:change', {
            bubbles: true,
            detail: {
              variant: this.currentVariant
            }
          })
        );
      }

      onSwatchToggle(event) {
        const button = event.currentTarget;
        const grid = button.closest('[data-swatch-grid]');
        if (!grid) return;

        const expanded = grid.dataset.expanded === 'true';
        grid.dataset.expanded = String(!expanded);
        button.setAttribute('aria-expanded', String(!expanded));
      }

      findVariantByOptions(options) {
        return this.variants.find((variant) => {
          return variant.options.every((value, index) => value === options[index]);
        });
      }

      findPartialVariant(options) {
        return this.variants.find((variant) => {
          return options.every((value, index) => {
            return value === null || value === undefined || value === variant.options[index];
          });
        });
      }

      getVariantById(id) {
        return this.variants.find((variant) => Number(variant.id) === Number(id));
      }

      updateVariantUI() {
        if (!this.currentVariant) return;

        this.selectedOptions = [...this.currentVariant.options];

        this.syncVariantInputs(this.currentVariant.id);
        this.syncFormQuantityInputs();

        this.updateOptionButtonSelection();
        this.updatePrice();
        this.updateSku();

        this.setAddToCartState(this.currentVariant.available ? 'available' : 'sold-out');
      }

      syncVariantInputs(variantId) {
        this.variantInputs.forEach((input) => {
          input.value = variantId || '';
        });
      }

      syncFormQuantityInputs() {
        const quantity = this.getQuantity();

        this.formQuantityInputs.forEach((input) => {
          input.value = quantity;
        });
      }

      updateOptionButtonSelection() {
        this.optionButtons.forEach((button) => {
          const optionIndex = Number(button.dataset.optionIndex);
          const isSelected = this.selectedOptions[optionIndex] === button.dataset.optionValue;

          button.classList.toggle('is-selected', isSelected);
          button.setAttribute('aria-pressed', String(isSelected));
        });
      }

      updateAvailabilityStates() {
        this.optionButtons.forEach((button) => {
          const optionIndex = Number(button.dataset.optionIndex);
          const attemptedOptions = [...this.selectedOptions];

          attemptedOptions[optionIndex] = button.dataset.optionValue;

          const matchingVariant = this.findVariantByOptions(attemptedOptions);
          const hasVariant = Boolean(matchingVariant);
          const isSoldOut = hasVariant && !matchingVariant.available;
          const isUnavailable = !hasVariant;

          button.classList.toggle('is-sold-out', isSoldOut);
          button.classList.toggle('is-unavailable', isUnavailable);

          button.setAttribute('aria-disabled', String(isUnavailable));
          button.setAttribute('data-variant-state', isUnavailable ? 'unavailable' : isSoldOut ? 'sold-out' : 'available');
        });
      }

      updatePrice() {
        if (!this.currentPrice || !this.currentVariant) return;

        this.currentPrice.textContent = this.formatMoney(this.currentVariant.price);

        const hasComparePrice =
          this.currentVariant.compare_at_price &&
          this.currentVariant.compare_at_price > this.currentVariant.price;

        if (this.comparePrice) {
          this.comparePrice.hidden = !hasComparePrice;
          this.comparePrice.textContent = hasComparePrice
            ? this.formatMoney(this.currentVariant.compare_at_price)
            : '';
        }

        if (this.saleBadge) {
          this.saleBadge.hidden = !hasComparePrice;
        }
      }

      updateSku() {
        if (!this.skuRow || !this.skuValue || !this.currentVariant) return;

        const hasSku = Boolean(this.currentVariant.sku);

        this.skuRow.hidden = !hasSku;
        this.skuValue.textContent = hasSku ? this.currentVariant.sku : '';
      }

      setAddToCartState(state) {
        this.addToCartButtons.forEach((button) => {
          const textEl = button.querySelector('[data-add-to-cart-text]');
          const addText = button.dataset.addText || 'ADD TO CART';
          const soldOutText = button.dataset.soldOutText || 'Sold out';
          const unavailableText = button.dataset.unavailableText || 'Unavailable';

          if (state === 'available') {
            button.disabled = false;
            if (textEl) textEl.textContent = addText;
            return;
          }

          button.disabled = true;

          if (textEl) {
            textEl.textContent = state === 'sold-out' ? soldOutText : unavailableText;
          }
        });
      }

      setLoading(isLoading) {
        this.addToCartButtons.forEach((button) => {
          const textEl = button.querySelector('[data-add-to-cart-text]');
          const addText = button.dataset.addText || 'ADD TO CART';
          const addingText = button.dataset.addingText || 'Adding...';
          const soldOutText = button.dataset.soldOutText || 'Sold out';

          button.disabled = isLoading || !this.currentVariant?.available;

          if (textEl) {
            textEl.textContent = isLoading
              ? addingText
              : this.currentVariant?.available
                ? addText
                : soldOutText;
          }
        });
      }

      showAddedState() {
        if (this.addedTextTimer) {
          clearTimeout(this.addedTextTimer);
        }

        this.addToCartButtons.forEach((button) => {
          const textEl = button.querySelector('[data-add-to-cart-text]');
          const addedText = button.dataset.addedText || 'Added';
          const addText = button.dataset.addText || 'ADD TO CART';

          if (textEl) {
            textEl.textContent = addedText;
          }

          button.disabled = false;

          this.addedTextTimer = setTimeout(() => {
            if (!this.currentVariant?.available) return;

            if (textEl) {
              textEl.textContent = addText;
            }
          }, 1800);
        });
      }

      updateURL() {
        if (!this.currentVariant || !window.history) return;

        const url = new URL(window.location.href);
        url.searchParams.set('variant', this.currentVariant.id);

        window.history.replaceState({}, '', url.toString());
      }

      syncMediaToVariant() {
        if (!this.currentVariant || !this.currentVariant.featured_media_id) return;

        this.setActiveMedia(this.currentVariant.featured_media_id);
      }

      setActiveMedia(mediaId) {
        const mediaItem = this.mediaItems.find((item) => {
          return Number(item.dataset.mediaId) === Number(mediaId);
        });

        if (!mediaItem) return;

        const mediaIndex = Number(mediaItem.dataset.mediaIndex || 0);

        if (this.isMobile()) {
          this.scrollMobileGalleryToIndex(mediaIndex);
          this.updateProgressFromIndex(mediaIndex);
        } else {
          mediaItem.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      }

      scrollMobileGalleryToIndex(index) {
        if (!this.galleryTrack || !this.mediaItems[index]) return;

        const target = this.mediaItems[index];

        this.galleryTrack.scrollTo({
          left: target.offsetLeft,
          behavior: 'smooth'
        });
      }

      onGalleryScroll() {
        if (!this.isMobile()) return;

        if (this.scrollRaf) {
          cancelAnimationFrame(this.scrollRaf);
        }

        this.scrollRaf = requestAnimationFrame(() => {
          const index = this.getCurrentMobileMediaIndex();
          this.updateProgressFromIndex(index);
        });
      }

      getCurrentMobileMediaIndex() {
        if (!this.galleryTrack || !this.mediaItems.length) return 0;

        const scrollLeft = this.galleryTrack.scrollLeft;
        const width = this.galleryTrack.clientWidth;

        if (!width) return 0;

        return Math.round(scrollLeft / width);
      }

      updateProgressFromIndex(index) {
        if (!this.progressFill || !this.mediaItems.length) return;

        const total = this.mediaItems.length;
        const safeIndex = Math.min(Math.max(index, 0), total - 1);
        const progress = ((safeIndex + 1) / total) * 100;

        this.progressFill.style.width = `${progress}%`;
      }

      changeQuantity(amount) {
        if (!this.quantityInput) return;

        const current = Number(this.quantityInput.value || 1);
        const min = Number(this.quantityInput.min || 1);
        const max = Number(this.quantityInput.max || 99);
        const next = Math.min(Math.max(current + amount, min), max);

        this.quantityInput.value = next;
        this.syncFormQuantityInputs();
      }

      normalizeQuantity() {
        if (!this.quantityInput) return;

        const min = Number(this.quantityInput.min || 1);
        const max = Number(this.quantityInput.max || 99);
        const value = Number(this.quantityInput.value || min);

        this.quantityInput.value = Math.min(Math.max(value, min), max);
      }

      getQuantity() {
        if (!this.quantityInput) return 1;

        const value = Number(this.quantityInput.value || 1);
        const min = Number(this.quantityInput.min || 1);
        const max = Number(this.quantityInput.max || 99);

        return Math.min(Math.max(value, min), max);
      }

      async onSubmit(event) {
        event.preventDefault();

        if (!this.currentVariant) {
          this.showMessage('Please select an available option.', 'error');
          return;
        }

        if (!this.currentVariant.available) {
          this.showMessage('This variant is sold out.', 'error');
          return;
        }

        const form = event.currentTarget;
        const quantity = this.getQuantity();

        this.syncVariantInputs(this.currentVariant.id);
        this.syncFormQuantityInputs();

        this.setLoading(true);
        this.clearMessage();

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Accept': 'application/json'
            },
            body: new FormData(form)
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.description || data.message || 'Unable to add item to cart.');
          }

          // this.showMessage('Added to cart.', 'success');

          this.showAddedState();

          // Cart drawer and cart count update
          if (window.Metsie?.CartDrawer) {
            await window.Metsie.CartDrawer.updateCartCount();
            window.Metsie.CartDrawer.open();
          }
        } catch (error) {
          this.showMessage(error.message || 'Unable to add item to cart.', 'error');
        } finally {
          if (!this.currentVariant?.available) {
            this.setLoading(false);
          }
        }
      }

      showMessage(message, type) {
        if (!this.formMessage) return;

        this.formMessage.hidden = false;
        this.formMessage.textContent = message;
        this.formMessage.classList.toggle('is-error', type === 'error');
        this.formMessage.classList.toggle('is-success', type === 'success');
      }

      clearMessage() {
        if (!this.formMessage) return;

        this.formMessage.hidden = true;
        this.formMessage.textContent = '';
        this.formMessage.classList.remove('is-error', 'is-success');
      }

      toggleAccordion(accordion) {
        const isOpen = accordion.classList.contains('is-open');
        const trigger = accordion.querySelector('[data-accordion-trigger]');

        accordion.classList.toggle('is-open', !isOpen);

        if (trigger) {
          trigger.setAttribute('aria-expanded', String(!isOpen));
        }
      }

      async shareProduct() {
        const shareData = {
          title: document.title,
          url: window.location.href
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (error) {}
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(window.location.href);
          this.showMessage('Product link copied.', 'success');
        }
      }

      formatMoney(cents) {
        const moneyFormat = this.productData?.moneyFormat || '{{ amount }}';

        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, moneyFormat);
        }

        const value = Number(cents || 0) / 100;

        const formatWithDelimiters = (
          number,
          precision = 2,
          thousands = ',',
          decimal = '.'
        ) => {
          if (Number.isNaN(number) || number == null) {
            return '0';
          }

          const fixed = number.toFixed(precision);
          const parts = fixed.split('.');
          const dollars = parts[0].replace(
            /(\d)(?=(\d\d\d)+(?!\d))/g,
            `$1${thousands}`
          );
          const centsPart = parts[1] ? decimal + parts[1] : '';

          return dollars + centsPart;
        };

        const replacements = {
          amount: formatWithDelimiters(value, 2),
          amount_no_decimals: formatWithDelimiters(value, 0),
          amount_with_comma_separator: formatWithDelimiters(value, 2, '.', ','),
          amount_no_decimals_with_comma_separator: formatWithDelimiters(value, 0, '.', ','),
          amount_with_apostrophe_separator: formatWithDelimiters(value, 2, "'", '.')
        };

        return moneyFormat.replace(
          /\{\{\s*(amount|amount_no_decimals|amount_with_comma_separator|amount_no_decimals_with_comma_separator|amount_with_apostrophe_separator)\s*\}\}/g,
          (match, token) => replacements[token]
        );
      }

      isMobile() {
        return window.matchMedia('(max-width: 767px)').matches;
      }
    }

    customElements.define('product-main', ProductMain);
  })();
</script>

