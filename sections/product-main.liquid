{% liquid
  assign current_variant = product.selected_or_first_available_variant

  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank and product.collections.size > 0
    assign breadcrumb_collection = product.collections.first
  endif
%}

<product-main
  class="product-main"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
>
  <div class="container product-main__container">

    <nav class="product-main__breadcrumb" aria-label="Breadcrumb">
      {% if breadcrumb_collection != blank %}
        <a href="{{ breadcrumb_collection.url }}" class="product-main__breadcrumb-link">
          {{ breadcrumb_collection.title }}
        </a>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}" class="product-main__breadcrumb-link">
          Catalog
        </a>
      {% endif %}

      <span class="product-main__breadcrumb-separator" aria-hidden="true">/</span>

      <span class="product-main__breadcrumb-current">
        {{ product.title }}
      </span>
    </nav>

    <div class="product-main__layout">

      <div class="product-main__media-column">
        <div class="product-main__gallery" data-gallery>
          <div class="product-main__gallery-track" data-gallery-track>
            {% for media in product.media %}
              <div
                class="product-main__media-item"
                data-media-item
                data-media-id="{{ media.id }}"
                data-media-index="{{ forloop.index0 }}"
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {{
                      media
                      | image_url: width: 1800
                      | image_tag:
                        class: 'product-main__image',
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000, 1200, 1600, 1800',
                        sizes: '(min-width: 990px) 55vw, 100vw'
                    }}

                  {% when 'video' %}
                    <video
                      class="product-main__video"
                      controls
                      playsinline
                      muted
                      preload="metadata"
                      {% if section.settings.autoplay_videos %}autoplay{% endif %}
                    >
                      {% for source in media.sources %}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {% endfor %}
                    </video>

                  {% when 'external_video' %}
                    <div class="product-main__external-video">
                      {{ media | external_video_tag }}
                    </div>

                  {% when 'model' %}
                    <div class="product-main__model">
                      {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                    </div>
                {% endcase %}
              </div>
            {% endfor %}
          </div>

          {% if product.media.size > 1 %}
            <div class="product-main__progress" aria-hidden="true">
              <div class="product-main__progress-fill" data-progress-fill></div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="product-main__info-column">
        <div class="product-main__form-message" data-form-message hidden></div>

        {% for block in section.blocks %}
          {% case block.type %}

            {% when 'title' %}
              <div class="product-main__block product-main__title-block" {{ block.shopify_attributes }}>
                {% if block.settings.show_vendor %}
                  <div class="product-main__eyebrow">
                    {{ product.vendor }}
                    {% if breadcrumb_collection != blank %}
                      <span aria-hidden="true">—</span>
                      {{ breadcrumb_collection.title }}
                    {% endif %}
                  </div>
                {% endif %}

                <h1 class="product-main__title">
                  {{ product.title }}
                </h1>

                {% if block.settings.show_rating %}
                  <div class="product-main__rating" data-rating-app></div>
                {% endif %}
              </div>

            {% when 'price' %}
              <div class="product-main__block product-main__price-block" {{ block.shopify_attributes }}>
                <div class="product-main__price-group" data-price-wrapper>
                  <span
                    class="product-main__compare-price"
                    data-compare-price
                    {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
                  >
                    {% if current_variant.compare_at_price > current_variant.price %}
                      {{ current_variant.compare_at_price | money }}
                    {% endif %}
                  </span>

                  <span class="product-main__current-price" data-current-price>
                    {{ current_variant.price | money }}
                  </span>

                  <span
                    class="product-main__sale-badge"
                    data-sale-badge
                    {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
                  >
                    {{ block.settings.sale_badge_text }}
                  </span>
                </div>
              </div>

            {% when 'variant_picker' %}
              {% unless product.has_only_default_variant %}
                <div
                  class="product-main__block product-main__variant-picker"
                  data-variant-picker
                  {{ block.shopify_attributes }}
                >
                  {% for option in product.options_with_values %}
                    {% liquid
                      assign option_index_zero = option.position | minus: 1
                      assign option_key = 'option' | append: option.position
                      assign option_name_downcase = option.name | downcase
                      assign color_option_name_downcase = block.settings.color_option_name | downcase

                      assign is_color_option = false
                      if option_name_downcase == color_option_name_downcase
                        assign is_color_option = true
                      endif

                      assign option_value_count = option.values | size
                    %}

                    <div
                      class="product-main__option-group"
                      data-option-group
                      data-option-index="{{ option_index_zero }}"
                      data-option-name="{{ option.name | escape }}"
                      data-is-color-option="{{ is_color_option }}"
                    >
                      {% if block.settings.show_option_labels %}
                        <div class="product-main__option-header">
                          <span class="product-main__option-label">
                            {{ option.name }}
                          </span>
                        </div>
                      {% endif %}

                      {% if is_color_option %}
                        <div
                          class="product-main__swatch-grid"
                          data-swatch-grid
                          data-expanded="false"
                          role="radiogroup"
                          aria-label="{{ option.name | escape }}"
                        >
                          {% for value in option.values %}
                            {% liquid
                              assign swatch_variant = nil

                              for variant in product.variants
                                if variant[option_key] == value and variant.featured_media != blank
                                  assign swatch_variant = variant
                                  break
                                endif
                              endfor

                              if swatch_variant == nil
                                for variant in product.variants
                                  if variant[option_key] == value
                                    assign swatch_variant = variant
                                    break
                                  endif
                                endfor
                              endif

                              assign is_selected = false
                              if current_variant[option_key] == value
                                assign is_selected = true
                              endif

                              assign is_extra = false
                              if forloop.index > 3
                                assign is_extra = true
                              endif
                            %}

                            <button
                              type="button"
                              class="product-main__swatch{% if is_selected %} is-selected{% endif %}{% if is_extra %} is-extra{% endif %}"
                              data-option-button
                              data-option-index="{{ option_index_zero }}"
                              data-option-value="{{ value | escape }}"
                              data-media-id="{% if swatch_variant and swatch_variant.featured_media %}{{ swatch_variant.featured_media.id }}{% endif %}"
                              aria-label="{{ option.name | escape }}: {{ value | escape }}"
                              aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
                            >
                              {% if block.settings.show_swatch_images and swatch_variant and swatch_variant.featured_media.preview_image %}
                                {{
                                  swatch_variant.featured_media.preview_image
                                  | image_url: width: 280
                                  | image_tag:
                                    class: 'product-main__swatch-image',
                                    loading: 'lazy',
                                    alt: value
                                }}
                              {% elsif block.settings.swatch_fallback_to_css %}
                                <span class="product-main__swatch-fallback">
                                  {{ value }}
                                </span>
                              {% else %}
                                <span class="product-main__swatch-text">
                                  {{ value }}
                                </span>
                              {% endif %}
                            </button>
                          {% endfor %}

                          {% if option_value_count > 3 %}
                            <button
                              type="button"
                              class="product-main__swatch product-main__swatch-more"
                              data-swatch-toggle
                              aria-expanded="false"
                              aria-label="Show remaining {{ option_value_count | minus: 3 }} {{ option.name | escape }} options"
                            >
                              +{{ option_value_count | minus: 3 }}
                            </button>
                          {% endif %}
                        </div>
                      {% else %}
                        <div
                          class="product-main__pill-group"
                          role="radiogroup"
                          aria-label="{{ option.name | escape }}"
                        >
                          {% for value in option.values %}
                            {% liquid
                              assign is_selected = false
                              if current_variant[option_key] == value
                                assign is_selected = true
                              endif
                            %}

                            <button
                              type="button"
                              class="product-main__pill{% if is_selected %} is-selected{% endif %}"
                              data-option-button
                              data-option-index="{{ option_index_zero }}"
                              data-option-value="{{ value | escape }}"
                              aria-label="{{ option.name | escape }}: {{ value | escape }}"
                              aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
                            >
                              {{ value }}
                            </button>
                          {% endfor %}
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              {% endunless %}

            {% when 'quantity_selector' %}
              <div class="product-main__block product-main__quantity-block" {{ block.shopify_attributes }}>
                {% if block.settings.show_label %}
                  <label class="product-main__option-label" for="Quantity-{{ section.id }}">
                    {{ 'products.product.quantity' | t }}
                  </label>
                {% endif %}

                <div class="product-main__quantity-selector">
                  <button
                    type="button"
                    class="product-main__quantity-btn"
                    data-quantity-minus
                    aria-label="Decrease quantity"
                  >
                    <svg width="14" height="2" viewBox="0 0 14 2" fill="currentColor" aria-hidden="true">
                      <rect y="0" width="14" height="2"></rect>
                    </svg>
                  </button>

                  <input
                    id="Quantity-{{ section.id }}"
                    type="number"
                    class="product-main__quantity-input"
                    value="1"
                    min="1"
                    max="{{ block.settings.max_quantity }}"
                    data-quantity-input
                    aria-label="Quantity"
                  >

                  <button
                    type="button"
                    class="product-main__quantity-btn"
                    data-quantity-plus
                    aria-label="Increase quantity"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                      <rect x="6" y="0" width="2" height="14"></rect>
                      <rect y="6" width="14" height="2"></rect>
                    </svg>
                  </button>
                </div>
              </div>

            {% when 'buy_buttons' %}
              <div class="product-main__block product-main__buy-buttons-block" {{ block.shopify_attributes }}>
                {% assign product_form_id = 'product-form-' | append: section.id %}

                {% form 'product', product, id: product_form_id, class: 'product-main__form', data-product-form: '' %}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ current_variant.id }}"
                    data-variant-id-input
                  >

                  <input
                    type="hidden"
                    name="quantity"
                    value="1"
                    data-form-quantity-input
                  >

                  <button
                    type="submit"
                    class="product-main__add-to-cart"
                    data-add-to-cart
                    data-add-text="{% if block.settings.add_to_cart_text != blank %}{{ block.settings.add_to_cart_text | escape }}{% else %}{{ 'products.product.add_to_cart' | t | escape }}{% endif %}"
                    data-sold-out-text="{% if block.settings.sold_out_text != blank %}{{ block.settings.sold_out_text | escape }}{% else %}{{ 'products.product.sold_out' | t | escape }}{% endif %}"
                    data-unavailable-text="{% if block.settings.unavailable_text != blank %}{{ block.settings.unavailable_text | escape }}{% else %}{{ 'products.product.unavailable' | t | escape }}{% endif %}"
                    data-adding-text="{{ 'products.product.adding' | t | escape }}"
                    data-added-text="{{ 'products.product.added' | t | escape }}"
                    data-adding-text="{{ 'products.product.adding' | t }}"
                    data-added-text="{{ 'products.product.added' | t }}"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-to-cart-text>
                      {% if current_variant.available %}
                        {% if block.settings.add_to_cart_text != blank %}
                          {{ block.settings.add_to_cart_text }}
                        {% else %}
                          {{ 'products.product.add_to_cart' | t }}
                        {% endif %}
                      {% else %}
                        {% if block.settings.sold_out_text != blank %}
                          {{ block.settings.sold_out_text }}
                        {% else %}
                          {{ 'products.product.sold_out' | t }}
                        {% endif %}
                      {% endif %}
                    </span>
                  </button>

                  {% if block.settings.show_payment_button %}
                    <div class="product-main__payment-button">
                      {{ form | payment_button }}
                    </div>
                  {% endif %}
                {% endform %}
              </div>

            {% when 'description' %}
              {% if block.settings.show_description and product.description != blank %}
                <div class="product-main__block product-main__description-block" {{ block.shopify_attributes }}>
                  {% if block.settings.truncate_description %}
                    {{ product.description | strip_html | truncate: block.settings.truncate_length }}
                  {% else %}
                    {{ product.description }}
                  {% endif %}
                </div>
              {% endif %}

            {% when 'product_meta' %}
              <div class="product-main__block product-main__meta-block" {{ block.shopify_attributes }}>
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <div class="product-main__meta-item">
                    <span class="product-main__meta-label">Vendor</span>
                    <span class="product-main__meta-value">{{ product.vendor }}</span>
                  </div>
                {% endif %}

                {% if block.settings.show_sku %}
                  <div
                    class="product-main__meta-item"
                    data-sku-row
                    {% if current_variant.sku == blank %}hidden{% endif %}
                  >
                    <span class="product-main__meta-label">SKU</span>
                    <span class="product-main__meta-value" data-sku>
                      {{ current_variant.sku }}
                    </span>
                  </div>
                {% endif %}

                {% if block.settings.show_collections and product.collections.size > 0 %}
                  <div class="product-main__meta-item">
                    <span class="product-main__meta-label">Collections</span>
                    <span class="product-main__meta-value">
                      {{ product.collections | map: 'title' | join: ', ' }}
                    </span>
                  </div>
                {% endif %}
              </div>

            {% when 'trust_badges' %}
              <div class="product-main__block product-main__trust-badges" {{ block.shopify_attributes }}>
                {% if block.settings.badge_1 != blank %}
                  <div class="product-main__badge">{{ block.settings.badge_1 }}</div>
                {% endif %}
                {% if block.settings.badge_2 != blank %}
                  <div class="product-main__badge">{{ block.settings.badge_2 }}</div>
                {% endif %}
                {% if block.settings.badge_3 != blank %}
                  <div class="product-main__badge">{{ block.settings.badge_3 }}</div>
                {% endif %}
              </div>

            {% when 'share' %}
              {% if block.settings.show_share %}
                <div class="product-main__block product-main__share" {{ block.shopify_attributes }}>
                  <button type="button" class="product-main__share-button" data-share-button>
                    {{ block.settings.share_text }}
                  </button>
                </div>
              {% endif %}

            {% when 'accordion' %}
              <div
                class="product-main__block product-main__accordion{% if block.settings.open_by_default %} is-open{% endif %}"
                data-accordion
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="product-main__accordion-trigger"
                  data-accordion-trigger
                  aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
                  aria-controls="Accordion-{{ section.id }}-{{ block.id }}"
                >
                  <span class="product-main__accordion-title">
                    {{ block.settings.heading }}
                  </span>

                  <span class="product-main__accordion-icon" aria-hidden="true"></span>
                </button>

                <div
                  id="Accordion-{{ section.id }}-{{ block.id }}"
                  class="product-main__accordion-panel"
                  data-accordion-panel
                >
                  <div class="product-main__accordion-content">
                    {{ block.settings.content }}
                  </div>
                </div>
              </div>

            {% when 'custom_liquid' %}
              <div class="product-main__block product-main__custom-liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_html }}
              </div>

            {% when '@app' %}
              <div class="product-main__block product-main__app-block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "handle": {{ product.handle | json }},
      "url": {{ product.url | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "selectedVariantId": {{ current_variant.id | json }},
      "options": {{ product.options | json }},
      "variants": [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "title": {{ variant.title | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "sku": {{ variant.sku | json }},
            "options": {{ variant.options | json }},
            "option1": {{ variant.option1 | json }},
            "option2": {{ variant.option2 | json }},
            "option3": {{ variant.option3 | json }},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "media": [
        {% for media in product.media %}
          {
            "id": {{ media.id | json }},
            "position": {{ media.position | json }},
            "media_type": {{ media.media_type | json }},
            "alt": {{ media.alt | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
</product-main>

<style>
  .product-main {
    display: block;
    background: var(--color-white);
    color: var(--color-near-black);
  }

  .product-main__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-10) 0 var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--lh-normal);
    text-transform: uppercase;
  }

  .product-main__breadcrumb-link,
  .product-main__breadcrumb-separator {
    color: var(--color-near-black);
    opacity: 0.4;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .product-main__breadcrumb-link:hover {
    color: var(--color-near-black);
    opacity: 1;
  }
  
  .product-main__breadcrumb-current {
    color: var(--color-near-black);
  }

  .product-main__layout {
    display: grid;
    grid-template-columns: minmax(0, 54.2%) minmax(360px, 1fr);
    gap: var(--space-18);
    align-items: start;
  }

  .product-main__media-column {
    min-width: 0;
  }

  .product-main__gallery {
    position: relative;
  }

  .product-main__gallery-track {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .product-main__media-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 720px;
    aspect-ratio: 1/1.21;
    background: var(--color-light-gray);
    overflow: hidden;
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
  }

  .product-main__image,
  .product-main__video,
  .product-main__external-video,
  .product-main__model {
    width: 100%;
    height: 100%;
  }

  .product-main__image {
    display: block;
    object-fit: cover;
  }

  .product-main__video {
    object-fit: contain;
  }

  .product-main__info-column {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    min-width: 0;
  }

  .product-main__block {
    margin-bottom: var(--space-6);
  }

  .product-main__title-block {
    margin-bottom: var(--space-4);
  }

  .product-main__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-light);
    line-height: var(--lh-relaxed);
    color: var(--color-near-black);
    opacity: 0.4;
    text-transform: uppercase;
  }

  .product-main__title {
    font-family: var(--font-heading);
    font-size: calc(var(--text-3xl) * var(--font-heading-scale));
    font-weight: var(--font-weight-medium);
    line-height: var(--lh-tight);
    color: var(--color-near-black);
    letter-spacing: 0.02em;
    margin: var(--space-2) 0 0;
  }

  .product-main__price-block {
    margin-bottom: var(--space-6);
  }

  .product-main__price-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--lh-normal);
  }

  .product-main__current-price {
    color: var(--color-near-black);
  }

  .product-main__compare-price {
    color: var(--color-navy-mid);
    text-decoration: line-through;
  }

  .product-main__sale-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    background: var(--color-error);
    color: var(--color-white);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .product-main__option-group + .product-main__option-group {
    margin-top: var(--space-4);
  }

  .product-main__option-header {
    margin-bottom: var(--space-2);
  }

  .product-main__option-label {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--lh-normal);
    color: var(--color-near-black);
    text-transform: uppercase;
  }

  .product-main__swatch-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
    overflow: hidden;
    transition: max-height var(--transition-base);
  }

  .product-main__swatch-grid[data-expanded="false"] {
    max-height: 136px;
  }

  .product-main__swatch-grid[data-expanded="true"] {
    max-height: 760px;
  }

  .product-main__swatch {
    position: relative;
    aspect-ratio: 5/6;
    min-height: 0;
    padding: 0;
    border: 1px solid transparent;
    background: #f6f6f6;
    color: var(--color-near-black);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--transition-fast), opacity var(--transition-fast);
  }

  .product-main__swatch.is-extra {
    display: none;
  }

  .product-main__swatch-grid[data-expanded="true"] .product-main__swatch.is-extra {
    display: block;
  }

  .product-main__swatch.is-selected {
    border-color: var(--color-near-black);
  }

  .product-main__swatch.is-sold-out,
  .product-main__swatch.is-unavailable,
  .product-main__pill.is-sold-out,
  .product-main__pill.is-unavailable {
    opacity: 0.45;
  }

  .product-main__swatch.is-unavailable::after,
  .product-main__pill.is-unavailable::after {
    content: '';
  }

  .product-main__swatch-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: var(--space-2);
  }

  .product-main__swatch-fallback,
  .product-main__swatch-text {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
