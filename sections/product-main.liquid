<section class="product-main" data-section-id="{{ section.id }}" x-data="productMain()">
  <div class="product-main__inner">

    {%- comment -%} ========== LEFT: Image Gallery (60%) ========== {%- endcomment -%}
    <div class="product-main__gallery">

      {%- comment -%} Thumbnail column {%- endcomment -%}
      {% if product.images.size > 1 %}
        <div class="gallery-thumbs">
          {% for image in product.images %}
            <button
              class="gallery-thumbs__item"
              :class="{ 'is-active': activeImage === {{ forloop.index0 }} }"
              @click="activeImage = {{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ image | img_url: '120x' }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="120"
                height="120"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} Main image display {%- endcomment -%}
      <div class="gallery-main">
        {% for image in product.images %}
          <div
            class="gallery-main__slide"
            x-show="activeImage === {{ forloop.index0 }}"
            x-transition:enter="gallery-enter"
            x-transition:enter-start="gallery-enter-start"
            x-transition:enter-end="gallery-enter-end"
          >
            <img
              src="{{ image | img_url: '1000x' }}"
              srcset="{{ image | img_url: '600x' }} 600w, {{ image | img_url: '900x' }} 900w, {{ image | img_url: '1200x' }} 1200w"
              sizes="(max-width: 768px) 100vw, 60vw"
              alt="{{ image.alt | default: product.title | escape }}"
              width="1000"
              height="1200"
              {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
              class="gallery-main__image"
            >
          </div>
        {% else %}
          <div class="gallery-main__slide gallery-main__slide--placeholder">
            {{ product | img_url: '1000x' | default: 'product-1' | placeholder_svg_tag: 'gallery-main__placeholder' }}
          </div>
        {% endfor %}

        {%- comment -%} Mobile swipe indicators {%- endcomment -%}
        {% if product.images.size > 1 %}
          <div class="gallery-main__dots" aria-hidden="true">
            {% for image in product.images %}
              <span class="gallery-dot" :class="{ 'is-active': activeImage === {{ forloop.index0 }} }"></span>
            {% endfor %}
          </div>
        {% endif %}
      </div>

    </div>

    {%- comment -%} ========== RIGHT: Product Info (40%) ========== {%- endcomment -%}
    <div class="product-main__info">

      {%- comment -%} Breadcrumb / Vendor {%- endcomment -%}
      {% if section.settings.show_vendor and product.vendor != blank %}
        <p class="product-main__vendor">{{ product.vendor | upcase }}</p>
      {% endif %}

      {%- comment -%} Title — serif font {%- endcomment -%}
      <h1 class="product-main__title">{{ product.title }}</h1>

      {%- comment -%} Product form {%- endcomment -%}
      {% form 'product', product, id: 'product-form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" :value="selectedVariantId" x-ref="variantId">

        {%- comment -%} Color swatches — BEFORE price {%- endcomment -%}
        {% assign color_option = product.options_with_values | where: 'name', 'Color' | first %}
        {% unless color_option == null %}
          <div class="product-main__option" data-option-index="{{ color_option.position | minus: 1 }}">
            <div class="product-main__option-header">
              <span class="product-main__option-label">COLOR</span>
              <span class="product-main__option-value" x-text="selectedColor">{{ color_option.selected_value }}</span>
            </div>
            <div class="color-swatches" role="radiogroup" aria-label="Select color">
              {% for value in color_option.values %}
                {% assign color_lower = value | downcase | replace: ' ', '-' %}
                <label
                  class="color-swatch"
                  title="{{ value }}"
                  :class="{ 'is-active': selectedColor === '{{ value }}' }"
                >
                  <input
                    type="radio"
                    name="option{{ color_option.position }}"
                    value="{{ value }}"
                    class="visually-hidden"
                    @change="updateColor('{{ value }}')"
                    {% if color_option.selected_value == value %}checked{% endif %}
                  >
                  <span
                    class="color-swatch__circle"
                    style="background-color: {{ color_lower | replace: 'cream', '#F5F0E8' | replace: 'espresso', '#2B1F18' | replace: 'navy', '#2D4A6A' | replace: 'white', '#FFFFFF' | replace: 'light-gray', '#E8E8E4' }};"
                    aria-hidden="true"
                  ></span>
                  <span class="visually-hidden">{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          </div>
        {% endunless %}

        {%- comment -%} Price — displayed AFTER color swatches {%- endcomment -%}
        <div class="product-main__price" id="price-{{ section.id }}">
          {% if product.compare_at_price > product.price %}
            <span class="product-main__price--sale">{{ product.price | divided_by: 100 }}€</span>
            <span class="product-main__price--compare">{{ product.compare_at_price | divided_by: 100 }}€</span>
            <span class="product-main__badge">SALE</span>
          {% else %}
            <span class="product-main__price--regular">{{ product.price | divided_by: 100 }}€</span>
          {% endif %}
        </div>

        {%- comment -%} Short description {%- endcomment -%}
        {% if product.description != blank %}
          <div class="product-main__description">
            {{ product.description | strip_html | truncate: 200 }}
          </div>
        {% endif %}

        {%- comment -%} Size / variant selector {%- endcomment -%}
        {% for option in product.options_with_values %}
          {% unless option.name == 'Color' %}
            <div class="product-main__option">
              <div class="product-main__option-header">
                <span class="product-main__option-label">{{ option.name | upcase }}</span>
              </div>
              <div class="variant-options" role="radiogroup" aria-label="Select {{ option.name }}">
                {% for value in option.values %}
                  <label
                    class="variant-option"
                    :class="{ 'is-active': selectedOptions[{{ forloop.parentloop.index0 }}] === '{{ value }}' }"
                  >
                    <input
                      type="radio"
                      name="option{{ option.position }}"
                      value="{{ value }}"
                      class="visually-hidden"
                      @change="updateOption({{ forloop.parentloop.index0 }}, '{{ value }}')"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    {{ value }}
                  </label>
                {% endfor %}
              </div>
            </div>
          {% endunless %}
        {% endfor %}

        {%- comment -%} Quantity selector {%- endcomment -%}
        <div class="product-main__quantity">
          <span class="product-main__option-label">QUANTITY</span>
          <div class="quantity-selector">
            <button
              type="button"
              class="quantity-selector__btn"
              @click="quantity = Math.max(1, quantity - 1)"
              :disabled="quantity <= 1"
              aria-label="Decrease quantity"
            >
              <svg width="14" height="2" viewBox="0 0 14 2" fill="currentColor" aria-hidden="true">
                <rect y="0" width="14" height="2"/>
              </svg>
            </button>
            <input
              type="number"
              name="quantity"
              class="quantity-selector__input"
              :value="quantity"
              x-model="quantity"
              min="1"
              max="99"
              aria-label="Quantity"
            >
            <button
              type="button"
              class="quantity-selector__btn"
              @click="quantity = Math.min(99, quantity + 1)"
              aria-label="Increase quantity"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                <rect x="6" y="0" width="2" height="14"/>
                <rect y="6" width="14" height="2"/>
              </svg>
            </button>
          </div>
        </div>

        {%- comment -%} Add to cart button {%- endcomment -%}
        <div class="product-main__cta-group">
          <button
            type="submit"
            class="btn-atc"
            :disabled="!selectedVariantAvailable || addingToCart"
            x-text="addingToCart ? 'ADDING...' : (selectedVariantAvailable ? '{{ section.settings.add_to_cart_text | default: 'ADD TO CARD' | upcase }}' : 'SOLD OUT')"
          >
            ADD TO CARD
          </button>
          {% if section.settings.show_dynamic_checkout %}
            {{ form | payment_button }}
          {% endif %}
        </div>

      {% endform %}

      {%- comment -%} Trust badges {%- endcomment -%}
      <div class="trust-badges">
        <div class="trust-badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12l5 5L20 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>FREE SHIPPING</span>
        </div>
        <div class="trust-badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>SECURE PAYMENT</span>
        </div>
        <div class="trust-badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>EASY RETURNS</span>
        </div>
      </div>

      {%- comment -%} Share {%- endcomment -%}
      {% if section.settings.show_share %}
        <div class="product-main__share">
          <span class="product-main__share-label">SHARE</span>
          <div class="share-links">
            <a
              href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={{ product.featured_image | img_url: '800x' }}&description={{ product.title | url_encode }}"
              target="_blank" rel="noopener"
              class="share-link"
              aria-label="Share on Pinterest"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.03-2.83.18-.78 1.22-5.17 1.22-5.17s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.58 2.26-.87 3.51-.25 1.05.52 1.9 1.54 1.9 1.85 0 3.09-2.38 3.09-5.2 0-2.14-1.44-3.74-4.03-3.74-2.94 0-4.76 2.2-4.76 4.65 0 .84.24 1.44.62 1.9.17.2.19.28.13.51-.04.17-.14.57-.18.73-.06.23-.24.31-.43.23-1.2-.49-1.76-1.81-1.76-3.3 0-2.44 2.06-5.37 6.16-5.37 3.31 0 5.49 2.4 5.49 4.98 0 3.41-1.89 5.96-4.66 5.96-.93 0-1.81-.5-2.11-1.07l-.58 2.2c-.21.8-.77 1.8-1.15 2.41.87.27 1.79.42 2.75.42 5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
              </svg>
            </a>
          </div>
        </div>
      {% endif %}

      {%- comment -%} Accordions {%- endcomment -%}
      <div class="product-main__accordions">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <div class="accordion" x-data="{ open: {{ block.settings.open_by_default | json }} }" {{ block.shopify_attributes }}>
              <button
                class="accordion__trigger"
                @click="open = !open"
                :aria-expanded="open"
                aria-controls="accordion-{{ block.id }}"
              >
                <span class="accordion__title">{{ block.settings.heading | upcase }}</span>
                <svg
                  class="accordion__icon"
                  :class="{ 'is-open': open }"
                  width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
                >
                  <path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div
                class="accordion__body"
                id="accordion-{{ block.id }}"
                x-show="open"
                x-transition:enter="accordion-enter"
                x-transition:enter-start="accordion-enter-start"
                x-transition:enter-end="accordion-enter-end"
                x-transition:leave="accordion-leave"
                x-transition:leave-start="accordion-leave-start"
                x-transition:leave-end="accordion-leave-end"
              >
                <div class="accordion__content">
                  {{ block.settings.content }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<style>
  .product-main {
    padding: 48px 0 96px;
  }

  .product-main__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--container-px);
    display: grid;
    grid-template-columns: 60fr 40fr;
    gap: 64px;
    align-items: start;
  }

  /* ========== Gallery ========== */
  .product-main__gallery {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    position: sticky;
    top: 96px;
  }

  .gallery-thumbs {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .gallery-thumbs__item {
    width: 80px;
    height: 80px;
    overflow: hidden;
    background: #F5F0E8;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.2s ease;
  }

  .gallery-thumbs__item.is-active {
    border-color: #2D4A6A;
  }

  .gallery-thumbs__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-main {
    position: relative;
    aspect-ratio: 4 / 5;
    background-color: #F5F0E8;
    overflow: hidden;
  }

  .gallery-main__slide {
    position: absolute;
    inset: 0;
  }

  .gallery-main__slide:first-child {
    position: relative;
  }

  .gallery-main__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-main__placeholder {
    width: 100%;
    height: 100%;
    color: #ccc;
  }

  .gallery-main__dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: none;
    gap: 6px;
    z-index: 1;
  }

  .gallery-dot {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.5);
    transition: all 0.2s ease;
  }

  .gallery-dot.is-active {
    background-color: #ffffff;
    transform: scale(1.4);
  }

  /* Gallery transitions */
  .gallery-enter { transition: opacity 0.3s ease; }
  .gallery-enter-start { opacity: 0; }
  .gallery-enter-end { opacity: 1; }

  /* ========== Product Info ========== */
  .product-main__vendor {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: #888;
    margin: 0 0 12px;
  }

  .product-main__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 300;
    color: #1A1A1A;
    margin: 0 0 20px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .product-main__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 20px;
  }

  .product-main__price--regular,
  .product-main__price--sale {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #1A1A1A;
    letter-spacing: 0.02em;
  }

  .product-main__price--compare {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
  }

  .product-main__badge {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    background-color: #2D4A6A;
    color: #F5F0E8;
  }

  .product-main__description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #555;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid #E8E8E4;
  }

  /* Options */
  .product-main__option {
    margin-bottom: 24px;
  }

  .product-main__option-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .product-main__option-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #888;
  }

  .product-main__option-value {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: #1A1A1A;
    text-transform: uppercase;
  }

  /* Color swatches */
  .color-swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .color-swatch {
    cursor: pointer;
  }

  .color-swatch__circle {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid transparent;
    outline: 1px solid rgba(0,0,0,0.12);
    outline-offset: 2px;
    transition: outline-color 0.2s ease;
  }

  .color-swatch.is-active .color-swatch__circle,
  .color-swatch:hover .color-swatch__circle {
    outline-color: #2D4A6A;
  }

  /* Variant options */
  .variant-options {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .variant-option {
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    letter-spacing: 0.1em;
    padding: 10px 16px;
    border: 1px solid #E8E8E4;
    color: #1A1A1A;
    transition: all 0.2s ease;
  }

  .variant-option.is-active,
  .variant-option:hover {
    border-color: #2D4A6A;
    background-color: #2D4A6A;
    color: #F5F0E8;
  }

  /* Quantity */
  .product-main__quantity {
    margin-bottom: 24px;
  }

  .quantity-selector {
    display: inline-flex;
    align-items: center;
    border: 1px solid #E8E8E4;
    margin-top: 12px;
  }

  .quantity-selector__btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: #1A1A1A;
    transition: background-color 0.2s ease;
  }

  .quantity-selector__btn:hover:not(:disabled) {
    background-color: #F5F0E8;
  }

  .quantity-selector__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .quantity-selector__input {
    width: 48px;
    height: 44px;
    text-align: center;
    border: none;
    border-left: 1px solid #E8E8E4;
    border-right: 1px solid #E8E8E4;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #1A1A1A;
    outline: none;
    -moz-appearance: textfield;
  }

  .quantity-selector__input::-webkit-outer-spin-button,
  .quantity-selector__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* CTA */
  .product-main__cta-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .btn-atc {
    width: 100%;
    padding: 18px;
    background-color: #2D4A6A;
    color: #F5F0E8;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .btn-atc:hover:not(:disabled) {
    background-color: #1E3A5F;
  }

  .btn-atc:disabled {
    background-color: #E8E8E4;
    color: #999;
    cursor: not-allowed;
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    gap: 0;
    border: 1px solid #E8E8E4;
    margin-bottom: 24px;
  }

  .trust-badge {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 8px;
    text-align: center;
    border-right: 1px solid #E8E8E4;
    color: #2D4A6A;
  }

  .trust-badge:last-child {
    border-right: none;
  }

  .trust-badge span {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #555;
  }

  /* Share */
  .product-main__share {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .product-main__share-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: #888;
  }

  .share-links {
    display: flex;
    gap: 10px;
  }

  .share-link {
    color: #555;
    transition: color 0.2s ease;
  }

  .share-link:hover {
    color: #2D4A6A;
  }

  /* Accordions */
  .product-main__accordions {
    border-top: 1px solid #E8E8E4;
  }

  .accordion {
    border-bottom: 1px solid #E8E8E4;
  }

  .accordion__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 18px 0;
    cursor: pointer;
    text-align: left;
  }

  .accordion__title {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: #1A1A1A;
  }

  .accordion__icon {
    flex-shrink: 0;
    color: #888;
    transition: transform 0.25s ease;
  }

  .accordion__icon.is-open {
    transform: rotate(180deg);
  }

  .accordion__content {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.75;
    color: #555;
    padding-bottom: 18px;
  }

  /* Accordion transitions */
  .accordion-enter { transition: opacity 0.25s ease, transform 0.25s ease; }
  .accordion-enter-start { opacity: 0; transform: translateY(-8px); }
  .accordion-enter-end { opacity: 1; transform: translateY(0); }
  .accordion-leave { transition: opacity 0.2s ease; }
  .accordion-leave-start { opacity: 1; }
  .accordion-leave-end { opacity: 0; }

  /* visually-hidden utility */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ========== Responsive ========== */
  @media (max-width: 1024px) {
    .product-main__inner {
      padding: 0 24px;
      gap: 48px;
      grid-template-columns: 55fr 45fr;
    }
    .product-main__gallery {
      grid-template-columns: 64px 1fr;
      top: 80px;
    }
    .gallery-thumbs__item {
      width: 64px;
      height: 64px;
    }
  }

  @media (max-width: 768px) {
    .product-main__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .product-main__gallery {
      grid-template-columns: 1fr;
      position: relative;
      top: 0;
    }
    .gallery-thumbs {
      flex-direction: row;
      overflow-x: auto;
      order: 2;
    }
    .gallery-thumbs__item {
      flex-shrink: 0;
    }
    .gallery-main {
      order: 1;
      aspect-ratio: 1 / 1;
    }
    .gallery-main__dots {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .product-main__inner {
      padding: 0 16px;
    }
    .trust-badge span {
      font-size: 8px;
    }
  }
</style>

<script>
  function productMain() {
    const productData = {{ product | json }};
    return {
      activeImage: 0,
      quantity: 1,
      selectedVariantId: {{ product.selected_or_first_available_variant.id }},
      selectedVariantAvailable: {{ product.selected_or_first_available_variant.available | json }},
      selectedColor: '{{ product.selected_or_first_available_variant.option1 }}',
      selectedOptions: [
        '{{ product.selected_or_first_available_variant.option1 }}',
        '{{ product.selected_or_first_available_variant.option2 }}',
        '{{ product.selected_or_first_available_variant.option3 }}'
      ],
      addingToCart: false,
      updateColor(value) {
        this.selectedColor = value;
        this.selectedOptions[0] = value;
        this.findVariant();
      },
      updateOption(index, value) {
        this.selectedOptions[index] = value;
        this.findVariant();
      },
      findVariant() {
        const match = productData.variants.find(v => {
          return (
            (v.option1 === this.selectedOptions[0] || !v.option1) &&
            (v.option2 === this.selectedOptions[1] || !v.option2) &&
            (v.option3 === this.selectedOptions[2] || !v.option3)
          );
        });
        if (match) {
          this.selectedVariantId = match.id;
          this.selectedVariantAvailable = match.available;
          document.querySelector('#price-{{ section.id }}').innerHTML =
            match.compare_at_price > match.price
              ? `<span class="product-main__price--sale">${this.formatMoney(match.price)}</span><span class="product-main__price--compare">${this.formatMoney(match.compare_at_price)}</span>`
              : `<span class="product-main__price--regular">${this.formatMoney(match.price)}</span>`;
        }
      },
      formatMoney(cents) {
        return new Intl.NumberFormat('{{ request.locale.iso_code }}', {
          style: 'currency',
          currency: '{{ cart.currency.iso_code }}'
        }).format(cents / 100);
      }
    }
  }
</script>

