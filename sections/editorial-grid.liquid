<section class="editorial-grid" data-section-id="{{ section.id }}">
  <div class="editorial-grid__inner container">

    <div class="editorial-grid__header">
      <p class="editorial-grid__label text-body-primary">{{ section.settings.label | default: 'EDITORIAL' | upcase }}</p>
      <h2 class="editorial-grid__heading text-heading-primary">
        {{ section.settings.heading | default: 'Moments where mats become part of the interior' }}
      </h2>
    </div>

    {%- comment -%} 4-column equal width editorial image grid (block-based) {%- endcomment -%}
    <div class="editorial-grid__layout" data-reveal-group>
      {% for block in section.blocks %}
        <div class="editorial-grid__cell">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
              sizes="(max-width: 768px) 100vw, 25vw"
              alt="{{ block.settings.image_alt | default: 'Editorial image' }}"
              loading="lazy"
              class="editorial-grid__img"
              width="auto"
              height="auto"
            >
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-grid__placeholder' }}
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .editorial-grid {
    padding: var(--section-py) 0;
    background-color: var(--color-white);
  }

  .editorial-grid__inner {
    
  }

  /* Header */
  .editorial-grid__header {
    margin-bottom: var(--gap-lg);
  }

  .editorial-grid__label {
    color: var(--color-near-black);
  }

  .editorial-grid__heading {
    color: var(--color-black);
    max-width: 560px;
  }

  /* Grid layout */
  .editorial-grid__layout {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: var(--gap-sm);
    align-items: start;
  }

  /* Cells */
  .editorial-grid__cell {
    overflow: hidden;
    background-color: #E8E8E4;
    position: relative;
    aspect-ratio: 4 / 5;
  }

  .editorial-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .editorial-grid__cell:hover .editorial-grid__img {
    transform: scale(1.04);
  }

  .editorial-grid__placeholder {
    width: 100%;
    height: 100%;
    color: #ccc;
    display: block;
  }

  @media (max-width: 1024px) {
    .editorial-grid__layout {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 768px) {
    .editorial-grid__layout {
      grid-template-columns: 1fr 1fr;
      gap: 5px;
    }
  }
</style>

{% schema %}
{
  "name": "Editorial Grid",
  "tag": "section",
  "class": "editorial-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "EDITORIAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Moments where mats become part of the interior"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Grid",
      "settings": {
        "label": "EDITORIAL",
        "heading": "Moments where mats become part of the interior"
      },
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
