<section class="editorial-grid" data-section-id="{{ section.id }}">
  <div class="editorial-grid__inner">

    <header class="editorial-grid__header">
      <p class="editorial-grid__label">{{ section.settings.label | default: 'EDITORIAL' | upcase }}</p>
      <h2 class="editorial-grid__heading">
        {{ section.settings.heading | default: 'Moments where mats become part of the interior' }}
      </h2>
    </header>

    {%- comment -%} 2+2 asymmetric editorial image grid {%- endcomment -%}
    <div class="editorial-grid__layout">

      {%- comment -%} Left column: 2 stacked images (smaller) {%- endcomment -%}
      <div class="editorial-grid__col editorial-grid__col--stack">
        <div class="editorial-grid__cell editorial-grid__cell--sm">
          {% if section.settings.image_1 != blank %}
            <img
              src="{{ section.settings.image_1 | img_url: '800x' }}"
              srcset="{{ section.settings.image_1 | img_url: '400x' }} 400w, {{ section.settings.image_1 | img_url: '800x' }} 800w"
              sizes="(max-width: 768px) 100vw, 33vw"
              alt="{{ section.settings.image_1_alt | default: 'Editorial image 1' }}"
              loading="lazy"
              class="editorial-grid__img"
            >
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-grid__placeholder' }}
          {% endif %}
        </div>
        <div class="editorial-grid__cell editorial-grid__cell--sm">
          {% if section.settings.image_2 != blank %}
            <img
              src="{{ section.settings.image_2 | img_url: '800x' }}"
              srcset="{{ section.settings.image_2 | img_url: '400x' }} 400w, {{ section.settings.image_2 | img_url: '800x' }} 800w"
              sizes="(max-width: 768px) 100vw, 33vw"
              alt="{{ section.settings.image_2_alt | default: 'Editorial image 2' }}"
              loading="lazy"
              class="editorial-grid__img"
            >
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'editorial-grid__placeholder' }}
          {% endif %}
        </div>
      </div>

      {%- comment -%} Center/right: large image {%- endcomment -%}
      <div class="editorial-grid__col editorial-grid__col--large">
        <div class="editorial-grid__cell editorial-grid__cell--lg">
          {% if section.settings.image_3 != blank %}
            <img
              src="{{ section.settings.image_3 | img_url: '1200x' }}"
              srcset="{{ section.settings.image_3 | img_url: '600x' }} 600w, {{ section.settings.image_3 | img_url: '1200x' }} 1200w"
              sizes="(max-width: 768px) 100vw, 40vw"
              alt="{{ section.settings.image_3_alt | default: 'Editorial image 3' }}"
              loading="lazy"
              class="editorial-grid__img"
            >
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'editorial-grid__placeholder' }}
          {% endif %}
        </div>
      </div>

      {%- comment -%} Far right: tall image {%- endcomment -%}
      <div class="editorial-grid__col editorial-grid__col--tall">
        <div class="editorial-grid__cell editorial-grid__cell--tall">
          {% if section.settings.image_4 != blank %}
            <img
              src="{{ section.settings.image_4 | img_url: '800x' }}"
              srcset="{{ section.settings.image_4 | img_url: '400x' }} 400w, {{ section.settings.image_4 | img_url: '800x' }} 800w"
              sizes="(max-width: 768px) 100vw, 25vw"
              alt="{{ section.settings.image_4_alt | default: 'Editorial image 4' }}"
              loading="lazy"
              class="editorial-grid__img"
            >
          {% else %}
            {{ 'product-2' | placeholder_svg_tag: 'editorial-grid__placeholder' }}
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .editorial-grid {
    padding: 96px 0;
    background-color: #F5F0E8;
  }

  .editorial-grid__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Header */
  .editorial-grid__header {
    margin-bottom: 56px;
  }

  .editorial-grid__label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #2D4A6A;
    margin: 0 0 16px;
  }

  .editorial-grid__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 300;
    color: #1A1A1A;
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 560px;
  }

  /* Grid layout */
  .editorial-grid__layout {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    gap: 16px;
    align-items: start;
  }

  /* Columns */
  .editorial-grid__col--stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Cells */
  .editorial-grid__cell {
    overflow: hidden;
    background-color: #E8E8E4;
    position: relative;
  }

  .editorial-grid__cell--sm {
    aspect-ratio: 4 / 5;
  }

  .editorial-grid__cell--lg {
    aspect-ratio: 4 / 5;
  }

  .editorial-grid__cell--tall {
    aspect-ratio: 2 / 3;
  }

  .editorial-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .editorial-grid__cell:hover .editorial-grid__img {
    transform: scale(1.04);
  }

  .editorial-grid__placeholder {
    width: 100%;
    height: 100%;
    color: #ccc;
    display: block;
  }

  @media (max-width: 1024px) {
    .editorial-grid {
      padding: 72px 0;
    }
    .editorial-grid__inner {
      padding: 0 24px;
    }
    .editorial-grid__layout {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .editorial-grid__col--tall {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .editorial-grid__layout {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .editorial-grid__col--stack {
      flex-direction: row;
    }
    .editorial-grid__col--stack .editorial-grid__cell {
      flex: 1;
    }
    .editorial-grid__inner {
      padding: 0 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Editorial Grid",
  "tag": "section",
  "class": "editorial-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "EDITORIAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Moments where mats become part of the interior"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (top-left)"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (bottom-left)"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image 2 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3 (large center)"
    },
    {
      "type": "text",
      "id": "image_3_alt",
      "label": "Image 3 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4 (right tall)"
    },
    {
      "type": "text",
      "id": "image_4_alt",
      "label": "Image 4 alt text"
    }
  ],
  "presets": [
    {
      "name": "Editorial Grid",
      "settings": {
        "label": "EDITORIAL",
        "heading": "Moments where mats become part of the interior"
      }
    }
  ]
}
{% endschema %}
