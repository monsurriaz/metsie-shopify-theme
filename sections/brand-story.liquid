
<div class="brand-story{% if section.settings.section_style == 'equal_width' %} equal-width mobile-fluid{% endif %}" data-section-id="{{ section.id }}">
  <div class="container">

    <div class="brand-story__inner">
      {%- comment -%} Image column — LEFT {%- endcomment -%}
      <div class="brand-story__image-col">
        {% if section.settings.image != blank %}
          <div class="brand-story__image-container aspect-portrait">
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="{{ section.settings.image_alt | default: 'Metsie design studio' }}"
              width="800"
              height="960"
              loading="lazy"
              class="brand-story__image media-fit"
            >
          </div>
        {% else %}
          <div class="brand-story__image-placeholder aspect-portrait">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'brand-story__placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      {%- comment -%} Text column — RIGHT (block-based) {%- endcomment -%}
      <div class="brand-story__text-col">
        <div class="brand-story__text-wrapper" data-reveal-group>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'label' %}
                <p class="brand-story__label text-body-primary">{{ block.settings.text }}</p>
  
              {% when 'text' %}
                <h2 class="brand-story__body text-heading-primary">{{ block.settings.body_text }}</h2>
  
              {% when 'button' %}
                <a
                  href="{{ block.settings.link }}"
                  class="brand-story__cta{% if section.settings.section_style == 'equal_width' %} btn btn--white-outline btn--lg{% endif %}"
                >
                  {{ block.settings.text }}
                </a>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% style %}
  .brand-story {
    overflow: hidden;
  }
  .brand-story__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }
  /* Image — always left */
  .brand-story__image-col {
    order: 1;
  }
  .brand-story__text-col {
    order: 2;
  }
  .brand-story__image-container,
  .brand-story__image-placeholder {
    position: relative;
    overflow: hidden;
    background-color: var(--color-light-gray);
  }
  .brand-story__image {
    transition: transform 0.6s ease;
  }
  .brand-story__image-container:hover .brand-story__image {
    transform: scale(1.03);
  }
  .brand-story__placeholder-svg {
    width: 100%;
    height: 100%;
    color: #ccc;
  }

  {% if section.settings.section_style == 'equal_width' %}
    .brand-story.equal-width {
      background-color: var(--color-white);
    }
    .brand-story.equal-width .brand-story__text-col {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      color: var(--color-white);
      background-color: var(--color-deep-navy);
      padding: 80px var(--container-px);
    }
    .brand-story.equal-width .brand-story__text-wrapper {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }
    .brand-story.equal-width .brand-story__label {
      color: #ffffff;
    }
    .brand-story.equal-width .brand-story__body {
      color: #ffffff;
      margin-bottom: var(--gap-lg);
    }
  {% else %}
    .brand-story {
      padding: var(--section-padding-sm) 0;
      background-color: #F5F0E8;
    }
    .brand-story__inner {
      gap: 80px;
    }
    .brand-story__label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #2D4A6A;
      margin: 0 0 32px;
    }
    .brand-story__body {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(24px, 2.5vw, 36px);
      font-weight: 300;
      line-height: 1.3;
      letter-spacing: -0.01em;
      color: #1A1A1A;
      margin-bottom: 48px;
    }

    /* Pill-shaped outline button */
    .brand-story__cta {
      display: inline-block;
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-decoration: none;
      color: #1A1A1A;
      border: 1px solid #1A1A1A;
      border-radius: 100px;
      padding: 14px 32px;
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    .brand-story__cta:hover {
      background-color: #1A1A1A;
      color: #F5F0E8;
    }
  {% endif %}

  @media (max-width: 1024px) {
    .brand-story {
      padding: 72px 0;
    }
    .brand-story__inner {
      gap: 48px;
    }
    .brand-story__label {
      color: #2D4A6A;
      margin: 0 0 32px;
    }
  }

  @media (max-width: 768px) {
    .brand-story.equal-width {
      padding-block: 0;
    }
    .brand-story__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .brand-story.equal-width .container {
      padding-inline: 0;
    }
    .brand-story.equal-width .brand-story__inner {
      gap: 0px;
    }

    .brand-story__image-col {
      order: 1;
    }

    .brand-story__text-col {
      order: 2;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "brand-story-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (left column)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "select",
      "id": "section_style",
      "label": "Section Style",
      "options": [
        {
          "value": "equal_width",
          "label": "Equal Width"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ],
      "default": "equal_width"
    }
  ],
  "blocks": [
    {
      "type": "label",
      "name": "Label",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Label text",
          "default": "METSIE DESIGN STUDIOS"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "textarea",
          "id": "body_text",
          "label": "Body text (plain — used only when rich text above is empty)",
          "default": "Metsie reimagines the mat as part of the room — a quiet foundation for movement, rest, and everyday rituals"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Button text",
          "default": "Our philosophy"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Story",
      "blocks": [
        {
          "type": "label",
          "settings": {
            "text": "METSIE DESIGN STUDIOS"
          }
        },
        {
          "type": "text",
          "settings": {
            "body_text": "Metsie reimagines the mat as part of the room — a quiet foundation for movement, rest, and everyday rituals"
          }
        },
        {
          "type": "button",
          "settings": {
            "text": "Our philosophy",
            "link": "/pages/about"
          }
        }
      ]
    }
  ]
}
{% endschema %}
