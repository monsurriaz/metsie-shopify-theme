<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {%- if shop.password_message != blank -%}
      {{ shop.password_message | escape }} &mdash; {{ shop.name }}
    {%- else -%}
      {{ 'general.password_page.title' | t }} &mdash; {{ shop.name }}
    {%- endif -%}
  </title>

  <meta name="robots" content="noindex, nofollow">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
  {%- endif -%}

  {%- if settings.use_google_fonts -%}
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    >
  {%- endif -%}

  <style>
    :root {
      --color-deep-navy: {{ settings.color_deep_navy }};
      --color-navy-mid: {{ settings.color_navy_mid }};
      --color-cream: {{ settings.color_cream }};
      --color-espresso: {{ settings.color_espresso }};
      --color-light-gray: {{ settings.color_light_gray }};
      --color-white: {{ settings.color_white }};
      --color-near-black: {{ settings.color_near_black }};
      --color-error: {{ settings.color_error }};
      --font-heading: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--color-deep-navy);
      color: var(--color-white);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 2rem;
    }

    .password-main-content:empty {
      display: none;
    }

    .password-page {
      width: 100%;
      max-width: 480px;
      text-align: center;
    }

    .password-page__logo {
      display: block;
      margin: 0 auto 3rem;
      max-width: 160px;
    }

    .password-page__logo-text {
      font-family: var(--font-heading);
      font-size: 2.5rem;
      font-weight: 400;
      letter-spacing: 0.2em;
      color: var(--color-white);
      text-transform: uppercase;
      text-decoration: none;
    }

    .password-page__heading {
      font-family: var(--font-heading);
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      font-weight: 300;
      letter-spacing: 0.05em;
      margin-bottom: 1.25rem;
      color: var(--color-white);
    }

    .password-page__message {
      font-size: 0.875rem;
      font-weight: 300;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.75);
      margin-bottom: 2.5rem;
      letter-spacing: 0.03em;
    }

    .password-page__form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .password-page__input-group {
      display: flex;
      gap: 0;
      border: 1px solid rgba(255, 255, 255, 0.3);
      transition: border-color 0.2s ease;
    }

    .password-page__input-group:focus-within {
      border-color: rgba(255, 255, 255, 0.8);
    }

    .password-page__input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--color-white);
      font-family: var(--font-body);
      font-size: 0.875rem;
      letter-spacing: 0.05em;
      padding: 0.875rem 1rem;
    }

    .password-page__input::placeholder {
      color: rgba(255, 255, 255, 0.45);
    }

    .password-page__submit {
      background: var(--color-white);
      color: var(--color-deep-navy);
      border: none;
      padding: 0.875rem 1.5rem;
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
      white-space: nowrap;
    }

    .password-page__submit:hover {
      background: var(--color-cream, #F5F0E8);
    }

    .password-page__errors {
      background: rgba(192, 57, 43, 0.15);
      border: 1px solid rgba(192, 57, 43, 0.4);
      padding: 0.75rem 1rem;
      font-size: 0.8125rem;
      color: #ff8c82;
      letter-spacing: 0.03em;
      text-align: left;
    }

    .password-page__errors ul {
      list-style: none;
      padding: 0;
    }

    .password-page__newsletter {
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 2.5rem;
    }

    .password-page__newsletter-heading {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }

    .password-page__newsletter-text {
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.65);
      margin-bottom: 1.25rem;
      letter-spacing: 0.03em;
    }

    .password-page__footer {
      position: fixed;
      bottom: 1.5rem;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.35);
      letter-spacing: 0.08em;
    }

    .password-page__footer a {
      color: inherit;
      text-decoration: none;
    }

    .password-page__footer a:hover {
      color: rgba(255, 255, 255, 0.65);
    }

    @media (prefers-reduced-motion: no-preference) {
      .password-page {
        animation: fadeUp 0.6s ease both;
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
    }
  </style>

  {{ content_for_header }}
</head>

<body>

  <main
    id="MainContent"
    class="content-for-layout password-main-content"
    role="main"
  >
    {{ content_for_layout }}
  </main>

  <div class="password-page" role="main">

    {%- comment -%} Logo {%- endcomment -%}
    <div class="password-page__brand">
      {%- if settings.logo_dark != blank -%}
        <img
          src="{{ settings.logo_dark | image_url: width: 240 }}"
          alt="{{ shop.name }}"
          class="password-page__logo"
          width="{{ settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        <span class="password-page__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    {%- comment -%} Heading & Message {%- endcomment -%}
    <h1 class="password-page__heading">
      {{ 'general.password_page.opening_soon' | t | default: '[OPENING SOON]' }}
    </h1>

    {%- if shop.password_message != blank -%}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {%- else -%}
      <p class="password-page__message">
        {{ 'general.password_page.message' | t | default: '[SOMETHING QUIET & CONSIDERED IS BEING PREPARED. ENTER PASSWORD TO PREVIEW.]' }}
      </p>
    {%- endif -%}

    {%- comment -%} Password Form {%- endcomment -%}
    {% form 'storefront_password', class: 'password-page__form' %}
      {%- if form.errors -%}
        <div class="password-page__errors" role="alert">
          <ul>
            {%- for error in form.errors -%}
              <li>{{ error | capitalize }}: {{ form.errors.messages[error] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="password-page__input-group">
        <input
          type="password"
          id="Password"
          name="password"
          class="password-page__input"
          placeholder="{{ 'general.password_page.password_placeholder' | t | default: '[ENTER PASSWORD]' }}"
          autocomplete="current-password"
          required
        >
        <button type="submit" class="password-page__submit">
          {{ 'general.password_page.submit' | t | default: '[ENTER]' }}
        </button>
      </div>
    {% endform %}

    {%- comment -%} Newsletter signup on password page {%- endcomment -%}
    {%- if settings.footer_show_newsletter -%}
      <div class="password-page__newsletter">
        <h2 class="password-page__newsletter-heading">
          {{ 'general.password_page.notify_heading' | t | default: '[BE FIRST TO KNOW]' }}
        </h2>
        <p class="password-page__newsletter-text">
          {{ 'general.password_page.notify_text' | t | default: '[LEAVE YOUR EMAIL AND WE WILL NOTIFY YOU WHEN WE LAUNCH.]' }}
        </p>

        {% form 'customer', class: 'password-page__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,password-page">
          <div class="password-page__input-group">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail"
              class="password-page__input"
              placeholder="{{ settings.footer_newsletter_placeholder | default: '[YOUR EMAIL ADDRESS]' }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="password-page__submit">
              {{ 'general.password_page.notify_submit' | t | default: '[NOTIFY ME]' }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="password-page__message" role="status">
              {{ 'general.password_page.notify_success' | t | default: '[THANK YOU. WE WILL BE IN TOUCH.]' }}
            </p>
          {%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}
  </div>

  <footer class="password-page__footer">
    <p>
      {{ 'general.password_page.powered_by' | t | default: '' }}
      <a href="{{ shop.url }}">{{ shop.name }}</a>
    </p>
  </footer>

  <script>document.documentElement.classList.remove('no-js');</script>
</body>
</html>
