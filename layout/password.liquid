<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {%- if shop.password_message != blank -%}
      {{ shop.password_message | escape }} &mdash; {{ shop.name }}
    {%- else -%}
      {{ 'general.password_page.title' | t }} &mdash; {{ shop.name }}
    {%- endif -%}
  </title>

  <meta name="robots" content="noindex, nofollow">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
  {%- endif -%}

  {%- if settings.use_google_fonts -%}
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    >
    <style>
      @font-face {
        font-family: "Zapf_Humanist";
        src: url('https://cdn.shopify.com/s/files/1/1040/0776/2261/files/Zapf_Humanist_601_Regular.woff2?v=1783023888') format('woff2');
        font-weight: 400;
        font-style: normal;
      }
    </style>
  {%- endif -%}

  <style>
    :root {
      --color-deep-navy: {{ settings.color_deep_navy }};
      --color-navy-mid: {{ settings.color_navy_mid }};
      --color-cream: {{ settings.color_cream }};
      --color-espresso: {{ settings.color_espresso }};
      --color-light-gray: {{ settings.color_light_gray }};
      --color-white: {{ settings.color_white }};
      --color-near-black: {{ settings.color_near_black }};
      --color-error: {{ settings.color_error }};

      {%- if settings.use_google_fonts -%}
        --font-heading:       'Zapf_Humanist', Georgia, 'Times New Roman', serif;
        --font-body:          'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      {%- else -%}
        --font-heading:       {{ settings.font_heading }};
        --font-body:          {{ settings.font_body }};
      {%- endif -%}

      --password-surface: rgba(255, 255, 255, 0.04);
      --password-border: rgba(255, 255, 255, 0.22);
      --password-border-strong: rgba(255, 255, 255, 0.7);
      --password-text-muted: rgba(255, 255, 255, 0.68);
      --password-placeholder: rgba(255, 255, 255, 0.45);
      --password-footer-text: rgba(255, 255, 255, 0.38);
      --password-error-surface: rgba(192, 57, 43, 0.15);
      --password-error-border: rgba(192, 57, 43, 0.4);
      --password-error-text: #ff8c82;
      --password-content-width: 560px;
      --password-space-xs: 0.5rem;
      --password-space-sm: 1rem;
      --password-space-md: 1.5rem;
      --password-space-lg: 2.5rem;
      --password-space-xl: 4rem;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--color-deep-navy);
      color: var(--color-white);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: var(--password-space-lg);
    }

    .password-main-content,
    .section-password {
      width: 100%;
    }

    .password-page {
      width: 100%;
      max-width: var(--password-content-width);
      margin: 0 auto;
      text-align: center;
    }

    .password-page__logo {
      display: block;
      margin: 0 auto;
      max-width: 160px;
    }

    .password-page__logo-text {
      font-family: var(--font-heading);
      font-size: 2.5rem;
      font-weight: 400;
      letter-spacing: 0.2em;
      color: var(--color-white);
      text-transform: uppercase;
      text-decoration: none;
    }

    .password-page__content {
      margin-top: var(--password-space-xl);
      padding: var(--password-space-lg);
      /* background: var(--password-surface); */
      /* border: 1px solid var(--password-border); */
    }

    .password-page__heading {
      font-family: var(--font-heading);
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      font-weight: 300;
      letter-spacing: 0.05em;
      line-height: 1.2;
      margin-bottom: var(--password-space-sm);
      color: var(--color-white);
    }

    .password-page__message {
      font-size: 0.875rem;
      font-weight: 300;
      line-height: 1.7;
      color: var(--password-text-muted);
      max-width: 420px;
      margin: 0 auto var(--password-space-lg);
      letter-spacing: 0.03em;
    }

    .password-page__message.mt-4 {
      margin-top: 16px;
    }

    .password-page__form {
      display: flex;
      flex-direction: column;
      gap: var(--password-space-sm);
    }

    .password-page__input-group {
      display: flex;
      gap: 0;
      border: 1px solid var(--password-border);
      transition: border-color 0.2s ease;
    }

    .password-page__input-group:focus-within {
      border-color: var(--password-border-strong);
    }

    .password-page__input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--color-white);
      font-family: var(--font-body);
      font-size: 0.875rem;
      letter-spacing: 0.05em;
      min-width: 0;
      padding: var(--password-space-sm);
    }

    .password-page__input::placeholder {
      color: var(--password-placeholder);
    }

    .password-page__submit {
      background: var(--color-white);
      color: var(--color-deep-navy);
      border: none;
      padding: var(--password-space-sm) var(--password-space-md);
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
      white-space: nowrap;
    }

    .password-page__submit:hover {
      background: var(--color-cream);
    }

    .password-page__errors {
      background: var(--password-error-surface);
      border: 1px solid var(--password-error-border);
      padding: var(--password-space-sm);
      font-size: 0.8125rem;
      color: var(--password-error-text);
      letter-spacing: 0.03em;
      text-align: left;
    }

    .password-page__errors ul,
    .password-page__errors .errors ul {
      list-style: none;
      padding: 0;
    }

    .password-page__success {
      color: var(--color-white);
      font-size: 0.875rem;
      line-height: 1.7;
      letter-spacing: 0.03em;
    }

    .password-page__footer {
      position: fixed;
      bottom: var(--password-space-md);
      left: 0;
      right: 0;
      text-align: center;
      font-size: 0.75rem;
      color: var(--password-footer-text);
      letter-spacing: 0.08em;
    }

    .password-page__footer a {
      color: inherit;
      text-decoration: none;
    }

    .password-page__footer a:hover {
      color: var(--password-text-muted);
    }

    @media (max-width: 600px) {
      body {
        padding: var(--password-space-lg) var(--password-space-sm) var(--password-space-xl);
      }

      .password-page__content {
        margin-top: var(--password-space-lg);
        padding: var(--password-space-md) var(--password-space-sm);
      }

      .password-page__input-group {
        flex-direction: column;
      }

      .password-page__submit {
        width: 100%;
      }

      .password-page__footer {
        position: static;
        margin-top: var(--password-space-lg);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .password-page {
        animation: fadeUp 0.6s ease both;
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
    }
  </style>

  {{ content_for_header }}
</head>

<body>

  <main
    id="MainContent"
    class="content-for-layout password-main-content"
    role="main"
  >
    {{ content_for_layout }}
  </main>

  <script>document.documentElement.classList.remove('no-js');</script>
</body>
</html>
