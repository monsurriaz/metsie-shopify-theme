<!DOCTYPE html>
<html
  lang="{{ request.locale.iso_code }}"
  dir="{{ settings.text_direction | default: 'ltr' }}"
  class="no-js"
>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {%- comment -%} ============================================================
    ALPINE.JS — must be in <head> with defer so it initialises before theme.js
  ============================================================ {%- endcomment -%}
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

  {%- comment -%} Hide body until JS has run — prevents FOUC {%- endcomment -%}
  <style>body{opacity:0}[x-cloak]{display:none!important}</style>

  {%- comment -%} ============================================================
    SEO — title, description, canonical, robots, OG, Twitter, JSON-LD, hreflang
  ============================================================ {%- endcomment -%}
  {%- render 'meta-tags' -%}

  {%- comment -%} ============================================================
    PAGINATION SEO — rel="prev"
    rel="next" is handled within paginate blocks in section templates.
  ============================================================ {%- endcomment -%}
  {%- if current_page > 1 -%}
    {%- assign prev_page_num = current_page | minus: 1 -%}
    <link rel="prev" href="{{ canonical_url }}{% if prev_page_num > 1 %}?page={{ prev_page_num }}{% endif %}">
  {%- endif -%}

  {%- comment -%} ============================================================
    FAVICON
  ============================================================ {%- endcomment -%}
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  {%- endif -%}

  {%- comment -%} ============================================================
    GOOGLE FONTS
  ============================================================ {%- endcomment -%}
  {%- if settings.use_google_fonts -%}
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    >
  {%- endif -%}

  {%- comment -%} ============================================================
    CSS CUSTOM PROPERTIES (Design Tokens)
    Centralized in snippets/css-variables.liquid
  ============================================================ {%- endcomment -%}
  {%- render 'css-variables' -%}

  {%- comment -%} ============================================================
    THEME STYLESHEET
  ============================================================ {%- endcomment -%}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- comment -%} ============================================================
    CUSTOM CSS FROM THEME SETTINGS
  ============================================================ {%- endcomment -%}
  {%- if settings.custom_css != blank -%}
    <style>{{ settings.custom_css }}</style>
  {%- endif -%}

  {%- comment -%} ============================================================
    SHOPIFY REQUIRED
  ============================================================ {%- endcomment -%}
  {{ content_for_header }}

  {%- comment -%} ============================================================
    ANALYTICS — GTM / GA4
  ============================================================ {%- endcomment -%}
  {%- if settings.gtm_id != blank -%}
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','{{ settings.gtm_id }}');
    </script>
  {%- elsif settings.google_analytics_id != blank -%}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.google_analytics_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ settings.google_analytics_id }}', { 'anonymize_ip': true });
    </script>
  {%- endif -%}

  {%- comment -%} Custom head scripts from settings {%- endcomment -%}
  {%- if settings.custom_head_scripts != blank -%}
    {{ settings.custom_head_scripts }}
  {%- endif -%}
</head>

<body
  id="metsie-body"
  class="template-{{ template.name | handle }} {% if customer %}customer-logged-in{% endif %}"
  data-cart-type="{{ settings.cart_type }}"
>

  {%- comment -%} ============================================================
    GTM NOSCRIPT
  ============================================================ {%- endcomment -%}
  {%- if settings.gtm_id != blank -%}
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_id }}"
        height="0" width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
  {%- endif -%}

  {%- comment -%} Custom body scripts from settings {%- endcomment -%}
  {%- if settings.custom_body_scripts != blank -%}
    {{ settings.custom_body_scripts }}
  {%- endif -%}

  {%- comment -%} ============================================================
    SKIP TO CONTENT (ACCESSIBILITY)
  ============================================================ {%- endcomment -%}
  {%- if settings.enable_skip_link -%}
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>
  {%- endif -%}

  {%- comment -%} ============================================================
    GEO DETECTION STUB
    window.__GEO is populated by theme.js on DOMContentLoaded.
    Downstream sections/scripts can read window.__GEO.country, .currency, .language
  ============================================================ {%- endcomment -%}
  <script>
    window.__GEO = {
      country: null,
      currency: null,
      language: '{{ request.locale.iso_code }}',
      detected: false
    };
    window.__METSIE = {
      shopCurrency: {{ cart.currency.iso_code | json }},
      locale: {{ request.locale.iso_code | json }},
      cartItemCount: {{ cart.item_count | json }},
      moneyFormat: {{ shop.money_format | json }},
      routes: {
        root: '{{ routes.root_url }}',
        cart: '{{ routes.cart_url }}',
        cartAdd: '{{ routes.cart_add_url }}',
        cartChange: '{{ routes.cart_change_url }}',
        cartUpdate: '{{ routes.cart_update_url }}',
        search: '{{ routes.search_url }}'
      },
      settings: {
        enableGdprBanner: {{ settings.enable_gdpr_banner | json }},
        enableGeoRedirect: {{ settings.enable_geo_redirect | json }},
        cartType: {{ settings.cart_type | json }},
        lazyLoadImages: {{ settings.lazy_load_images | json }}
      }
    };
  </script>

  {%- comment -%} ============================================================
    HEADER GROUP (announcement bar + header + mobile menu)
  ============================================================ {%- endcomment -%}
  {% sections 'header-group' %}

  {%- comment -%} ============================================================
    MAIN CONTENT
  ============================================================ {%- endcomment -%}
  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- comment -%} ============================================================
    FOOTER GROUP
  ============================================================ {%- endcomment -%}
  {% sections 'footer-group' %}

  {%- comment -%} ============================================================
    CART DRAWER (if cart type = drawer)
  ============================================================ {%- endcomment -%}
  {%- if settings.cart_type == 'drawer' -%}
    {% section 'cart-drawer' %}
  {%- endif -%}

  {%- comment -%} ============================================================
    GDPR COOKIE BANNER
  ============================================================ {%- endcomment -%}
  {%- if settings.enable_gdpr_banner -%}
    {% render 'gdpr-cookie-banner' %}
  {%- endif -%}

  {%- comment -%} ============================================================
    CURRENCY / LANGUAGE SWITCHER MODAL
  ============================================================ {%- endcomment -%}
  {%- if settings.enable_currency_conversion or settings.enable_language_switcher -%}
    {% render 'localization-form' %}
  {%- endif -%}

  {%- comment -%} ============================================================
    SEARCH MODAL
  ============================================================ {%- endcomment -%}
  {%- if settings.show_search_icon -%}
    {% render 'search-modal' %}
  {%- endif -%}

  {%- comment -%} ============================================================
    THEME JS
  ============================================================ {%- endcomment -%}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'product-main.js' | asset_url }}" defer></script>

  {%- comment -%} Remove no-js class once JS is active {%- endcomment -%}
  <script>document.documentElement.classList.remove('no-js');</script>
</body>
</html>