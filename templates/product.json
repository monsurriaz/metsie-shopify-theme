{
  "sections": {
    "product-main": {
      "type": "product-main",
      "settings": {
        "show_vendor": true,
        "show_share": true,
        "show_sku": true,
        "gallery_layout": "thumbnails_left",
        "enable_zoom": true,
        "enable_video_looping": false,
        "show_quantity_selector": true,
        "show_dynamic_checkout": true,
        "show_size_guide": true,
        "size_guide_page": "pages/size-guide"
      },
      "blocks": {
        "accordion-features": {
          "type": "accordion",
          "settings": {
            "heading": "KEY FEATURES",
            "content": "<p>[LIST KEY PRODUCT FEATURES HERE — E.G. HAND-TUFTED, NON-SLIP BACKING, ECO-FRIENDLY MATERIALS]</p>",
            "open_by_default": true
          }
        },
        "accordion-materials": {
          "type": "accordion",
          "settings": {
            "heading": "MATERIALS",
            "content": "<p>[DESCRIBE MATERIALS USED — E.G. 100% WOOL PILE, COTTON BACKING, NATURAL DYES]</p>",
            "open_by_default": false
          }
        },
        "accordion-care": {
          "type": "accordion",
          "settings": {
            "heading": "CARE INSTRUCTIONS",
            "content": "<p>[PROVIDE CARE INSTRUCTIONS — E.G. SPOT CLEAN WITH DAMP CLOTH, PROFESSIONAL CLEANING RECOMMENDED]</p>",
            "open_by_default": false
          }
        },
        "accordion-returns": {
          "type": "accordion",
          "settings": {
            "heading": "RETURNS & EXCHANGES",
            "content": "<p>[DESCRIBE RETURN AND EXCHANGE POLICY — E.G. FREE RETURNS WITHIN 30 DAYS]</p>",
            "open_by_default": false
          }
        }
      },
      "blocks_order": [
        "accordion-features",
        "accordion-materials",
        "accordion-care",
        "accordion-returns"
      ]
    },
    "product-recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "YOU MAY ALSO LIKE",
        "products_to_show": 4,
        "intent": "related"
      }
    }
  },
  "order": [
    "product-main",
    "product-recommendations"
  ]
}
