  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Heading Font"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "info": "⚠ Only used when 'Load Google Fonts' is DISABLED above. Display font for headings and hero text. Default: Zapf Humanist",
        "default": "assistant_n6"
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Heading Size Scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "%"
      },
      {
        "type": "checkbox",
        "id": "font_heading_capitalize",
        "label": "Capitalize headings",
        "default": false
      },
      {
        "type": "header",
        "content": "Body Font"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "info": "⚠ Only used when 'Load Google Fonts' is DISABLED above. Used for navigation, labels, and body text. Default: SuisseIntl_Light",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "Body Size Scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "default": 100,
        "unit": "%"
      },
      {
        "type": "header",
        "content": "Font Loading Strategy"
      },
      {
        "type": "checkbox",
        "id": "use_google_fonts",
        "label": "Load Zapf Humanist & SuisseIntl Light from Shopify's content delivery network (CDN)",
        "info": "✓ ENABLED (recommended): Uses brand fonts (Zapf Humanist for headings, SuisseIntl Light for body). Ignores font picker settings below.\n✗ DISABLED: Uses fonts selected below via font picker. Useful for custom typography.",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "header",
        "content": "Page Layout"
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Page Max Width",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "default": 1440,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Section Vertical Spacing",
        "min": 24,
        "max": 96,
        "step": 8,
        "default": 64,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "spacing_grid_horizontal",
        "label": "Grid Horizontal Gutter",
        "min": 8,
        "max": 48,
        "step": 4,
        "default": 24,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "header",
        "content": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image",
        "info": "Recommended: SVG or PNG with transparent background. Max 400px wide."
      },
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logo (Light / Inverted)",
        "info": "Used on dark/navy backgrounds."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width",
        "min": 80,
        "max": 280,
        "step": 8,
        "default": 120,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Recommended: 32×32 or 64×64 px PNG or ICO file."
      },
      {
        "type": "header",
        "content": "Header Appearance"
      },
      {
        "type": "select",
        "id": "header_transparent_on",
        "label": "Show transparent header on",
        "info": "Transparent header works only when a section with `data-transparent-header-anchor` (hero banner by default) is present as the first section.",
        "options": [
          { "value": "disabled", "label": "Never (always filled)" },
          { "value": "index", "label": "Home page only" },
          { "value": "collection", "label": "Collection pages only" },
          { "value": "product", "label": "Product pages only" },
          { "value": "all", "label": "All pages with hero banner" }
        ],
        "default": "index"
      },
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Sticky header on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart_icon",
        "label": "Show cart icon in header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_search_icon",
        "label": "Show search icon in header",
        "default": true
      }
    ]
  },
  {
