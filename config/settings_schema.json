  {
    "name": "GEO & Internationalization",
    "settings": [
      {
        "type": "header",
        "content": "Currency"
      },
      {
        "type": "checkbox",
        "id": "enable_currency_conversion",
        "label": "Enable currency conversion",
        "info": "Automatically converts prices based on visitor location. Requires Shopify Markets or a currency app.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_currency_selector",
        "label": "Show currency selector in header",
        "default": true
      },
      {
        "type": "header",
        "content": "Language"
      },
      {
        "type": "checkbox",
        "id": "enable_language_switcher",
        "label": "Enable language switcher",
        "info": "Shows language toggle in header/footer. Requires Shopify Markets with multiple languages.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_language_selector",
        "label": "Show language selector in header",
        "default": true
      },
      {
        "type": "select",
        "id": "default_language",
        "label": "Default language",
        "options": [
          { "value": "en", "label": "English" },
          { "value": "de", "label": "Deutsch" },
          { "value": "fr", "label": "Français" }
        ],
        "default": "en"
      },
      {
        "type": "header",
        "content": "GEO Detection"
      },
      {
        "type": "checkbox",
        "id": "enable_geo_redirect",
        "label": "Enable GEO-based redirect suggestion",
        "info": "Detects visitor country and suggests the correct regional storefront. Uses ipapi.co.",
        "default": true
      },
      {
        "type": "header",
        "content": "GDPR / Cookie Consent"
      },
      {
        "type": "checkbox",
        "id": "enable_gdpr_banner",
        "label": "Show GDPR cookie consent banner",
        "info": "Required for EU visitors. Disabling this may violate GDPR regulations.",
        "default": true
      },
      {
        "type": "text",
        "id": "gdpr_banner_text",
        "label": "Cookie banner text",
        "default": "[WE USE COOKIES TO ENHANCE YOUR EXPERIENCE AND ANALYSE SITE TRAFFIC. BY CONTINUING, YOU AGREE TO OUR COOKIE POLICY.]"
      },
      {
        "type": "url",
        "id": "gdpr_policy_link",
        "label": "Cookie / Privacy Policy page URL"
      },
      {
        "type": "text",
        "id": "gdpr_accept_label",
        "label": "Accept button label",
        "default": "[ACCEPT ALL]"
      },
      {
        "type": "text",
        "id": "gdpr_decline_label",
        "label": "Decline / Manage button label",
        "default": "[MANAGE PREFERENCES]"
      },
      {
        "type": "color",
        "id": "gdpr_banner_bg",
        "label": "Cookie banner background",
        "default": "#2B1F18"
      },
      {
        "type": "color",
        "id": "gdpr_banner_text_color",
        "label": "Cookie banner text color",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Product Pages",
